test('live controls scope revocation cancels the cooperative handler before its side effect', async () => {
  const bus = new FoafBus(), apps = new AppTree({ bus });
  const root = apps.spawn({ appId: 'root', capabilities: ['control:invoke'] });
  const target = apps.spawn({ appId: 'target', parentId: root.id, capabilities: [] });
  const broker = new FoafControls({ apps, bus }); let release, effect = false, observed;
  broker.register({ instanceId: target.id, verbs: [{ name: 'write.test', inputSchema: {}, validate: () => true,
    invoke: async (_, { signal }) => { observed = signal; await new Promise(r => { release = r; }); signal.throwIfAborted(); effect = true; return {}; } }] });
  const scope = apps.setScope(root.id, 'controls', [{ target: target.id, verbs: ['write.test'] }]);
  const actor = broker.actor(root.id, scope, 'control:invoke', scope);
  const pending = broker.invoke(actor, { v: 1, id: 'revoke', target: target.id, verb: 'write.test', args: {} });
  await Promise.resolve(); await Promise.resolve();
  apps.setScope(root.id, 'controls', []);
  assert.equal(observed.aborted, true); release();
  assert.equal((await pending).error.code, 'revoked'); assert.equal(effect, false);
});
  } finally { apps.close(root.id);await Promise.all(workers.map(worker => worker.terminate())); }
});


test('nonresponsive worker is bounded, terminated on timeout, and replaced for the next call', async () => {
  const bus = new FoafBus(), apps = new AppTree({ bus });
  const root = apps.spawn({ appId: 'root', capabilities: ['shell'] });
  let created = 0, terminated = 0, posted = 0;
  const console = createControlConsole({ apps, bus, rootNode: root, engineURL: 'https://example.invalid/core.js', timeoutMs: 10,
    makeWorker: () => { created++; return { postMessage() { posted++; }, terminate() { terminated++; } }; } });
  const first = console.submit(`/msg ${console.target} compositor.status`);
  await Promise.resolve(); await Promise.resolve();
  const concurrent = await console.submit(`/msg ${console.target} compositor.status`);
  assert.equal(concurrent.result.error.code, 'busy');
  assert.equal((await first).result.error.code, 'cancelled'); assert.equal(terminated, 1); assert.equal(posted, 1);
  for (let n = 0; n < 3; n++) assert.equal((await console.submit(`/msg ${console.target} compositor.status`)).result.error.code, 'cancelled');
  assert.equal(created, 4); assert.equal(terminated, 4); assert.equal(posted, 4);
  apps.close(root.id);
});
