# edot ontology — generated by magpie/edot/tools/emit-ontology.mjs
# Entity types, serialization formats, and widget→type bindings.
# Commands declare edot:appliesTo at runtime via the command registry.

@prefix edot: <https://danbri.github.io/glitchcan-minigam/edot/ns#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Relations
edot:hasFormat a rdf:Property ; rdfs:comment "an entity serializes to a format" .
edot:contains a rdf:Property ; rdfs:comment "composition: a parent holds child entities" .
edot:editsType a rdf:Property ; rdfs:comment "a widget edits entities of a type" .
edot:appliesTo a rdf:Property ; rdfs:comment "a command operates on entities of a type" .
edot:presentsItemsOf a rdf:Property ; rdfs:comment "a collection window shows a set of items of a type" .
edot:locality a rdf:Property ; rdfs:comment "where an item lives: local or remote" .

# Entity classes
edot:Entity a rdfs:Class ;
  rdfs:label "Entity" .
edot:Document a rdfs:Class ;
  rdfs:label "Document" ;
  rdfs:subClassOf edot:Entity ;
  edot:hasFormat edot:docx ;
  edot:hasFormat edot:markdown ;
  edot:hasFormat edot:html ;
  edot:hasFormat edot:odt ;
  edot:hasFormat edot:rtf .
edot:Table a rdfs:Class ;
  rdfs:label "Data table" ;
  rdfs:subClassOf edot:Entity ;
  edot:hasFormat edot:csv ;
  edot:hasFormat edot:sqlite ;
  edot:hasFormat edot:nquads .
edot:Spreadsheet a rdfs:Class ;
  rdfs:label "Spreadsheet" ;
  rdfs:subClassOf edot:Entity .
edot:View a rdfs:Class ;
  rdfs:label "SQL view" ;
  rdfs:subClassOf edot:Table .
edot:Folder a rdfs:Class ;
  rdfs:label "Folder" ;
  rdfs:subClassOf edot:Entity ;
  edot:contains edot:Table ;
  edot:contains edot:Spreadsheet ;
  edot:contains edot:View .
edot:SlideDeck a rdfs:Class ;
  rdfs:label "Slide deck" ;
  rdfs:subClassOf edot:Entity ;
  edot:hasFormat edot:edeck ;
  edot:hasFormat edot:pptx ;
  edot:hasFormat edot:odp ;
  edot:hasFormat edot:pdf ;
  edot:hasFormat edot:html ;
  edot:contains edot:Slide .
edot:Slide a rdfs:Class ;
  rdfs:label "Slide" ;
  rdfs:subClassOf edot:Entity ;
  edot:contains edot:SlideElement .
edot:SlideElement a rdfs:Class ;
  rdfs:label "Slide element" ;
  rdfs:subClassOf edot:Entity .
edot:TextElement a rdfs:Class ;
  rdfs:label "Text element" ;
  rdfs:subClassOf edot:SlideElement .
edot:ImageElement a rdfs:Class ;
  rdfs:label "Image element" ;
  rdfs:subClassOf edot:SlideElement .
edot:ShapeElement a rdfs:Class ;
  rdfs:label "Shape element" ;
  rdfs:subClassOf edot:SlideElement .
edot:Calendar a rdfs:Class ;
  rdfs:label "Calendar" ;
  rdfs:subClassOf edot:Entity ;
  edot:hasFormat edot:ics ;
  edot:contains edot:Event .
edot:Event a rdfs:Class ;
  rdfs:label "Calendar event" ;
  rdfs:subClassOf edot:Entity .
edot:Place a rdfs:Class ;
  rdfs:label "Place" ;
  rdfs:subClassOf edot:Entity ;
  edot:hasFormat edot:geojson ;
  edot:hasFormat edot:kml .
edot:Feed a rdfs:Class ;
  rdfs:label "Feed" ;
  rdfs:subClassOf edot:Entity ;
  edot:hasFormat edot:rss ;
  edot:hasFormat edot:atom ;
  edot:contains edot:FeedItem .
edot:FeedItem a rdfs:Class ;
  rdfs:label "Feed item" ;
  rdfs:subClassOf edot:Entity .
edot:Mailbox a rdfs:Class ;
  rdfs:label "Mailbox" ;
  rdfs:subClassOf edot:Entity ;
  edot:contains edot:MailMessage .
edot:MailMessage a rdfs:Class ;
  rdfs:label "Mail message" ;
  rdfs:subClassOf edot:Entity .
edot:Project a rdfs:Class ;
  rdfs:label "Project" ;
  rdfs:subClassOf edot:Entity ;
  edot:hasFormat edot:edotzip ;
  edot:contains edot:Document ;
  edot:contains edot:Table ;
  edot:contains edot:SlideDeck ;
  edot:contains edot:Calendar ;
  edot:contains edot:Place .
edot:Channel a rdfs:Class ;
  rdfs:label "Group channel" ;
  rdfs:subClassOf edot:Entity ;
  edot:contains edot:ChatMessage .
edot:ChatMessage a rdfs:Class ;
  rdfs:label "Chat message" ;
  rdfs:subClassOf edot:Entity .
edot:Automation a rdfs:Class ;
  rdfs:label "Automation" ;
  rdfs:subClassOf edot:Entity .
edot:Person a rdfs:Class ;
  rdfs:label "Person" ;
  rdfs:subClassOf edot:Entity .
edot:File a rdfs:Class ;
  rdfs:label "File" ;
  rdfs:subClassOf edot:Entity .
edot:Image a rdfs:Class ;
  rdfs:label "Image" ;
  rdfs:subClassOf edot:File ;
  edot:hasFormat edot:png ;
  edot:hasFormat edot:jpeg ;
  edot:hasFormat edot:svg .
edot:Video a rdfs:Class ;
  rdfs:label "Video" ;
  rdfs:subClassOf edot:File ;
  edot:hasFormat edot:mp4 ;
  edot:hasFormat edot:webm .
edot:Audio a rdfs:Class ;
  rdfs:label "Audio" ;
  rdfs:subClassOf edot:File ;
  edot:hasFormat edot:mp3 ;
  edot:hasFormat edot:wav .
edot:Collection a rdfs:Class ;
  rdfs:label "Collection" ;
  rdfs:subClassOf edot:Entity .

# Formats
edot:docx a edot:Format ; rdfs:label "Word" ; edot:mime "application/vnd.openxmlformats-officedocument.wordprocessingml.document" ; edot:ext "docx" .
edot:markdown a edot:Format ; rdfs:label "Markdown" ; edot:mime "text/markdown" ; edot:ext "md" .
edot:html a edot:Format ; rdfs:label "HTML" ; edot:mime "text/html" ; edot:ext "html" .
edot:odt a edot:Format ; rdfs:label "OpenDocument Text" ; edot:mime "application/vnd.oasis.opendocument.text" ; edot:ext "odt" .
edot:rtf a edot:Format ; rdfs:label "RTF" ; edot:mime "application/rtf" ; edot:ext "rtf" .
edot:csv a edot:Format ; rdfs:label "CSV" ; edot:mime "text/csv" ; edot:ext "csv" .
edot:sqlite a edot:Format ; rdfs:label "SQLite" ; edot:mime "application/vnd.sqlite3" ; edot:ext "sqlite" .
edot:nquads a edot:Format ; rdfs:label "N-Quads" ; edot:mime "application/n-quads" ; edot:ext "nq" .
edot:edeck a edot:Format ; rdfs:label "edot deck (JSON)" ; edot:mime "application/json" ; edot:ext "json" .
edot:pptx a edot:Format ; rdfs:label "PowerPoint" ; edot:mime "application/vnd.openxmlformats-officedocument.presentationml.presentation" ; edot:ext "pptx" .
edot:odp a edot:Format ; rdfs:label "OpenDocument Presentation" ; edot:mime "application/vnd.oasis.opendocument.presentation" ; edot:ext "odp" .
edot:pdf a edot:Format ; rdfs:label "PDF" ; edot:mime "application/pdf" ; edot:ext "pdf" .
edot:ics a edot:Format ; rdfs:label "iCalendar" ; edot:mime "text/calendar" ; edot:ext "ics" .
edot:geojson a edot:Format ; rdfs:label "GeoJSON" ; edot:mime "application/geo+json" ; edot:ext "geojson" .
edot:kml a edot:Format ; rdfs:label "KML" ; edot:mime "application/vnd.google-earth.kml+xml" ; edot:ext "kml" .
edot:rss a edot:Format ; rdfs:label "RSS" ; edot:mime "application/rss+xml" ; edot:ext "xml" .
edot:atom a edot:Format ; rdfs:label "Atom" ; edot:mime "application/atom+xml" ; edot:ext "xml" .
edot:edotzip a edot:Format ; rdfs:label "edot project" ; edot:mime "application/zip" ; edot:ext "edot.zip" .
edot:png a edot:Format ; rdfs:label "PNG" ; edot:mime "image/png" ; edot:ext "png" .
edot:jpeg a edot:Format ; rdfs:label "JPEG" ; edot:mime "image/jpeg" ; edot:ext "jpg" .
edot:svg a edot:Format ; rdfs:label "SVG" ; edot:mime "image/svg+xml" ; edot:ext "svg" .
edot:mp4 a edot:Format ; rdfs:label "MP4" ; edot:mime "video/mp4" ; edot:ext "mp4" .
edot:webm a edot:Format ; rdfs:label "WebM" ; edot:mime "video/webm" ; edot:ext "webm" .
edot:mp3 a edot:Format ; rdfs:label "MP3" ; edot:mime "audio/mpeg" ; edot:ext "mp3" .
edot:wav a edot:Format ; rdfs:label "WAV" ; edot:mime "audio/wav" ; edot:ext "wav" .

# Widgets ↔ the entity types they edit
edot:edot-editor a edot:Widget ; edot:editsType edot:Document .
edot:edot-grid a edot:Widget ; edot:editsType edot:Table .
edot:edot-sheet a edot:Widget ; edot:editsType edot:Spreadsheet .
edot:edot-place-input a edot:Widget ; edot:editsType edot:Place .
edot:edot-slides a edot:Widget ; edot:editsType edot:SlideDeck .
edot:edot-calendar a edot:Widget ; edot:editsType edot:Calendar .
edot:edot-maps a edot:Widget ; edot:editsType edot:Place .
edot:edot-groups a edot:Widget ; edot:editsType edot:Channel .
edot:edot-projects a edot:Widget ; edot:editsType edot:Project .

# Collection windows ↔ the item type each presents
edot:edot-file-browser a edot:CollectionView ; edot:presentsItemsOf edot:File .
edot:edot-gallery a edot:CollectionView ; edot:presentsItemsOf edot:Image .
edot:edot-video-library a edot:CollectionView ; edot:presentsItemsOf edot:Video .
edot:edot-people a edot:CollectionView ; edot:presentsItemsOf edot:Person .
