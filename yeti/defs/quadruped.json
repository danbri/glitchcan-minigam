{
  "comment": "Shared quadruped body plan - instantiate with params",
  "version": "1.0",

  "quadruped": {
    "type": "smoothUnion",
    "k": { "var": "smooth" },
    "children": [
      {
        "comment": "Body core",
        "type": "ellipsoid",
        "params": { "radii": { "var": "bodyRadii" }, "color": { "var": "color" } }
      },
      {
        "comment": "Rump",
        "type": "ellipsoid",
        "params": { "radii": { "var": "rumpRadii" }, "color": { "var": "color" } },
        "transform": { "translate": { "var": "rumpPos" } }
      },
      {
        "comment": "Head",
        "type": "ellipsoid",
        "params": { "radii": { "var": "headRadii" }, "color": { "var": "color" } },
        "transform": { "translate": { "var": "headPos" } }
      },
      {
        "comment": "Snout",
        "type": "ellipsoid",
        "params": { "radii": { "var": "snoutRadii" }, "color": { "var": "color" } },
        "transform": { "translate": { "var": "snoutPos" } }
      },
      {
        "comment": "Nose",
        "type": "sphere",
        "params": { "r": { "var": "noseSize" }, "color": [0.1, 0.08, 0.08] },
        "transform": { "translate": { "var": "nosePos" } }
      },
      {
        "comment": "Ear L",
        "type": "ellipsoid",
        "params": { "radii": { "var": "earRadii" }, "color": { "var": "color" } },
        "transform": { "translate": { "var": "earPos" }, "rotate": { "var": "earRotate" } }
      },
      {
        "comment": "Ear R",
        "type": "ellipsoid",
        "params": { "radii": { "var": "earRadii" }, "color": { "var": "color" } },
        "transform": { "translate": { "var": "earPosR" }, "rotate": { "var": "earRotate" } }
      },
      {
        "comment": "Front leg L",
        "type": "roundCone",
        "params": { "r1": { "var": "legThighR" }, "r2": { "var": "legAnkleR" }, "h": { "var": "frontLegH" }, "color": { "var": "color" } },
        "transform": { "translate": { "var": "frontLegPos" }, "rotate": { "var": "frontLegRot" } }
      },
      {
        "comment": "Front leg R",
        "type": "roundCone",
        "params": { "r1": { "var": "legThighR" }, "r2": { "var": "legAnkleR" }, "h": { "var": "frontLegH" }, "color": { "var": "color" } },
        "transform": { "translate": { "var": "frontLegPosR" }, "rotate": { "var": "frontLegRot" } }
      },
      {
        "comment": "Back leg L",
        "type": "roundCone",
        "params": { "r1": { "var": "legThighR" }, "r2": { "var": "legAnkleR" }, "h": { "var": "backLegH" }, "color": { "var": "color" } },
        "transform": { "translate": { "var": "backLegPos" }, "rotate": { "var": "backLegRot" } }
      },
      {
        "comment": "Back leg R",
        "type": "roundCone",
        "params": { "r1": { "var": "legThighR" }, "r2": { "var": "legAnkleR" }, "h": { "var": "backLegH" }, "color": { "var": "color" } },
        "transform": { "translate": { "var": "backLegPosR" }, "rotate": { "var": "backLegRot" } }
      },
      {
        "comment": "Tail",
        "type": "capsule",
        "params": { "h": { "var": "tailLen" }, "r": { "var": "tailR" }, "color": { "var": "color" } },
        "transform": { "translate": { "var": "tailPos" }, "rotate": { "var": "tailRot" } }
      }
    ]
  }
}
