.aider*

# Claude Code local state (settings, agent worktrees) — never commit
.claude/*
!.claude/skills/

# Python virtual environments
.venv/
*/.venv/

# Node modules
node_modules/

# OS files
.DS_Store
Thumbs.db

# IDE files
.vscode/
.idea/

# Test artifacts
playwright-report/
test-results/
test-results.json
coverage/
tmp/

# Logs
*.log
npm-debug.log*

# Environment files
.env
.env.local
_tmp_review_*.mjs
magpie/dbdb/tools/scout-out/
magpie/dbdb/tools/pack-work/

# downloaded source scans: fetched by hand, not committed
magpie/dbdb/splats/incoming/*
!magpie/dbdb/splats/incoming/.gitkeep

# generated viewers: rebuildable from the .sog in one command
magpie/dbdb/splats/view/

# generated turnaround sheets: rebuildable with npm run splat:sheet
magpie/dbdb/tools/sheets/

# style probe renders: rebuildable with npm run splat:style
magpie/dbdb/tools/styles/

# catalogue check screenshot: rebuildable with npm run test:catalog
magpie/dbdb/tools/catalog-check.png

# harvested raw scans: 2MB each and unjudged. The manifest is committed and
# hf-harvest.mjs re-fetches from it; a scan earns a place in the repo when an
# element is cut from it.
magpie/dbdb/splats/harvest/*.sog
magpie/dbdb/tools/contact/
magpie/dbdb/tools/contact-check/
magpie/dbdb/splats/harvest/*.tmp
