{
  "title": "Ball Chain Pendulum",
  "subtitle": "24-bead chain with realistic pendulum physics",
  "version": "4.0",
  "camera": { "distance": 8, "phi": 0.35, "theta": 0.15, "target": [0, -1.0, 0] },
  "notes": "24 spherical beads swinging from ceiling mount with phase-propagated wave motion. Realistic pendulum arc with gravity compensation.",

