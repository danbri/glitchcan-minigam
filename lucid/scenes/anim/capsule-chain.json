    "_motion": "=== MOTION PARAMETERS ===",
    "swingSpeed": {
      "value": 2.2,
      "type": "scalar",
      "min": 0.5,
      "max": 4.0,
      "description": "Pendulum frequency (rad/sec)"
    },
    "swingAmplitude": {
      "value": 0.45,
      "type": "scalar",
      "min": 0.1,
      "max": 0.8,
      "description": "Maximum swing displacement"
    },
    "waveDelay": {
      "value": 0.08,
      "type": "scalar",
      "min": 0.02,
      "max": 0.20,
      "description": "Phase delay between beads (wave propagation)"
    },
    "dampingFactor": {
      "value": 0.92,
      "type": "scalar",
      "min": 0.7,
      "max": 1.0,
      "description": "How much each bead reduces amplitude (1.0 = no damping)"
    },

    "_chain": "=== CHAIN PARAMETERS ===",
    "beadRadius": {
      "value": 0.065,
      "type": "scalar",
      "min": 0.03,
      "max": 0.12,
      "description": "Radius of each bead"
    },
    "beadSpacing": {
      "value": 0.18,
      "type": "scalar",
      "min": 0.10,
      "max": 0.30,
      "description": "Vertical spacing between beads"
    },
    "weightBallRadius": {
      "value": 0.32,
      "type": "scalar",
      "min": 0.15,
      "max": 0.50,
      "description": "Weight ball at end"
    },

    "_colors": "=== COLORS ===",
    "fixtureColor": { "value": [0.25, 0.22, 0.20], "type": "color3", "description": "Mounting bracket color" },
    "beadColorTop": { "value": [0.95, 0.88, 0.30], "type": "color3", "description": "Bead color at top (golden)" },
    "beadColorBottom": { "value": [0.75, 0.45, 0.15], "type": "color3", "description": "Bead color at bottom (bronze)" },
    "weightColor": { "value": [0.80, 0.55, 0.20], "type": "color3", "description": "Weight ball color (brass)" }
  },

