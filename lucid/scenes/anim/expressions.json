{
  "title": "Animated Expressions",
  "subtitle": "Time-based animation with math expressions",
  "version": "1.0",
  "defs": {
    "orbiter": {
      "type": "sphere",
      "params": { "r": 0.15, "color": [1.0, 0.8, 0.2] }
    }
  },
  "root": {
    "type": "union",
    "children": [
      {
        "type": "sphere",
        "params": {
          "r": { "expr": "add", "args": [0.5, { "expr": "mul", "args": [0.15, { "expr": "sin", "args": [{ "var": "time" }] }] }] },
          "color": [0.3, 0.5, 0.9]
        }
      },
      {
        "type": "ref",
        "id": "orbiter",
        "transform": {
          "translate": [
            { "expr": "mul", "args": [1.2, { "expr": "cos", "args": [{ "var": "time" }] }] },
            { "expr": "mul", "args": [0.3, { "expr": "sin", "args": [{ "expr": "mul", "args": [{ "var": "time" }, 3] }] }] },
            { "expr": "mul", "args": [1.2, { "expr": "sin", "args": [{ "var": "time" }] }] }
          ]
        }
      },
      {
        "type": "ref",
        "id": "orbiter",
        "transform": {
          "translate": [
            { "expr": "mul", "args": [1.2, { "expr": "cos", "args": [{ "expr": "add", "args": [{ "var": "time" }, 2.1] }] }] },
            { "expr": "mul", "args": [0.3, { "expr": "sin", "args": [{ "expr": "mul", "args": [{ "expr": "add", "args": [{ "var": "time" }, 2.1] }, 3] }] }] },
            { "expr": "mul", "args": [1.2, { "expr": "sin", "args": [{ "expr": "add", "args": [{ "var": "time" }, 2.1] }] }] }
          ]
        }
      },
      {
        "type": "ref",
        "id": "orbiter",
        "transform": {
          "translate": [
            { "expr": "mul", "args": [1.2, { "expr": "cos", "args": [{ "expr": "add", "args": [{ "var": "time" }, 4.2] }] }] },
            { "expr": "mul", "args": [0.3, { "expr": "sin", "args": [{ "expr": "mul", "args": [{ "expr": "add", "args": [{ "var": "time" }, 4.2] }, 3] }] }] },
            { "expr": "mul", "args": [1.2, { "expr": "sin", "args": [{ "expr": "add", "args": [{ "var": "time" }, 4.2] }] }] }
          ]
        }
      },
      {
        "type": "torus",
        "params": { "major": 1.2, "minor": 0.03, "color": [0.4, 0.4, 0.5] }
      }
    ]
  }
}
