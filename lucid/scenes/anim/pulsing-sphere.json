{
  "title": "Pulsing Sphere",
  "subtitle": "Animated radius with parametric controls",
  "version": "2.0",
  "notes": "Simple demonstration of time-based animation. Adjust pulse speed, amplitude, and colors.",

  "params": {
    "baseRadius": {
      "value": 1.0,
      "type": "scalar",
      "min": 0.3,
      "max": 2.0,
      "description": "Base sphere radius"
    },
    "pulseAmount": {
      "value": 0.3,
      "type": "scalar",
      "min": 0.05,
      "max": 0.8,
      "description": "Pulse amplitude"
    },
    "pulseSpeed": {
      "value": 1.0,
      "type": "scalar",
      "min": 0.2,
      "max": 5.0,
      "description": "Pulse frequency"
    },
    "sphereColor": {
      "value": [0.4, 0.8, 1.0],
      "type": "color3",
      "description": "Sphere color"
    }
  },

  "root": {
    "type": "sphere",
    "params": {
      "r": {
        "expr": "add",
        "args": [
          { "var": "baseRadius" },
          { "expr": "mul", "args": [
            { "var": "pulseAmount" },
            { "expr": "sin", "args": [{ "expr": "mul", "args": [{ "var": "time" }, { "var": "pulseSpeed" }] }] }
          ]}
        ]
      },
      "color": { "var": "sphereColor" }
    }
  }
}
