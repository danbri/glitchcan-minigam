{
  "title": "Distance Field Invaders",
  "subtitle": "Parametric space invaders with animation controls",
  "version": "2.0",

  "params": {
    "moveSpeed": {
      "value": 1.0,
      "type": "scalar",
      "min": 0.2,
      "max": 3.0,
      "description": "Animation speed multiplier"
    },
    "moveAmplitude": {
      "value": 0.3,
      "type": "scalar",
      "min": 0.05,
      "max": 0.8,
      "description": "Side-to-side movement range"
    },
    "invaderScale": {
      "value": 1.0,
      "type": "scalar",
      "min": 0.5,
      "max": 2.0,
      "description": "Overall invader size"
    },
    "topRowColor": {
      "value": [0, 1, 0.5],
      "type": "color3",
      "description": "Top row invader color"
    },
    "bottomRowColor": {
      "value": [1, 0.3, 0.8],
      "type": "color3",
      "description": "Bottom row invader color"
    }
  },

  "defs": {
    "invader": {
      "type": "subtract",
      "children": [
        {
          "type": "union",
          "children": [
            { "type": "box", "params": { "size": [0.35, 0.25, 0.1] } },
            { "type": "box", "params": { "size": [0.1, 0.1, 0.1] }, "transform": { "translate": [0.25, 0.35, 0] } },
            { "type": "box", "params": { "size": [0.1, 0.1, 0.1] }, "transform": { "translate": [-0.25, 0.35, 0] } },
            { "type": "box", "params": { "size": [0.05, 0.15, 0.1] }, "transform": { "translate": [0.4, 0.05, 0] } },
            { "type": "box", "params": { "size": [0.05, 0.15, 0.1] }, "transform": { "translate": [-0.4, 0.05, 0] } },
            { "type": "box", "params": { "size": [0.1, 0.1, 0.1] }, "transform": { "translate": [0.35, -0.35, 0] } },
            { "type": "box", "params": { "size": [0.1, 0.1, 0.1] }, "transform": { "translate": [-0.35, -0.35, 0] } }
          ]
        },
        {
          "type": "union",
          "children": [
            { "type": "box", "params": { "size": [0.08, 0.08, 0.2] }, "transform": { "translate": [0.15, 0.1, 0.05] } },
            { "type": "box", "params": { "size": [0.08, 0.08, 0.2] }, "transform": { "translate": [-0.15, 0.1, 0.05] } },
            { "type": "box", "params": { "size": [0.12, 0.08, 0.2] }, "transform": { "translate": [0.0, -0.25, 0.05] } }
          ]
        }
      ]
    }
  },
  "root": {
    "type": "union",
    "children": [
      {
        "comment": "Top row - left",
        "type": "material",
        "params": { "color": { "var": "topRowColor" } },
        "child": {
          "type": "transform",
          "transform": {
            "translate": [
              { "expr": "add", "args": [-1.5, { "expr": "mul", "args": [{ "expr": "sin", "args": [{ "expr": "mul", "args": [{ "var": "time" }, { "var": "moveSpeed" }] }] }, { "var": "moveAmplitude" }] }] },
              0.6,
              0
            ],
            "scale": { "var": "invaderScale" }
          },
          "child": { "type": "ref", "id": "invader" }
        }
      },
      {
        "comment": "Top row - center",
        "type": "material",
        "params": { "color": { "var": "topRowColor" } },
        "child": {
          "type": "transform",
          "transform": {
            "translate": [
              0,
              { "expr": "add", "args": [0.6, { "expr": "mul", "args": [{ "expr": "sin", "args": [{ "expr": "add", "args": [{ "expr": "mul", "args": [{ "var": "time" }, { "var": "moveSpeed" }] }, 1] }] }, { "expr": "mul", "args": [{ "var": "moveAmplitude" }, 0.7] }] }] },
              0
            ],
            "scale": { "var": "invaderScale" }
          },
          "child": { "type": "ref", "id": "invader" }
        }
      },
      {
        "comment": "Top row - right",
        "type": "material",
        "params": { "color": { "var": "topRowColor" } },
        "child": {
          "type": "transform",
          "transform": {
            "translate": [
              { "expr": "add", "args": [1.5, { "expr": "mul", "args": [{ "expr": "sin", "args": [{ "expr": "mul", "args": [{ "var": "time" }, { "var": "moveSpeed" }] }] }, { "var": "moveAmplitude" }] }] },
              0.6,
              0
            ],
            "scale": { "var": "invaderScale" }
          },
          "child": { "type": "ref", "id": "invader" }
        }
      },
      {
        "comment": "Bottom row - left",
        "type": "material",
        "params": { "color": { "var": "bottomRowColor" } },
        "child": {
          "type": "transform",
          "transform": {
            "translate": [-1.5, -0.6, 0],
            "scale": { "var": "invaderScale" }
          },
          "child": { "type": "ref", "id": "invader" }
        }
      },
      {
        "comment": "Bottom row - center",
        "type": "material",
        "params": { "color": { "var": "bottomRowColor" } },
        "child": {
          "type": "transform",
          "transform": {
            "translate": [
              { "expr": "mul", "args": [{ "expr": "sin", "args": [{ "expr": "mul", "args": [{ "var": "time" }, { "var": "moveSpeed" }] }] }, { "var": "moveAmplitude" }] },
              -0.6,
              0
            ],
            "scale": { "var": "invaderScale" }
          },
          "child": { "type": "ref", "id": "invader" }
        }
      },
      {
        "comment": "Bottom row - right",
        "type": "material",
        "params": { "color": { "var": "bottomRowColor" } },
        "child": {
          "type": "transform",
          "transform": {
            "translate": [
              1.5,
              { "expr": "add", "args": [-0.6, { "expr": "mul", "args": [{ "expr": "sin", "args": [{ "expr": "add", "args": [{ "expr": "mul", "args": [{ "var": "time" }, { "var": "moveSpeed" }] }, 3] }] }, { "expr": "mul", "args": [{ "var": "moveAmplitude" }, 0.7] }] }] },
              0
            ],
            "scale": { "var": "invaderScale" }
          },
          "child": { "type": "ref", "id": "invader" }
        }
      }
    ]
  }
}
