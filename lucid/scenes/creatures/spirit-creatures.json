{
  "title": "Spirit Creatures",
  "subtitle": "Rotating ghost-like beings with tentacles",
  "version": "1.0",
  "defs": {
    "tentacle_chain": {
      "type": "smoothUnion",
      "k": 0.08,
      "children": [
        { "type": "sphere", "params": { "r": 0.08, "color": [1, 0.2, 0.1] } },
        { "type": "sphere", "params": { "r": 0.06, "color": [1, 0.6, 0.1] }, "transform": { "translate": [0.15, 0, 0] } },
        { "type": "sphere", "params": { "r": 0.03, "color": [1, 1, 0.5] }, "transform": { "translate": [0.3, 0, 0] } }
      ]
    },
    "ghost_body": {
      "type": "sphere",
      "params": { "r": 0.22, "color": [0.9, 0.95, 1.0] }
    },
    "spirit_creature": {
      "type": "smoothUnion",
      "k": 0.1,
      "children": [
        { "type": "ref", "id": "ghost_body" },
        {
          "type": "radial",
          "count": 6,
          "axis": "z",
          "child": {
            "type": "transform",
            "transform": { "translate": [0.15, 0, 0.1], "rotate": [0, 45, 0] },
            "child": { "type": "ref", "id": "tentacle_chain" }
          }
        }
      ]
    }
  },
  "root": {
    "type": "repeat",
    "period": [2.0, 2.0, 2.0],
    "child": {
      "type": "transform",
      "transform": {
        "translate": [0, { "expr": "mul", "args": [0.1, { "expr": "sin", "args": [{ "var": "time" }] }] }, 0],
        "rotate": [0, 0, { "expr": "mul", "args": [20, { "var": "time" }] }]
      },
      "child": { "type": "ref", "id": "spirit_creature" }
    }
  }
}
