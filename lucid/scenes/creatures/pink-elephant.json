{
  "title": "Pink Elephant",
  "subtitle": "Parametric quadruped - elephant preset",
  "version": "1.0",
  "camera": { "distance": 14, "phi": 0.35, "theta": 0.3, "target": [0, 0, 0] },
  "notes": "Generic quadruped body plan from yeti web components, configured as a pink elephant.",

  "params": {
    "smooth": { "value": 0.25, "type": "scalar", "min": 0.05, "max": 0.5, "description": "Smooth union blending" },
    "bodyColor": { "value": [1.0, 0.75, 0.8], "type": "color3", "description": "Body color (pink)" }
  },

  "root": {
    "type": "smoothUnion",
    "k": { "var": "smooth" },
    "children": [
      {
        "comment": "Body core",
        "type": "ellipsoid",
        "params": { "radii": [0.9, 0.85, 1.2], "color": { "var": "bodyColor" } }
      },
      {
        "comment": "Rump",
        "type": "ellipsoid",
        "params": { "radii": [0.85, 0.8, 0.7], "color": { "var": "bodyColor" } },
        "transform": { "translate": [0, 0, -1.1] }
      },
      {
        "comment": "Head",
        "type": "ellipsoid",
        "params": { "radii": [0.5, 0.48, 0.45], "color": { "var": "bodyColor" } },
        "transform": { "translate": [0, 0.3, 1.4] }
      },
      {
        "comment": "Trunk (snout)",
        "type": "ellipsoid",
        "params": { "radii": [0.12, 0.1, 0.5], "color": { "var": "bodyColor" } },
        "transform": { "translate": [0, -0.1, 1.9] }
      },
      {
        "comment": "Trunk tip",
        "type": "sphere",
        "params": { "r": 0.08, "color": [0.15, 0.12, 0.12] },
        "transform": { "translate": [0, -0.3, 2.3] }
      },
      {
        "comment": "Ear L - elephant big floppy ears",
        "type": "ellipsoid",
        "params": { "radii": [0.5, 0.6, 0.08], "color": { "var": "bodyColor" } },
        "transform": { "translate": [0.55, 0.35, 1.2], "rotate": [0, 0.3, 0] }
      },
      {
        "comment": "Ear R",
        "type": "ellipsoid",
        "params": { "radii": [0.5, 0.6, 0.08], "color": { "var": "bodyColor" } },
        "transform": { "translate": [-0.55, 0.35, 1.2], "rotate": [0, -0.3, 0] }
      },
      {
        "comment": "Front leg L",
        "type": "roundCone",
        "params": { "r1": 0.25, "r2": 0.2, "h": 0.9, "color": { "var": "bodyColor" } },
        "transform": { "translate": [0.45, -1.0, 0.5] }
      },
      {
        "comment": "Front leg R",
        "type": "roundCone",
        "params": { "r1": 0.25, "r2": 0.2, "h": 0.9, "color": { "var": "bodyColor" } },
        "transform": { "translate": [-0.45, -1.0, 0.5] }
      },
      {
        "comment": "Back leg L",
        "type": "roundCone",
        "params": { "r1": 0.25, "r2": 0.2, "h": 0.85, "color": { "var": "bodyColor" } },
        "transform": { "translate": [0.45, -0.95, -0.9], "rotate": [0.05, 0, 0] }
      },
      {
        "comment": "Back leg R",
        "type": "roundCone",
        "params": { "r1": 0.25, "r2": 0.2, "h": 0.85, "color": { "var": "bodyColor" } },
        "transform": { "translate": [-0.45, -0.95, -0.9], "rotate": [0.05, 0, 0] }
      },
      {
        "comment": "Tail - short elephant tail",
        "type": "capsule",
        "params": { "h": 0.5, "r": 0.06, "color": { "var": "bodyColor" } },
        "transform": { "translate": [0, 0.1, -1.7], "rotate": [-0.2, 0, 0] }
