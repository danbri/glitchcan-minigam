{
  "version": "1.1",
  "title": "Simple Table",
  "description": "Box tabletop with 4 cylinder legs",

  "params": {
    "legRadius": {
      "value": 0.08,
      "type": "scalar",
      "min": 0.04,
      "max": 0.15,
      "description": "Leg thickness"
    },
    "legHeight": {
      "value": 0.8,
      "type": "scalar",
      "min": 0.4,
      "max": 1.2,
      "description": "Leg height"
    },
    "woodColor": {
      "value": [0.6, 0.35, 0.2],
      "type": "color3",
      "description": "Wood color"
    }
  },

  "defs": {
    "leg": {
      "type": "cylinder",
      "params": {
        "r": {"var": "legRadius"},
        "h": {"var": "legHeight"},
        "color": {"var": "woodColor"}
      }
    }
  },
  "root": {
    "type": "union",
    "children": [
      {
        "type": "box",
        "params": {
          "size": [1.0, 0.08, 0.6],
          "color": {"var": "woodColor"}
        },
        "transform": {
          "translate": [0, 0.4, 0]
        }
      },
      {
        "type": "ref",
        "id": "leg",
        "transform": {
          "translate": [-0.8, 0, -0.4]
        }
      },
      {
        "type": "ref",
        "id": "leg",
        "transform": {
          "translate": [0.8, 0, -0.4]
        }
      },
      {
        "type": "ref",
        "id": "leg",
        "transform": {
          "translate": [-0.8, 0, 0.4]
        }
      },
      {
        "type": "ref",
        "id": "leg",
        "transform": {
          "translate": [0.8, 0, 0.4]
        }
      }
    ]
  }
}
