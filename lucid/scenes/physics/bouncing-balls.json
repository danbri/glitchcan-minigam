{
  "title": "Bouncing Balls",
  "subtitle": "Physics-enabled SDF spheres with real-time simulation",
  "version": "1.1",
  "notes": "Demonstrates physics integration with SDF rendering. Spheres fall under gravity, bounce off ground, and collide with each other. Ball positions are driven by physics simulation.",

  "physics": {
    "enabled": true,
    "gravity": [0, -9.8, 0],
    "groundY": -1.5
  },

  "params": {
    "ballRadius": {
      "value": 0.25,
      "type": "scalar",
      "min": 0.1,
      "max": 0.5,
      "description": "Ball radius"
    },
    "ball1X": { "value": -0.5, "type": "scalar", "min": -3, "max": 3, "physics": "ball1.x" },
    "ball1Y": { "value": 2.5, "type": "scalar", "min": -2, "max": 5, "physics": "ball1.y" },
    "ball1Z": { "value": 0, "type": "scalar", "min": -3, "max": 3, "physics": "ball1.z" },
    "ball2X": { "value": 0, "type": "scalar", "min": -3, "max": 3, "physics": "ball2.x" },
    "ball2Y": { "value": 1.8, "type": "scalar", "min": -2, "max": 5, "physics": "ball2.y" },
    "ball2Z": { "value": 0.3, "type": "scalar", "min": -3, "max": 3, "physics": "ball2.z" },
    "ball3X": { "value": 0.4, "type": "scalar", "min": -3, "max": 3, "physics": "ball3.x" },
    "ball3Y": { "value": 1.0, "type": "scalar", "min": -2, "max": 5, "physics": "ball3.y" },
    "ball3Z": { "value": -0.2, "type": "scalar", "min": -3, "max": 3, "physics": "ball3.z" },
    "ballColor1": {
      "value": [1.0, 0.3, 0.3],
      "type": "color3",
      "description": "First ball color"
    },
    "ballColor2": {
      "value": [0.3, 1.0, 0.4],
      "type": "color3",
      "description": "Second ball color"
    },
    "ballColor3": {
      "value": [0.3, 0.5, 1.0],
      "type": "color3",
      "description": "Third ball color"
    },
    "groundColor": {
      "value": [0.4, 0.4, 0.45],
      "type": "color3",
      "description": "Ground plane color"
    }
  },

  "root": {
    "type": "union",
    "children": [
      {
        "comment": "Red ball - starts high, falls first",
        "type": "sphere",
        "id": "ball1",
        "params": {
          "r": { "var": "ballRadius" },
          "color": { "var": "ballColor1" }
        },
        "physics": {
          "type": "dynamic",
          "mass": 1.0,
          "restitution": 0.8
        },
        "transform": {
          "translate": [
            { "var": "ball1X" },
            { "var": "ball1Y" },
            { "var": "ball1Z" }
          ]
        }
      },
      {
        "comment": "Green ball - medium height",
        "type": "sphere",
        "id": "ball2",
        "params": {
          "r": { "var": "ballRadius" },
          "color": { "var": "ballColor2" }
        },
        "physics": {
          "type": "dynamic",
          "mass": 1.2,
          "restitution": 0.7
        },
        "transform": {
          "translate": [
            { "var": "ball2X" },
            { "var": "ball2Y" },
            { "var": "ball2Z" }
          ]
        }
      },
      {
        "comment": "Blue ball - lower, will be hit by others",
        "type": "sphere",
        "id": "ball3",
        "params": {
          "r": { "var": "ballRadius" },
          "color": { "var": "ballColor3" }
        },
        "physics": {
          "type": "dynamic",
          "mass": 0.8,
          "restitution": 0.9
        },
        "transform": {
          "translate": [
            { "var": "ball3X" },
            { "var": "ball3Y" },
            { "var": "ball3Z" }
          ]
        }
      },
      {
        "comment": "Ground plane",
        "type": "box",
        "id": "ground",
        "params": {
          "size": [4, 0.2, 4],
          "color": { "var": "groundColor" }
        },
        "transform": { "translate": [0, -1.6, 0] }
      }
    ]
  }
}
