{
  "title": "Bouncing Balls",
  "subtitle": "Physics-enabled SDF spheres with real-time simulation",
  "version": "1.0",
  "notes": "Demonstrates physics integration with SDF rendering. Spheres fall under gravity, bounce off ground, and collide with each other.",

  "physics": {
    "enabled": true,
    "gravity": [0, -9.8, 0],
    "groundY": -1.5
  },

  "params": {
    "ballRadius": {
      "value": 0.25,
      "type": "scalar",
      "min": 0.1,
      "max": 0.5,
      "description": "Ball radius"
    },
    "ballColor1": {
      "value": [1.0, 0.3, 0.3],
      "type": "color3",
      "description": "First ball color"
    },
    "ballColor2": {
      "value": [0.3, 1.0, 0.4],
      "type": "color3",
      "description": "Second ball color"
    },
    "ballColor3": {
      "value": [0.3, 0.5, 1.0],
      "type": "color3",
      "description": "Third ball color"
    },
    "groundColor": {
      "value": [0.4, 0.4, 0.45],
      "type": "color3",
      "description": "Ground plane color"
    }
  },

  "root": {
    "type": "union",
    "children": [
      {
        "comment": "Red ball - starts high, falls first",
        "type": "sphere",
        "id": "ball1",
        "params": {
          "r": { "var": "ballRadius" },
          "color": { "var": "ballColor1" }
        },
        "physics": {
          "type": "dynamic",
          "mass": 1.0,
          "restitution": 0.8
        },
        "transform": { "translate": [-0.5, 2.5, 0] }
      },
      {
        "comment": "Green ball - medium height",
        "type": "sphere",
        "id": "ball2",
        "params": {
          "r": { "var": "ballRadius" },
          "color": { "var": "ballColor2" }
        },
        "physics": {
          "type": "dynamic",
          "mass": 1.2,
          "restitution": 0.7
        },
        "transform": { "translate": [0, 1.8, 0.3] }
      },
      {
        "comment": "Blue ball - lower, will be hit by others",
        "type": "sphere",
        "id": "ball3",
        "params": {
          "r": { "var": "ballRadius" },
          "color": { "var": "ballColor3" }
        },
        "physics": {
          "type": "dynamic",
          "mass": 0.8,
          "restitution": 0.9
        },
        "transform": { "translate": [0.4, 1.0, -0.2] }
      },
      {
        "comment": "Ground plane",
        "type": "box",
        "id": "ground",
        "params": {
          "size": [4, 0.2, 4],
          "color": { "var": "groundColor" }
        },
        "physics": {
          "type": "static"
        },
        "transform": { "translate": [0, -1.6, 0] }
      }
    ]
  }
}
