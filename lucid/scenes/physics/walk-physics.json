{
  "title": "Walk Cycle + Physics",
  "subtitle": "Phase-coupled gait with XPBD constraint satisfaction",
  "version": "1.1",
  "description": "Walk cycle animation drives foot position targets, XPBD physics maintains leg length constraints",
  "camera": { "distance": 5, "phi": 0.3, "theta": 0.3, "target": [0, 0, 0] },

  "params": {
    "walkSpeed": { "value": 2.0, "min": 0, "max": 6, "type": "scalar" },
    "legSwing": { "value": 25, "min": 0, "max": 45, "type": "scalar" },
    "bodySway": { "value": 3, "min": 0, "max": 10, "type": "scalar" },
    "bodyColor": { "value": [0.6, 0.55, 0.5], "type": "color3" },
    "legColor": { "value": [0.5, 0.45, 0.4], "type": "color3" },
    "smoothness": { "value": 0.15, "min": 0.05, "max": 0.3, "type": "scalar" }
  },

  "rig": {
    "phase": {
      "gait": {
        "comment": "Quadruped diagonal gait - FL+RR together, FR+RL together",
        "driver": { "expr": "mul", "args": ["time", "walkSpeed"] },
        "followers": {
          "legFL": { "phase": 0, "amplitude": "legSwing" },
          "legRR": { "phase": 0, "amplitude": "legSwing" },
          "legFR": { "phase": 0.5, "amplitude": "legSwing" },
          "legRL": { "phase": 0.5, "amplitude": "legSwing" },
          "bodyRoll": { "phase": 0.25, "amplitude": "bodySway" }
        }
      }
    }
  },

  "physics": {
    "enabled": true,
    "gravity": [0, -9.8, 0],
    "groundY": -1.0,
    "damping": 0.95,
    "iterations": 6,
    "dt": 0.016,

    "bodies": [
      { "name": "body", "pos": [0, 0.5, 0], "mass": 8.0, "radius": 0.3 },
      { "name": "footFL", "pos": [0.35, -0.2, 0.4], "mass": 0.3, "radius": 0.1 },
      { "name": "footFR", "pos": [-0.35, -0.2, 0.4], "mass": 0.3, "radius": 0.1 },
      { "name": "footRL", "pos": [0.35, -0.2, -0.4], "mass": 0.3, "radius": 0.1 },
      { "name": "footRR", "pos": [-0.35, -0.2, -0.4], "mass": 0.3, "radius": 0.1 }
    ],

    "distanceConstraints": [
      { "bodyA": "body", "bodyB": "footFL", "length": 0.7, "compliance": 0.00005 },
      { "bodyA": "body", "bodyB": "footFR", "length": 0.7, "compliance": 0.00005 },
      { "bodyA": "body", "bodyB": "footRL", "length": 0.7, "compliance": 0.00005 },
      { "bodyA": "body", "bodyB": "footRR", "length": 0.7, "compliance": 0.00005 }
    ],

    "positionConstraints": [
      { "body": "footFL", "compliance": 0.01 },
      { "body": "footFR", "compliance": 0.01 },
      { "body": "footRL", "compliance": 0.01 },
      { "body": "footRR", "compliance": 0.01 }
    ]
  },

  "defs": {
    "leg": {
      "type": "material",
      "params": { "color": { "var": "legColor" } },
      "child": {
        "type": "capsule",
        "params": { "h": 0.5, "r": 0.08 }
      }
    }
  },

  "root": {
    "type": "union",
    "children": [
      {
        "comment": "=== BODY with physics position + rig sway ===",
        "type": "transform",
        "transform": {
          "translate": { "var": "phys_body" },
          "rotate": [0, 0, { "var": "gait_bodyRoll" }]
        },
        "child": {
          "type": "material",
          "params": { "color": { "var": "bodyColor" } },
          "child": {
            "type": "smoothUnion", "k": { "var": "smoothness" },
            "children": [
              {
                "comment": "Main body",
                "type": "ellipsoid",
                "params": { "radii": [0.45, 0.35, 0.7] }
              },
              {
                "comment": "Head",
                "type": "ellipsoid",
                "params": { "radii": [0.22, 0.2, 0.22] },
                "transform": { "translate": [0, 0.1, 0.75] }
              }
            ]
          }
        }
      },

      {
        "type": "transform",
        "transform": { "translate": { "var": "phys_footFL" } },
        "child": { "type": "ref", "id": "leg" }
      },
      {
        "type": "transform",
        "transform": { "translate": { "var": "phys_footFR" } },
        "child": { "type": "ref", "id": "leg" }
      },
      {
        "type": "transform",
        "transform": { "translate": { "var": "phys_footRL" } },
        "child": { "type": "ref", "id": "leg" }
      },
      {
        "type": "transform",
        "transform": { "translate": { "var": "phys_footRR" } },
        "child": { "type": "ref", "id": "leg" }
      }
    ]
  }
}
