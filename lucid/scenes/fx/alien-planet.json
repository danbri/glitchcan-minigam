{
  "title": "Alien Planet",
  "subtitle": "Animated noise displacement with parametric controls",
  "version": "2.0",
  "notes": "DISPLACE modifier uses noise to distort surfaces. Adjust displacement amount, noise scale, and animation speed.",

  "params": {
    "planetRadius": {
      "value": 1.0,
      "type": "scalar",
      "min": 0.5,
      "max": 2.0,
      "description": "Planet base size"
    },
    "displaceAmount": {
      "value": 0.06,
      "type": "scalar",
      "min": 0.01,
      "max": 0.25,
      "description": "Surface displacement strength"
    },
    "noiseScale": {
      "value": 3.0,
      "type": "scalar",
      "min": 1.0,
      "max": 8.0,
      "description": "Noise frequency (higher = finer detail)"
    },
    "noiseOctaves": {
      "value": 4,
      "type": "scalar",
      "min": 1,
      "max": 6,
      "description": "Noise detail levels"
    },
    "planetColor": {
      "value": [0.3, 0.6, 0.9],
      "type": "color3",
      "description": "Planet surface color"
    },
    "sunRadius": {
      "value": 0.15,
      "type": "scalar",
      "min": 0.05,
      "max": 0.4,
      "description": "Star/sun size"
    },
    "sunGlow": {
      "value": 0.8,
      "type": "scalar",
      "min": 0.2,
      "max": 1.0,
      "description": "Star emission intensity"
    },
    "sunColor": {
      "value": [1.0, 0.8, 0.3],
      "type": "color3",
      "description": "Star color"
    }
  },

  "root": {
    "type": "union",
    "children": [
      {
        "type": "displace",
        "amount": { "var": "displaceAmount" },
        "scale": { "var": "noiseScale" },
        "octaves": { "var": "noiseOctaves" },
        "noiseType": "fbm",
        "animate": true,
        "child": {
          "type": "sphere",
          "params": {
            "r": { "var": "planetRadius" },
            "color": { "var": "planetColor" }
          }
        },
        "transform": { "translate": [0, 0.5, 0] }
      },
      {
        "type": "material",
        "params": {
          "color": { "var": "sunColor" },
          "emit": { "var": "sunGlow" }
        },
        "child": {
          "type": "sphere",
          "params": { "r": { "var": "sunRadius" } },
          "transform": { "translate": [1.5, 1.0, -0.5] }
        }
      }
    ]
  }
}
