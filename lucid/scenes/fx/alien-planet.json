{
  "title": "Alien Planet",
  "subtitle": "Animated noise displacement",
  "version": "1.1",
  "notes": "DISPLACE modifier uses noise to distort surfaces. Params: amount (strength), scale (frequency), octaves (detail), noiseType ('fbm', 'turbulence', 'noise'), animate (true for moving noise). Amount reduced for more solid appearance.",
  "root": {
    "type": "union",
    "children": [
      {
        "type": "displace",
        "amount": 0.06,
        "scale": 3.0,
        "octaves": 4,
        "noiseType": "fbm",
        "animate": true,
        "child": {
          "type": "sphere",
          "params": { "r": 1.0, "color": [0.3, 0.6, 0.9] }
        },
        "transform": { "translate": [0, 0.5, 0] }
      },
      {
        "type": "material",
        "params": { "color": [1.0, 0.8, 0.3], "emit": 0.8 },
        "child": {
          "type": "sphere",
          "params": { "r": 0.15 },
          "transform": { "translate": [1.5, 1.0, -0.5] }
        }
      }
    ]
  }
}
