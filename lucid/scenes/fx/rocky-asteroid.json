{
  "title": "Rocky Asteroid",
  "subtitle": "Turbulent noise for rough surfaces",
  "version": "2.0",
  "notes": "Turbulence noise creates sharper, more rocky features than FBM. Great for asteroids, terrain, and weathered surfaces.",

  "params": {
    "asteroidSize": {
      "value": 0.8,
      "type": "scalar",
      "min": 0.3,
      "max": 1.5,
      "description": "Main asteroid size"
    },
    "displaceAmount": {
      "value": 0.08,
      "type": "scalar",
      "min": 0.02,
      "max": 0.25,
      "description": "Surface roughness"
    },
    "noiseScale": {
      "value": 2.5,
      "type": "scalar",
      "min": 1.0,
      "max": 6.0,
      "description": "Rock detail frequency"
    },
    "noiseOctaves": {
      "value": 3,
      "type": "scalar",
      "min": 1,
      "max": 5,
      "description": "Detail levels"
    },
    "blendAmount": {
      "value": 0.3,
      "type": "scalar",
      "min": 0.05,
      "max": 0.8,
      "description": "How much chunks blend together"
    },
    "rockColor": {
      "value": [0.5, 0.4, 0.35],
      "type": "color3",
      "description": "Main rock color"
    },
    "secondaryColor": {
      "value": [0.6, 0.5, 0.4],
      "type": "color3",
      "description": "Secondary chunk color"
    },
    "rotationSpeed": {
      "value": 0.3,
      "type": "scalar",
      "min": 0.0,
      "max": 2.0,
      "description": "Tumbling rotation speed"
    }
  },

  "root": {
    "type": "displace",
    "amount": { "var": "displaceAmount" },
    "scale": { "var": "noiseScale" },
    "octaves": { "var": "noiseOctaves" },
    "noiseType": "turbulence",
    "animate": false,
    "child": {
      "type": "smoothUnion",
      "k": { "var": "blendAmount" },
      "children": [
        {
          "type": "sphere",
          "params": {
            "r": { "var": "asteroidSize" },
            "color": { "var": "rockColor" }
          }
        },
        {
          "type": "sphere",
          "params": {
            "r": { "expr": "mul", "args": [{ "var": "asteroidSize" }, 0.75] },
            "color": { "var": "secondaryColor" }
          },
          "transform": {
            "translate": [0.4, 0.3, 0.2]
          }
        },
        {
          "type": "sphere",
          "params": {
            "r": { "expr": "mul", "args": [{ "var": "asteroidSize" }, 0.625] },
            "color": [0.55, 0.45, 0.38]
          },
          "transform": {
            "translate": [-0.3, -0.2, 0.4]
          }
        }
      ]
    },
    "transform": {
      "translate": [0, 0.5, 0],
      "rotate": [
        { "expr": "mul", "args": [{ "var": "time" }, { "var": "rotationSpeed" }, 20] },
        { "expr": "mul", "args": [{ "var": "time" }, { "var": "rotationSpeed" }, 15] },
        0
      ]
    }
  }
}
