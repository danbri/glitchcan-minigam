{
  "title": "Modifiers: Round & Shell",
  "subtitle": "Post-process SDF shapes",
  "version": "1.0",
  "notes": "MODIFIERS alter the SDF after shape calculation. 'round' adds radius to edges (softens corners). 'shell' hollows out shapes with wall thickness. Modifiers wrap any shape or CSG result. Great for organic or manufactured looks.",
  "root": {
    "type": "union",
    "children": [
      {
        "type": "box",
        "params": { "size": [0.35, 0.35, 0.35], "color": [0.8, 0.4, 0.2] },
        "transform": { "translate": [-1.2, 0.5, 0] }
      },
      {
        "type": "round",
        "r": 0.08,
        "child": {
          "type": "box",
          "params": { "size": [0.35, 0.35, 0.35], "color": [0.4, 0.8, 0.2] }
        },
        "transform": { "translate": [0, 0.5, 0] }
      },
      {
        "type": "shell",
        "thickness": 0.05,
        "child": {
          "type": "sphere",
          "params": { "r": 0.4, "color": [0.2, 0.5, 0.9] }
        },
        "transform": { "translate": [1.2, 0.5, 0] }
      }
    ]
  }
}
