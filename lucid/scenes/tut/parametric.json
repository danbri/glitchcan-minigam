{
  "title": "Artist Mannequin",
  "subtitle": "Parametric wooden drawing figure with articulated joints",
  "version": "2.0",
  "camera": { "distance": 6, "phi": 0.3, "theta": 0.2, "target": [0, 0.5, 0] },
  "notes": "Articulated artist's mannequin with realistic joint constraints. Adjust pose parameters to see limb articulation. Wood-grain coloring with ball-joint aesthetics.",

  "params": {
    "_pose": "=== POSE PARAMETERS ===",
    "headTilt": { "value": 0, "type": "scalar", "min": -30, "max": 30, "description": "Head tilt left/right" },
    "headNod": { "value": 0, "type": "scalar", "min": -20, "max": 20, "description": "Head nod forward/back" },

    "shoulderRaise": { "value": 0, "type": "scalar", "min": -15, "max": 60, "description": "Arms raise angle" },
    "elbowBend": { "value": 25, "type": "scalar", "min": 0, "max": 135, "description": "Elbow bend angle" },

    "hipAngle": { "value": 0, "type": "scalar", "min": -30, "max": 90, "description": "Leg forward/back" },
    "kneeBend": { "value": 0, "type": "scalar", "min": 0, "max": 130, "description": "Knee bend angle" },

    "torsoTwist": { "value": 0, "type": "scalar", "min": -30, "max": 30, "description": "Torso rotation" },

    "_proportions": "=== BODY PROPORTIONS ===",
    "height": { "value": 1.8, "type": "scalar", "min": 1.2, "max": 2.4, "description": "Overall figure height" },
    "limbThickness": { "value": 0.08, "type": "scalar", "min": 0.05, "max": 0.12, "description": "Limb segment radius" },

    "_colors": "=== MATERIALS ===",
    "woodColor": { "value": [0.76, 0.60, 0.42], "type": "color3", "description": "Primary wood tone" },
    "jointColor": { "value": [0.55, 0.42, 0.28], "type": "color3", "description": "Joint ball color" }
  },

  "root": {
    "type": "union",
    "children": [
      {
        "comment": "=== BASE STAND ===",
        "type": "material",
        "params": { "color": [0.25, 0.18, 0.12] },
        "child": {
          "type": "union",
          "children": [
            {
              "comment": "Base plate",
              "type": "cylinder",
              "params": { "r": 0.5, "h": 0.03 },
              "transform": { "translate": [0, 0.015, 0] }
            },
            {
              "comment": "Support rod",
              "type": "capsule",
              "params": { "r": 0.025, "h": 0.4 },
              "transform": { "translate": [0, 0.25, 0] }
            }
          ]
        }
      },

      {
        "comment": "=== TORSO ===",
        "type": "material",
        "params": { "color": { "var": "woodColor" } },
        "child": {
          "type": "smoothUnion",
          "k": 0.06,
          "children": [
            {
              "comment": "Chest - upper torso",
              "type": "ellipsoid",
              "params": { "radii": [0.14, 0.12, 0.09] },
              "transform": {
                "translate": [0, 1.15, 0],
                "rotate": [0, { "var": "torsoTwist" }, 0]
              }
            },
            {
              "comment": "Abdomen - mid section",
              "type": "ellipsoid",
              "params": { "radii": [0.10, 0.08, 0.07] },
              "transform": { "translate": [0, 0.95, 0] }
            },
            {
              "comment": "Pelvis",
              "type": "ellipsoid",
              "params": { "radii": [0.12, 0.08, 0.08] },
              "transform": { "translate": [0, 0.75, 0] }
            }
          ]
        }
      },

      {
        "comment": "=== NECK & HEAD ===",
        "type": "smoothUnion",
        "k": 0.04,
        "children": [
          {
            "comment": "Neck joint ball",
            "type": "material",
            "params": { "color": { "var": "jointColor" } },
            "child": {
              "type": "sphere",
              "params": { "r": 0.055 },
              "transform": { "translate": [0, 1.28, 0] }
            }
          },
          {
            "comment": "Neck cylinder",
            "type": "material",
            "params": { "color": { "var": "woodColor" } },
            "child": {
              "type": "capsule",
              "params": { "r": 0.04, "h": 0.06 },
              "transform": {
                "translate": [0, 1.35, 0],
                "rotate": [{ "var": "headNod" }, 0, { "var": "headTilt" }]
              }
            }
          },
          {
            "comment": "Head - ovoid",
            "type": "material",
            "params": { "color": { "var": "woodColor" } },
            "child": {
              "type": "ellipsoid",
              "params": { "radii": [0.08, 0.10, 0.08] },
              "transform": {
                "translate": [0, 1.52, 0],
                "rotate": [{ "var": "headNod" }, 0, { "var": "headTilt" }]
              }
            }
          }
        ]
      },

      {
        "comment": "=== ARMS (mirrored) ===",
        "type": "mirror",
        "axis": "x",
        "child": {
          "type": "smoothUnion",
          "k": 0.03,
          "children": [
            {
              "comment": "Shoulder joint ball",
              "type": "material",
              "params": { "color": { "var": "jointColor" } },
              "child": {
                "type": "sphere",
                "params": { "r": 0.055 },
                "transform": { "translate": [0.18, 1.15, 0] }
              }
            },
            {
              "comment": "Upper arm",
              "type": "material",
              "params": { "color": { "var": "woodColor" } },
              "child": {
                "type": "capsule",
                "params": {
                  "r": { "var": "limbThickness" },
                  "h": 0.12
                },
                "transform": {
                  "translate": [0.26, 1.02, 0],
                  "rotate": [
                    { "var": "shoulderRaise" },
                    0,
                    -80
                  ]
                }
              }
            },
            {
              "comment": "Elbow joint ball",
              "type": "material",
              "params": { "color": { "var": "jointColor" } },
              "child": {
                "type": "sphere",
                "params": { "r": 0.045 },
                "transform": { "translate": [0.35, 0.92, 0] }
              }
            },
            {
              "comment": "Forearm",
              "type": "material",
              "params": { "color": { "var": "woodColor" } },
              "child": {
                "type": "capsule",
                "params": {
                  "r": { "expr": "mul", "args": [{ "var": "limbThickness" }, 0.85] },
                  "h": 0.11
                },
                "transform": {
                  "translate": [0.42, 0.78, 0],
                  "rotate": [
                    { "expr": "add", "args": [{ "var": "shoulderRaise" }, { "var": "elbowBend" }] },
                    0,
                    -85
                  ]
                }
              }
            },
            {
              "comment": "Wrist ball",
              "type": "material",
              "params": { "color": { "var": "jointColor" } },
              "child": {
                "type": "sphere",
                "params": { "r": 0.032 },
                "transform": { "translate": [0.48, 0.65, 0] }
              }
            },
            {
              "comment": "Hand paddle",
              "type": "material",
              "params": { "color": { "var": "woodColor" } },
              "child": {
                "type": "ellipsoid",
                "params": { "radii": [0.025, 0.04, 0.015] },
                "transform": { "translate": [0.50, 0.58, 0] }
              }
            }
          ]
        }
      },

      {
        "comment": "=== LEGS (mirrored) ===",
        "type": "mirror",
        "axis": "x",
        "child": {
          "type": "smoothUnion",
          "k": 0.03,
          "children": [
            {
              "comment": "Hip joint ball",
              "type": "material",
              "params": { "color": { "var": "jointColor" } },
              "child": {
                "type": "sphere",
                "params": { "r": 0.055 },
                "transform": { "translate": [0.08, 0.70, 0] }
              }
            },
            {
              "comment": "Upper leg (thigh)",
              "type": "material",
              "params": { "color": { "var": "woodColor" } },
              "child": {
                "type": "capsule",
                "params": {
                  "r": { "expr": "mul", "args": [{ "var": "limbThickness" }, 1.1] },
                  "h": 0.14
                },
                "transform": {
                  "translate": [0.08, 0.52, 0],
                  "rotate": [{ "var": "hipAngle" }, 0, 0]
                }
              }
            },
            {
              "comment": "Knee joint ball",
              "type": "material",
              "params": { "color": { "var": "jointColor" } },
              "child": {
                "type": "sphere",
                "params": { "r": 0.048 },
                "transform": { "translate": [0.08, 0.38, 0] }
              }
            },
            {
              "comment": "Lower leg (shin)",
              "type": "material",
              "params": { "color": { "var": "woodColor" } },
              "child": {
                "type": "capsule",
                "params": {
                  "r": { "var": "limbThickness" },
                  "h": 0.12
                },
                "transform": {
                  "translate": [0.08, 0.22, 0],
                  "rotate": [
                    { "expr": "add", "args": [{ "var": "hipAngle" }, { "var": "kneeBend" }] },
                    0, 0
                  ]
                }
              }
            },
            {
              "comment": "Ankle joint ball",
              "type": "material",
              "params": { "color": { "var": "jointColor" } },
              "child": {
                "type": "sphere",
                "params": { "r": 0.035 },
                "transform": { "translate": [0.08, 0.08, 0] }
              }
            },
            {
              "comment": "Foot",
              "type": "material",
              "params": { "color": { "var": "woodColor" } },
              "child": {
                "type": "ellipsoid",
                "params": { "radii": [0.03, 0.02, 0.055] },
                "transform": { "translate": [0.08, 0.02, 0.02] }
              }
            }
          ]
        }
      }
    ]
  }
}
