{
  "title": "Parametric Demo",
  "subtitle": "Scene-level parameters for rigging",
  "version": "1.1",
  "notes": "Demonstrates scene params: adjust bodyRadius and armLength to see live changes. Parameters replace magic numbers with named values that expressions can reference.",
  "params": {
    "bodyRadius": { "value": 0.5, "type": "scalar", "min": 0.2, "max": 1.0 },
    "armLength": { "value": 0.6, "type": "scalar", "min": 0.2, "max": 1.2 },
    "bodyColor": { "value": [0.8, 0.4, 0.2], "type": "color3" }
  },
  "root": {
    "type": "smoothUnion",
    "k": 0.15,
    "children": [
      {
        "comment": "Body - uses bodyRadius param",
        "type": "sphere",
        "params": {
          "r": { "var": "bodyRadius" },
          "color": { "var": "bodyColor" }
        }
      },
      {
        "comment": "Head - derived from bodyRadius",
        "type": "sphere",
        "params": {
          "r": { "expr": "mul", "args": [{ "var": "bodyRadius" }, 0.6] },
          "color": { "var": "bodyColor" }
        },
        "transform": {
          "translate": [0, { "expr": "add", "args": [{ "var": "bodyRadius" }, 0.25] }, 0]
        }
      },
      {
        "comment": "Arms - capsules extending from body sides, uses armLength half-extent",
        "type": "mirror",
        "axis": "x",
        "child": {
          "type": "capsule",
          "params": {
            "h": { "expr": "mul", "args": [{ "var": "armLength" }, 0.5] },
            "r": { "expr": "mul", "args": [{ "var": "bodyRadius" }, 0.18] },
            "color": [0.65, 0.35, 0.15]
          },
          "transform": {
            "translate": [
              { "expr": "add", "args": [{ "var": "bodyRadius" }, { "var": "armLength" }] },
              { "expr": "mul", "args": [{ "var": "bodyRadius" }, -0.15] },
              0
            ],
            "rotate": [0, 0, 90]
          }
        }
      },
      {
        "comment": "Legs - short capsules below body",
        "type": "mirror",
        "axis": "x",
        "child": {
          "type": "capsule",
          "params": {
            "h": { "expr": "mul", "args": [{ "var": "bodyRadius" }, 0.6] },
            "r": { "expr": "mul", "args": [{ "var": "bodyRadius" }, 0.2] },
            "color": [0.55, 0.3, 0.12]
          },
          "transform": {
            "translate": [
              { "expr": "mul", "args": [{ "var": "bodyRadius" }, 0.4] },
              { "expr": "mul", "args": [{ "var": "bodyRadius" }, -1.4] },
              0
            ]
          }
        }
      }
    ]
  }
}
