{
  "title": "Parametric Demo",
  "subtitle": "Scene-level parameters for rigging",
  "version": "1.2",
  "notes": "Demonstrates scene params: adjust bodyRadius, armLength, and hatHeight to see live changes. Tests both mul and div expressions. If hatHeight slider doesn't change hat size, div expressions may be broken.",
  "params": {
    "bodyRadius": { "value": 0.5, "type": "scalar", "min": 0.2, "max": 1.0 },
    "armLength": { "value": 0.6, "type": "scalar", "min": 0.2, "max": 1.2 },
    "hatHeight": { "value": 0.4, "type": "scalar", "min": 0.1, "max": 0.8 },
    "bodyColor": { "value": [0.8, 0.4, 0.2], "type": "color3" }
  },
  "root": {
    "type": "smoothUnion",
    "k": 0.15,
    "children": [
      {
        "comment": "Body - uses bodyRadius param",
        "type": "sphere",
        "params": {
          "r": { "var": "bodyRadius" },
          "color": { "var": "bodyColor" }
        }
      },
      {
        "comment": "Head - derived from bodyRadius",
        "type": "sphere",
        "params": {
          "r": { "expr": "mul", "args": [{ "var": "bodyRadius" }, 0.6] },
          "color": { "var": "bodyColor" }
        },
        "transform": {
          "translate": [0, { "expr": "add", "args": [{ "var": "bodyRadius" }, 0.25] }, 0]
        }
      },
      {
        "comment": "Hat - tests div expression (hatHeight/2 for half-extent)",
        "type": "cylinder",
        "params": {
          "h": { "expr": "div", "args": [{ "var": "hatHeight" }, 2] },
          "r": { "expr": "mul", "args": [{ "var": "bodyRadius" }, 0.5] },
          "color": [0.2, 0.2, 0.6]
        },
        "transform": {
          "translate": [0, { "expr": "add", "args": [{ "var": "bodyRadius" }, 0.75] }, 0]
        }
      },
      {
        "comment": "Arms - capsules extending from body sides, uses armLength half-extent",
        "type": "mirror",
        "axis": "x",
        "child": {
          "type": "capsule",
          "params": {
            "h": { "expr": "mul", "args": [{ "var": "armLength" }, 0.5] },
            "r": { "expr": "mul", "args": [{ "var": "bodyRadius" }, 0.18] },
            "color": [0.65, 0.35, 0.15]
          },
          "transform": {
            "translate": [
              { "expr": "add", "args": [{ "var": "bodyRadius" }, { "var": "armLength" }] },
              { "expr": "mul", "args": [{ "var": "bodyRadius" }, -0.15] },
              0
            ],
            "rotate": [0, 0, 90]
          }
        }
      },
      {
        "comment": "Legs - short capsules below body",
        "type": "mirror",
        "axis": "x",
        "child": {
          "type": "capsule",
          "params": {
            "h": { "expr": "mul", "args": [{ "var": "bodyRadius" }, 0.6] },
            "r": { "expr": "mul", "args": [{ "var": "bodyRadius" }, 0.2] },
            "color": [0.55, 0.3, 0.12]
          },
          "transform": {
            "translate": [
              { "expr": "mul", "args": [{ "var": "bodyRadius" }, 0.4] },
              { "expr": "mul", "args": [{ "var": "bodyRadius" }, -1.4] },
              0
            ]
          }
        }
      }
    ]
  }
}
