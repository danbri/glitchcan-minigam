{
  "title": "Grouping & Hierarchy",
  "subtitle": "Nested transforms with groups",
  "version": "1.0",
  "notes": "GROUP node collects children and applies a shared transform. Unlike union (which combines SDFs), group is purely organizational. Transforms cascade: parent transform applies to all children. Use for logical hierarchy and shared positioning.",
  "defs": {
    "arm": {
      "type": "union",
      "children": [
        { "type": "sphere", "params": { "r": 0.15 } },
        { "type": "capsule", "params": { "h": 0.3, "r": 0.08 }, "transform": { "translate": [0, -0.25, 0] } },
        { "type": "sphere", "params": { "r": 0.1 }, "transform": { "translate": [0, -0.5, 0] } }
      ]
    }
  },
  "root": {
    "type": "group",
    "transform": { "translate": [0, 0.5, 0] },
    "children": [
      { "type": "sphere", "params": { "r": 0.4, "color": [0.8, 0.6, 0.4] } },
      { "type": "material", "params": { "color": [0.6, 0.8, 0.4] }, "child": { "type": "transform", "transform": { "translate": [-0.5, 0, 0], "rotate": [0, 0, -30] }, "child": { "type": "ref", "id": "arm" } } },
      { "type": "material", "params": { "color": [0.6, 0.8, 0.4] }, "child": { "type": "transform", "transform": { "translate": [0.5, 0, 0], "rotate": [0, 0, 30] }, "child": { "type": "ref", "id": "arm" } } },
      { "type": "sphere", "params": { "r": 0.25, "color": [0.9, 0.8, 0.7] }, "transform": { "translate": [0, 0.55, 0] } }
    ]
  }
}
