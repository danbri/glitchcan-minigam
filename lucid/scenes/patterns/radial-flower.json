{
  "title": "Radial Flower",
  "subtitle": "12 petals from one sphere (O(1) cost!)",
  "version": "1.0",
  "root": {
    "type": "union",
    "children": [
      {
        "type": "sphere",
        "params": { "r": 0.4, "color": [1.0, 0.8, 0.2] }
      },
      {
        "type": "radial",
        "count": 12,
        "axis": "y",
        "child": {
          "type": "sphere",
          "params": { "r": 0.25, "color": [1.0, 0.4, 0.6] },
          "transform": { "translate": [0.7, 0, 0] }
        }
      }
    ]
  }
}
