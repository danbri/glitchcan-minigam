{
  "title": "Infinite Field",
  "subtitle": "Tiled spheres extending to infinity",
  "version": "1.1",

  "params": {
    "spacing": {
      "value": 3.0,
      "type": "scalar",
      "min": 1.5,
      "max": 6.0,
      "description": "Distance between spheres"
    },
    "baseRadius": {
      "value": 0.4,
      "type": "scalar",
      "min": 0.2,
      "max": 1.0,
      "description": "Base sphere radius"
    },
    "sphereColor": {
      "value": [0.6, 0.9, 0.4],
      "type": "color3",
      "description": "Sphere color"
    }
  },

  "root": {
    "type": "repeat",
    "period": [{"var": "spacing"}, 0, {"var": "spacing"}],
    "child": {
      "type": "sphere",
      "params": {
        "r": {
          "expr": "add",
          "args": [{"var": "baseRadius"}, { "expr": "mul", "args": [0.1, { "expr": "sin", "args": [{ "var": "time" }] }] }]
        },
        "color": {"var": "sphereColor"}
      }
    }
  }
}
