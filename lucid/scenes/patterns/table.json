{
  "title": "Cylinder Array",
  "subtitle": "Simple table with 4 legs",
  "camera": {
    "distance": 7,
    "phi": 1.1,
    "theta": 0.5,
    "target": [0, 1, 0]
  },
  "version": "1.1",
  "notes": "A simple table demonstrating defs/ref templating. Use 'defs' to define reusable shapes, then 'ref' to instantiate them. Each ref can have its own transform and material wrapper. Pattern: material > transform > ref.",

  "params": {
    "pillarHeight": {
      "value": 2.0,
      "type": "scalar",
      "min": 1.0,
      "max": 3.5,
      "description": "Pillar height"
    },
    "pillarRadius": {
      "value": 0.2,
      "type": "scalar",
      "min": 0.1,
      "max": 0.4,
      "description": "Pillar thickness"
    },
    "pillarColor": {
      "value": [0.8, 0.6, 0.4],
      "type": "color3",
      "description": "Pillar color"
    }
  },

  "defs": {
    "pillar": {
      "type": "cylinder",
      "params": { "h": {"var": "pillarHeight"}, "r": {"var": "pillarRadius"} }
    }
  },
  "root": {
    "type": "union",
    "children": [
      { "type": "material", "params": { "color": {"var": "pillarColor"} }, "child": { "type": "transform", "transform": { "translate": [-1.5, 0.0, -1.5] }, "child": { "type": "ref", "id": "pillar" } } },
      { "type": "material", "params": { "color": {"var": "pillarColor"} }, "child": { "type": "transform", "transform": { "translate": [1.5, 0.0, -1.5] }, "child": { "type": "ref", "id": "pillar" } } },
      { "type": "material", "params": { "color": {"var": "pillarColor"} }, "child": { "type": "transform", "transform": { "translate": [-1.5, 0.0, 1.5] }, "child": { "type": "ref", "id": "pillar" } } },
      { "type": "material", "params": { "color": {"var": "pillarColor"} }, "child": { "type": "transform", "transform": { "translate": [1.5, 0.0, 1.5] }, "child": { "type": "ref", "id": "pillar" } } },
      {
        "type": "box",
        "params": { "size": [2.0, 0.1, 2.0], "color": [0.5, 0.5, 0.6] },
        "transform": { "translate": [0.0, 2.0, 0.0] }
      }
    ]
  }
}
