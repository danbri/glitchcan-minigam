{
  "title": "Conic Sections",
  "subtitle": "Slice a cone to reveal circles, ellipses, parabolas, and hyperbolas",
  "version": "1.3",
  "notes": "Educational demo inspired by science museum laser cut exhibits. Adjust the cutting angle to see different conic sections emerge.",

  "camera": {
    "distance": 5,
    "phi": 0.5,
    "theta": 0.4,
    "target": [0, 0.3, 0]
  },

  "params": {
    "cutAngle": {
      "value": 15,
      "type": "scalar",
      "min": 0,
      "max": 55,
      "description": "Cutting angle: 0°=circle, 15°=ellipse, 27°=parabola, 40°+=hyperbola"
    },
    "cutHeight": {
      "value": 0.6,
      "type": "scalar",
      "min": -0.5,
      "max": 1.5,
      "description": "Cut position along cone"
    }
  },

  "defs": {
    "outerCone": {
      "comment": "Outer green cone - sharp tip using sdCone (h, r only)",
      "type": "cone",
      "params": {
        "h": 2.0,
        "r": 1.0,
        "color": [0.25, 0.65, 0.35]
      }
    },

    "innerCone": {
      "comment": "Inner brown cone at 96% - sharp tip",
      "type": "cone",
      "params": {
        "h": 1.92,
        "r": 0.96,
        "color": [0.65, 0.45, 0.25]
      }
    },

    "doubleConeOuter": {
      "comment": "Double cone - outer green",
      "type": "union",
      "children": [
        { "type": "ref", "id": "outerCone" },
        { "type": "ref", "id": "outerCone", "transform": { "rotate": [180, 0, 0] } }
      ]
    },

    "doubleConeInner": {
      "comment": "Double cone - inner brown",
      "type": "union",
      "children": [
        { "type": "ref", "id": "innerCone" },
        { "type": "ref", "id": "innerCone", "transform": { "rotate": [180, 0, 0] } }
      ]
    },

    "nestedCones": {
      "comment": "Green outer + brown inner",
      "type": "union",
      "children": [
        { "type": "ref", "id": "doubleConeOuter" },
        { "type": "ref", "id": "doubleConeInner" }
      ]
    },

    "cutter": {
      "comment": "Invisible half-space cutter",
      "type": "plane",
      "params": {
        "normal": [0, 1, 0],
        "h": 0,
        "color": [0.5, 0.5, 0.5]
      }
    }
  },

  "root": {
    "comment": "Subtract cutter from nested cones",
    "type": "subtract",
    "children": [
      { "type": "ref", "id": "nestedCones" },
      {
        "type": "ref",
        "id": "cutter",
        "transform": {
          "translate": [0, { "var": "cutHeight" }, 0],
          "rotate": [{ "var": "cutAngle" }, 0, 0]
        }
      }
    ]
  }
}
