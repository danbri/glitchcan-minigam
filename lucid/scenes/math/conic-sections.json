{
  "title": "Conic Sections",
  "subtitle": "Slice a cone to reveal circles, ellipses, parabolas, and hyperbolas",
  "version": "1.1",
  "notes": "Educational demo inspired by science museum laser cut exhibits. Nested cones (green outer, brown inner at 96%) reveal cross-section when cut. Circle (0°), Ellipse (~15°), Parabola (~27°), Hyperbola (>30°).",

  "camera": {
    "distance": 6,
    "phi": 0.4,
    "theta": 0.3,
    "target": [0, 0, 0]
  },

  "params": {
    "_cutting": "=== CUTTING PLANE ===",
    "cutAngle": {
      "value": 15,
      "type": "scalar",
      "min": 0,
      "max": 60,
      "description": "Cutting plane angle (degrees from horizontal). 0=circle, ~15=ellipse, ~27=parabola, >30=hyperbola"
    },
    "cutPosition": {
      "value": 0.8,
      "type": "scalar",
      "min": -1.5,
      "max": 2.0,
      "description": "Height of cutting plane center"
    },

    "_cone": "=== CONE GEOMETRY ===",
    "coneHeight": {
      "value": 2.0,
      "type": "scalar",
      "min": 1.0,
      "max": 3.0,
      "description": "Height of each cone nappe"
    },
    "coneRadius": {
      "value": 1.0,
      "type": "scalar",
      "min": 0.5,
      "max": 1.5,
      "description": "Base radius of cone"
    },

    "_appearance": "=== COLORS ===",
    "outerColor": {
      "value": [0.2, 0.7, 0.3],
      "type": "color3",
      "description": "Outer cone color (green)"
    },
    "innerColor": {
      "value": [0.6, 0.4, 0.2],
      "type": "color3",
      "description": "Inner cone / cross-section color (brown)"
    }
  },

  "defs": {
    "outerCone": {
      "comment": "Outer green cone - single nappe",
      "type": "cone",
      "params": {
        "h": { "var": "coneHeight" },
        "r1": 0.01,
        "r2": { "var": "coneRadius" },
        "color": { "var": "outerColor" }
      }
    },

    "innerCone": {
      "comment": "Inner brown cone at 96% size - reveals cross-section",
      "type": "cone",
      "params": {
        "h": { "expr": "mul", "args": [{ "var": "coneHeight" }, 0.96] },
        "r1": 0.01,
        "r2": { "expr": "mul", "args": [{ "var": "coneRadius" }, 0.96] },
        "color": { "var": "innerColor" }
      }
    },

    "doubleConeOuter": {
      "comment": "Double cone (bicone) - outer green",
      "type": "union",
      "children": [
        {
          "type": "ref",
          "id": "outerCone"
        },
        {
          "type": "ref",
          "id": "outerCone",
          "transform": { "rotate": [180, 0, 0] }
        }
      ]
    },

    "doubleConeInner": {
      "comment": "Double cone (bicone) - inner brown at 96%",
      "type": "union",
      "children": [
        {
          "type": "ref",
          "id": "innerCone"
        },
        {
          "type": "ref",
          "id": "innerCone",
          "transform": { "rotate": [180, 0, 0] }
        }
      ]
    },

    "nestedCones": {
      "comment": "Green outer + brown inner nested cones",
      "type": "union",
      "children": [
        { "type": "ref", "id": "doubleConeOuter" },
        { "type": "ref", "id": "doubleConeInner" }
      ]
    },

    "cutter": {
      "comment": "Invisible half-space cutter",
      "type": "plane",
      "params": {
        "normal": [0, 1, 0],
        "h": 0,
        "color": [0.5, 0.5, 0.5]
      }
    }
  },

  "root": {
    "comment": "Subtract the cutter from nested cones to reveal cross-section",
    "type": "subtract",
    "children": [
      {
        "type": "ref",
        "id": "nestedCones"
      },
      {
        "comment": "Cutting plane - positioned and rotated",
        "type": "ref",
        "id": "cutter",
        "transform": {
          "translate": [0, { "var": "cutPosition" }, 0],
          "rotate": [{ "var": "cutAngle" }, 0, 0]
        }
      }
    ]
  }
}
