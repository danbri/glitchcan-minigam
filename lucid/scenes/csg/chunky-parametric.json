{
  "title": "Chunky Parametric",
  "subtitle": "One quadruped template, 6 distinct animals via param inheritance",
  "version": "2.0",
  "author": "LCD-002",
  "description": "OOP-style parameterized instancing - global params affect all, instance params per-animal",
  "camera": { "distance": 14, "phi": 0.35, "theta": 0.15, "target": [0, 0, 0] },

  "params": {
    "smoothness": { "value": 0.15, "min": 0.05, "max": 0.5, "label": "Blobiness" },
    "globalScale": { "value": 1.0, "min": 0.3, "max": 2.0, "label": "Size" },
    "fatness": { "value": 1.0, "min": 0.5, "max": 1.8, "label": "Fatness" },
    "legLength": { "value": 1.0, "min": 0.4, "max": 1.6, "label": "Leg Length" },
    "earSize": { "value": 1.0, "min": 0.3, "max": 2.0, "label": "Ear Size" },
    "tailWag": { "value": 0.0, "min": -1.0, "max": 1.0, "label": "Tail Angle" }
  },

  "defs": {
    "quadruped": {
      "comment": "Generic quadruped - instance params override, global params multiply",
      "type": "transform",
      "transform": { "scale": { "var": "globalScale" } },
      "child": {
        "type": "material",
        "params": { "color": { "var": "color" } },
        "child": {
          "type": "smoothUnion", "k": { "var": "smoothness" },
          "children": [
            {
              "comment": "Main body",
              "type": "ellipsoid",
              "params": { "radii": { "var": "bodyRadii" } }
            },
            {
              "comment": "Rump/hindquarters",
              "type": "ellipsoid",
              "params": { "radii": { "var": "rumpRadii" } },
              "transform": { "translate": { "var": "rumpPos" } }
            },
            {
              "comment": "Head",
              "type": "ellipsoid",
              "params": { "radii": { "var": "headRadii" } },
              "transform": { "translate": { "var": "headPos" } }
            },
            {
              "comment": "Snout/muzzle",
              "type": "ellipsoid",
              "params": { "radii": { "var": "snoutRadii" } },
              "transform": { "translate": { "var": "snoutPos" } }
            },
            {
              "comment": "Nose tip",
              "type": "sphere",
              "params": { "r": { "var": "noseSize" } },
              "transform": { "translate": { "var": "nosePos" } }
            },
            {
              "comment": "Ears (mirrored)",
              "type": "mirror", "axis": "x",
              "child": {
                "type": "ellipsoid",
                "params": { "radii": { "var": "earRadii" } },
                "transform": {
                  "translate": { "var": "earPos" },
                  "rotate": { "var": "earRotate" }
                }
              }
            },
            {
              "comment": "Front legs (mirrored)",
              "type": "mirror", "axis": "x",
              "child": {
                "type": "roundCone",
                "params": {
                  "r1": { "var": "legThighRadius" },
                  "r2": { "var": "legAnkleRadius" },
                  "h": { "var": "frontLegHeight" }
                },
                "transform": {
                  "translate": { "var": "frontLegPos" },
                  "rotate": { "var": "frontLegRotate" }
                }
              }
            },
            {
              "comment": "Back legs (mirrored)",
              "type": "mirror", "axis": "x",
              "child": {
                "type": "roundCone",
                "params": {
                  "r1": { "var": "legThighRadius" },
                  "r2": { "var": "legAnkleRadius" },
                  "h": { "var": "backLegHeight" }
                },
                "transform": {
                  "translate": { "var": "backLegPos" },
                  "rotate": { "var": "backLegRotate" }
                }
              }
            },
            {
              "comment": "Tail",
              "type": "capsule",
              "params": { "h": { "var": "tailLength" }, "r": { "var": "tailRadius" } },
              "transform": {
                "translate": { "var": "tailPos" },
                "rotate": { "var": "tailRotate" }
              }
            }
          ]
        }
      }
    }
  },

