{
  "title": "Smooth Union",
  "subtitle": "Two spheres with smooth blending",
  "version": "1.0",
  "notes": "CSG ops combine shapes: union (add), subtract (cut), intersect (common). Smooth variants (smoothUnion, smoothSubtract, smoothIntersect) use 'k' param to control blend radius. Higher k = more blending.",
  "root": {
    "type": "smoothUnion",
    "k": 0.5,
    "children": [
      {
        "type": "sphere",
        "params": { "r": 0.8, "color": [1, 0.7, 0.2] },
        "transform": {
          "translate": [
            { "expr": "mul", "args": [{ "expr": "sin", "args": [{ "var": "time" }] }, 1.7] },
            0.7,
            0.5
          ]
        }
      },
      {
        "type": "sphere",
        "params": { "r": 0.8, "color": [0.5, 0.2, 1] },
        "transform": {
          "translate": [
            { "expr": "mul", "args": [{ "expr": "sin", "args": [{ "var": "time" }] }, -0.5] },
            -0.3,
            0
          ]
        }
      }
    ]
  }
}
