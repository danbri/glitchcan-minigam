{
  "title": "Chunky Animals",
  "subtitle": "Parametric instancing: hippo, bear, pig variants",
  "version": "1.1",
  "author": "LCD-002",
  "description": "Three chunky quadrupeds with shared structure, different proportions and colors",
  "camera": { "distance": 10, "phi": 0.3, "theta": 0.2, "target": [0, 0, 0] },

  "params": {
    "smoothness": { "value": 0.2, "min": 0.05, "max": 0.4, "description": "Body smoothness" },
    "spacing": { "value": 3.5, "min": 2, "max": 6, "description": "Distance between animals" }
  },

  "defs": {
    "hippo": {
      "comment": "Gray-purple hippo - barrel body, wide snout",
      "type": "material",
      "params": { "color": [0.45, 0.38, 0.42] },
      "child": {
        "type": "smoothUnion", "k": { "var": "smoothness" },
        "children": [
          { "type": "ellipsoid", "params": { "radii": [1.1, 0.7, 1.0] } },
          { "type": "ellipsoid", "params": { "radii": [0.45, 0.4, 0.5] }, "transform": { "translate": [0, 0.1, 1.3] } },
          { "type": "ellipsoid", "params": { "radii": [0.38, 0.28, 0.35] }, "transform": { "translate": [0, -0.1, 1.75] } },
          { "type": "mirror", "axis": "x", "child": {
            "type": "ellipsoid", "params": { "radii": [0.08, 0.12, 0.08] }, "transform": { "translate": [0.25, 0.45, 1.2] }
          }},
          { "type": "mirror", "axis": "x", "child": {
            "type": "capsule", "params": { "h": 0.4, "r": 0.2 }, "transform": { "translate": [0.55, -0.65, 0.5] }
          }},
          { "type": "mirror", "axis": "x", "child": {
            "type": "capsule", "params": { "h": 0.4, "r": 0.2 }, "transform": { "translate": [0.55, -0.65, -0.5] }
          }}
        ]
      }
    },
    "bear": {
      "comment": "Brown bear - stockier, round ears",
      "type": "material",
      "params": { "color": [0.35, 0.22, 0.12] },
      "child": {
        "type": "smoothUnion", "k": { "var": "smoothness" },
        "children": [
          { "type": "ellipsoid", "params": { "radii": [1.0, 0.8, 0.9] } },
          { "type": "ellipsoid", "params": { "radii": [0.4, 0.38, 0.4] }, "transform": { "translate": [0, 0.25, 1.2] } },
          { "type": "ellipsoid", "params": { "radii": [0.2, 0.18, 0.25] }, "transform": { "translate": [0, 0.1, 1.55] } },
          { "type": "mirror", "axis": "x", "child": {
            "type": "sphere", "params": { "r": 0.12 }, "transform": { "translate": [0.28, 0.55, 1.0] }
          }},
          { "type": "mirror", "axis": "x", "child": {
            "type": "capsule", "params": { "h": 0.5, "r": 0.22 }, "transform": { "translate": [0.5, -0.65, 0.5] }
          }},
          { "type": "mirror", "axis": "x", "child": {
            "type": "capsule", "params": { "h": 0.5, "r": 0.22 }, "transform": { "translate": [0.5, -0.65, -0.5] }
          }}
        ]
      }
    },
    "pig": {
      "comment": "Pink pig - longer snout, floppy ears",
      "type": "material",
      "params": { "color": [0.9, 0.65, 0.6] },
      "child": {
        "type": "smoothUnion", "k": { "var": "smoothness" },
        "children": [
          { "type": "ellipsoid", "params": { "radii": [0.8, 0.6, 1.0] } },
          { "type": "ellipsoid", "params": { "radii": [0.35, 0.32, 0.35] }, "transform": { "translate": [0, 0.05, 1.25] } },
          { "type": "ellipsoid", "params": { "radii": [0.18, 0.14, 0.25] }, "transform": { "translate": [0, -0.05, 1.6] } },
          { "type": "mirror", "axis": "x", "child": {
            "type": "ellipsoid", "params": { "radii": [0.15, 0.2, 0.08] }, "transform": { "translate": [0.2, 0.35, 1.1], "rotate": [0, 0, -20] }
          }},
          { "type": "mirror", "axis": "x", "child": {
            "type": "capsule", "params": { "h": 0.35, "r": 0.12 }, "transform": { "translate": [0.4, -0.55, 0.5] }
          }},
          { "type": "mirror", "axis": "x", "child": {
            "type": "capsule", "params": { "h": 0.35, "r": 0.12 }, "transform": { "translate": [0.45, -0.55, -0.5] }
          }}
        ]
      }
    }
  },

  "root": {
    "type": "union",
    "children": [
      { "type": "ref", "id": "hippo" },
      {
        "type": "transform",
        "transform": { "translate": [{ "var": "spacing" }, 0, 0] },
        "child": { "type": "ref", "id": "bear" }
      },
      {
        "type": "transform",
        "transform": { "translate": [{ "expr": "mul", "args": [{ "var": "spacing" }, -1] }, 0, 0] },
        "child": { "type": "ref", "id": "pig" }
      }
    ]
  }
}
