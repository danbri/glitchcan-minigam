{
  "version": "1.0",
  "name": "Ref Parameter Overrides Demo",
  "author": "LCD-002",
  "description": "Demonstrates parametric instancing with refs and overrides",
  "camera": { "distance": 8, "phi": 0.4, "theta": 0.3, "target": [0, 0.5, 0] },
  "params": {
    "baseRadius": { "value": 0.3, "min": 0.1, "max": 1.0 },
    "spacing": { "value": 1.5, "min": 0.5, "max": 3.0 }
  },
  "defs": {
    "baseSphere": {
      "type": "sphere",
      "params": {
        "r": { "var": "baseRadius" },
        "color": [0.2, 0.6, 1.0]
      }
    }
  },
  "root": {
    "type": "union",
    "children": [
      {
        "type": "ref",
        "id": "baseSphere",
        "comment": "Original size"
      },
      {
        "type": "ref",
        "id": "baseSphere",
        "params": { "r": 0.5, "color": [1.0, 0.4, 0.2] },
        "transform": { "translate": [{ "var": "spacing" }, 0, 0] },
        "comment": "Larger, orange override"
      },
      {
        "type": "ref",
        "id": "baseSphere",
        "params": { "r": 0.15, "color": [0.2, 1.0, 0.4] },
        "transform": { "translate": [{ "expr": "mul", "args": [-1, { "var": "spacing" }] }, 0, 0] },
        "comment": "Smaller, green override"
      },
      {
        "type": "ref",
        "id": "baseSphere",
        "params": { "r": 0.4 },
        "transform": { "translate": [0, { "var": "spacing" }, 0] },
        "comment": "Medium, keeps original color"
      }
    ]
  }
}
