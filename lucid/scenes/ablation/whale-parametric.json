{
  "title": "Parametric Humpback Whale",
  "subtitle": "v2.0 - With rig layer for constraints and animation",
  "version": "2.0",
  "camera": { "distance": 42, "phi": 0.35, "theta": 0.3, "target": [0, 0, 0] },
  "notes": "Key proportions extracted as named params with rig layer for derived values, bounds checking, and phase-coupled animation. flipperRatio should be ~0.31 (31% body length) for humpback identification.",
  "params": {
    "bodyLength": { "value": 12.0, "type": "scalar", "min": 8, "max": 16 },
    "bodyRadius": { "value": 1.8, "type": "scalar", "min": 1.0, "max": 3.0 },
    "flipperRatio": { "value": 0.31, "type": "scalar", "min": 0.2, "max": 0.45 },
    "flukeSpan": { "value": 4.0, "type": "scalar", "min": 2.0, "max": 6.0 },
    "tubercleAmount": { "value": 0.35, "type": "scalar", "min": 0.1, "max": 0.5 },
    "bodyColor": { "value": [0.15, 0.17, 0.22], "type": "color3" },
    "ventralColor": { "value": [0.85, 0.88, 0.92], "type": "color3" },
    "swimSpeed": { "value": 1.0, "type": "scalar", "min": 0.0, "max": 3.0 }
  },
  "rig": {
    "derived": {
      "flipperLength": {
        "expr": "mul",
        "args": [{ "var": "bodyLength" }, { "var": "flipperRatio" }]
      },
      "headLength": {
        "expr": "mul",
        "args": [{ "var": "bodyLength" }, 0.22]
      },
      "bodyAspect": {
        "expr": "div",
        "args": [
          { "expr": "mul", "args": [{ "var": "bodyRadius" }, 0.86] },
          { "var": "bodyRadius" }
        ]
      },
      "flukeRatio": {
        "expr": "div",
        "args": [{ "var": "flukeSpan" }, { "var": "bodyLength" }]
      }
    },
    "bounds": {
      "flipperRatio": {
        "min": 0.25,
        "max": 0.35,
        "reason": "Humpback pectoral fins are uniquely long: 25-35% of body length"
      },
      "flukeRatio": {
        "min": 0.2,
        "max": 0.4,
        "reason": "Fluke span should be 20-40% of body length for cetaceans"
      },
      "tubercleAmount": {
        "min": 0.2,
        "max": 0.45,
        "reason": "Tubercles are a key humpback identifier - too low loses species ID"
      }
    },
    "phase": {
      "swimCycle": {
        "driver": { "expr": "mul", "args": [{ "var": "time" }, { "var": "swimSpeed" }] },
        "followers": {
          "flukeAngle": { "amplitude": 15, "phase": 0.0, "offset": 0 },
          "peduncleAngle": { "amplitude": 8, "phase": -0.15, "offset": 0 },
          "bodyUndulation": { "amplitude": 3, "phase": -0.3, "offset": 0 }
        }
      }
    },
    "chains": {
      "spine": {
        "joints": ["head", "torso", "peduncle", "flukes"],
        "type": "sequential",
        "constraints": { "maxBend": 15 }
      }
    }
  },
  "root": {
    "comment": "ALL BODY PARTS - blended together with smoothUnion",
    "type": "smoothUnion", "k": 0.5,
    "children": [
      {
        "comment": "MAIN BODY - smooth torso + displaced head",
        "type": "material",
        "params": { "color": { "var": "bodyColor" } },
        "child": {
          "type": "union",
          "children": [
            {
              "comment": "Smooth torso and tail section",
              "type": "smoothUnion", "k": 0.9,
              "children": [
                {
                  "type": "ellipsoid",
                  "params": {
                    "radii": [
                      { "var": "bodyRadius" },
                      { "expr": "mul", "args": [{ "var": "bodyRadius" }, 0.86] },
                      { "expr": "div", "args": [{ "var": "bodyLength" }, 2] }
                    ]
                  },
                  "transform": { "translate": [0, 0, 0] }
                },
                {
                  "type": "ellipsoid",
                  "params": {
                    "radii": [
                      { "expr": "mul", "args": [{ "var": "bodyRadius" }, 0.8] },
                      { "expr": "mul", "args": [{ "var": "bodyRadius" }, 0.69] },
                      3.2
                    ]
                  },
                  "transform": { "translate": [0, -0.1, -5.5] }
                },
                {
                  "type": "ellipsoid",
                  "params": {
                    "radii": [
                      { "expr": "mul", "args": [{ "var": "bodyRadius" }, 0.36] },
                      { "expr": "mul", "args": [{ "var": "bodyRadius" }, 0.33] },
                      3.0
                    ]
                  },
                  "transform": { "translate": [0, -0.15, -8.5] }
                }
              ]
            },
            {
              "comment": "HEAD with tubercle bumps - uses tubercleAmount param",
              "type": "displace",
              "amount": { "var": "tubercleAmount" },
              "scale": 1.8,
              "octaves": 2,
              "noiseType": "fbm",
              "child": {
                "type": "smoothUnion", "k": 0.5,
                "children": [
                  {
                    "type": "ellipsoid",
                    "params": {
                      "radii": [
                        { "expr": "mul", "args": [{ "var": "bodyRadius" }, 0.92] },
                        { "expr": "mul", "args": [{ "var": "bodyRadius" }, 0.64] },
                        2.8
                      ]
                    },
                    "transform": { "translate": [0, 0.12, 6.5] }
                  },
                  {
                    "type": "ellipsoid",
                    "params": {
                      "radii": [
                        { "expr": "mul", "args": [{ "var": "bodyRadius" }, 0.61] },
                        { "expr": "mul", "args": [{ "var": "bodyRadius" }, 0.39] },
                        2.5
                      ]
                    },
                    "transform": { "translate": [0, 0.02, 9.5] }
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "comment": "TAIL FLUKES - uses flukeSpan param",
        "type": "material",
        "params": { "color": [0.12, 0.14, 0.18] },
        "child": {
          "type": "smoothUnion", "k": 0.6,
          "children": [
            {
              "type": "ellipsoid",
              "params": { "radii": [0.55, 0.45, 2.0] },
              "transform": { "translate": [0, -0.1, -10.5] }
            },
            {
              "type": "subtract",
              "children": [
                {
                  "type": "mirror", "axis": "x",
                  "child": {
                    "type": "ellipsoid",
                    "params": {
                      "radii": [
                        { "var": "flukeSpan" },
                        0.28,
                        1.2
                      ]
                    },
                    "transform": {
                      "translate": [
                        { "expr": "div", "args": [{ "var": "flukeSpan" }, 2] },
                        0,
                        -11.8
                      ],
                      "rotate": [0, 22, 10]
                    }
                  }
                },
                {
                  "type": "ellipsoid",
                  "params": { "radii": [0.55, 0.45, 0.80] },
                  "transform": { "translate": [0, 0, -12.5] }
                }
              ]
            }
          ]
        }
      },
      {
        "comment": "PECTORAL FLIPPERS - uses flipperRatio * bodyLength",
        "type": "material",
        "params": { "color": [0.18, 0.20, 0.24] },
        "child": {
          "type": "mirror", "axis": "x",
          "child": {
            "type": "smoothUnion", "k": 0.35,
            "children": [
              {
                "type": "ellipsoid",
                "params": { "radii": [0.65, 0.44, 0.95] },
                "transform": { "translate": [1.8, -0.5, 2.0], "rotate": [5, 0, -25] }
              },
              {
                "type": "ellipsoid",
                "params": { "radii": [0.90, 0.38, 1.20] },
                "transform": { "translate": [2.9, -0.72, 0.9], "rotate": [8, -8, -30] }
              },
              {
                "type": "ellipsoid",
                "params": { "radii": [0.80, 0.32, 1.25] },
                "transform": { "translate": [4.0, -0.95, -0.3], "rotate": [10, -15, -35] }
              },
              {
                "type": "ellipsoid",
                "params": { "radii": [0.65, 0.26, 1.15] },
                "transform": { "translate": [4.9, -1.15, -1.7], "rotate": [12, -20, -38] }
              },
              {
                "type": "ellipsoid",
                "params": { "radii": [0.50, 0.20, 1.0] },
                "transform": { "translate": [5.6, -1.32, -3.0], "rotate": [14, -25, -40] }
              },
              {
                "type": "ellipsoid",
                "params": {
                  "radii": [0.35, 0.14, 0.80]
                },
                "transform": {
                  "translate": [
                    { "expr": "mul", "args": [{ "var": "flipperRatio" }, { "var": "bodyLength" }] },
                    -1.45,
                    -4.0
                  ],
                  "rotate": [16, -28, -42]
                }
              }
            ]
          }
        }
      },
      {
        "comment": "DORSAL FIN",
        "type": "material",
        "params": { "color": [0.18, 0.20, 0.24] },
        "child": {
          "type": "ellipsoid",
          "params": { "radii": [0.28, 0.50, 0.50] },
          "transform": { "translate": [0, 1.35, -4.0] }
        }
      },
      {
        "comment": "VENTRAL - uses ventralColor param",
        "type": "material",
        "params": { "color": { "var": "ventralColor" } },
        "child": {
          "type": "smoothSubtract", "k": 0.12,
          "children": [
            {
              "type": "smoothUnion", "k": 0.5,
              "children": [
                {
                  "type": "ellipsoid",
                  "params": {
                    "radii": [
                      { "expr": "mul", "args": [{ "var": "bodyRadius" }, 0.8] },
                      0.6,
                      5.0
                    ]
                  },
                  "transform": { "translate": [0, -1.0, 0.5] }
                },
                {
                  "type": "ellipsoid",
                  "params": {
                    "radii": [
                      { "expr": "mul", "args": [{ "var": "bodyRadius" }, 0.61] },
                      0.5,
                      3.0
                    ]
                  },
                  "transform": { "translate": [0, -0.75, 6.0] }
                }
              ]
            },
            {
              "comment": "Throat pleats",
              "type": "smoothUnion", "k": 0.06,
              "children": [
                { "type": "ellipsoid", "params": { "radii": [0.06, 0.12, 4.0] }, "transform": { "translate": [0.0, -1.0, 2.5] } },
                { "type": "ellipsoid", "params": { "radii": [0.06, 0.11, 3.8] }, "transform": { "translate": [0.20, -0.95, 2.7] } },
                { "type": "ellipsoid", "params": { "radii": [0.06, 0.11, 3.8] }, "transform": { "translate": [-0.20, -0.95, 2.7] } },
                { "type": "ellipsoid", "params": { "radii": [0.06, 0.10, 3.5] }, "transform": { "translate": [0.38, -0.88, 2.9] } },
                { "type": "ellipsoid", "params": { "radii": [0.06, 0.10, 3.5] }, "transform": { "translate": [-0.38, -0.88, 2.9] } }
              ]
            }
          ]
        }
      }
    ]
  }
}
