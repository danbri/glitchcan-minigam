{
  "title": "Poppy Field",
  "subtitle": "Rotated disk faces with centralized head angle (static)",
  "version": "1.1",
  "notes": "Animation disabled - was causing issues with repeat+radial combination",
  "defs": {
    "poppy_head": {
      "type": "union",
      "comment": "Head angle is defined ONCE here - rotate X by 75 to tilt disk face",
      "children": [
        {
          "type": "cylinder",
          "params": { "h": 0.02, "r": 0.15, "color": [0.35, 0.2, 0.1] },
          "transform": { "rotate": [75, 0, 0] }
        },
        {
          "type": "radial",
          "count": 8,
          "axis": "z",
          "child": {
            "type": "sphere",
            "params": { "r": 0.12, "color": [0.9, 0.15, 0.1] },
            "transform": { "translate": [0.18, 0, 0], "rotate": [75, 0, 0] }
          }
        }
      ],
      "transform": { "translate": [0, 0.8, 0] }
    },
    "stem": {
      "type": "cylinder",
      "params": { "h": 0.8, "r": 0.03, "color": [0.2, 0.5, 0.15] }
    },
    "poppy": {
      "type": "union",
      "children": [
        { "type": "ref", "id": "stem" },
        { "type": "ref", "id": "poppy_head" }
      ]
    }
  },
  "root": {
    "type": "repeat",
    "period": [1.8, 0, 1.8],
    "child": { "type": "ref", "id": "poppy" }
  }
}
