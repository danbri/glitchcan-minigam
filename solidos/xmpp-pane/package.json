{
  "name": "xmpp-pane",
  "version": "0.1.0",
  "description": "Solid-compatible Pane: XMPP chat with the people in your Solid profile (Strophe.js demo)",
  "type": "module",
  "main": "dist/index.cjs.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.cjs.js"
    }
  },
  "files": [
    "dist/",
    "proxy/*.mjs",
    "README.md"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run typecheck && npm run clean && vite build",
    "watch": "vite build --watch",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "vite",
    "proxy": "node proxy/server.mjs",
    "mock-server": "node proxy/mock-server.mjs",
    "demo": "concurrently -k -n mock,proxy,pane \"npm run mock-server\" \"XMPP_TLS_INSECURE=1 npm run proxy\" \"npm start\""
  },
  "keywords": ["solid", "xmpp", "jabber", "strophe", "chat", "pane", "foaf"],
  "license": "MIT",
  "dependencies": {
    "strophe.js": "^5.0.0"
  },
  "peerDependencies": {
    "pane-registry": "^5.0.1",
    "rdflib": "^2.4.1",
    "solid-logic": "^6.0.0",
    "solid-ui": "^5.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "@typescript-eslint/parser": "^8.53.1",
    "@xmpp/xml": "^0.14.0",
    "concurrently": "^9.2.0",
    "eslint": "^9.39.2",
    "globals": "^17.1.0",
    "jsdom": "^29.1.1",
    "ltx": "^3.1.2",
    "neostandard": "^0.13.0",
    "pane-registry": "dev",
    "rdflib": "2.4.1",
    "solid-logic": "dev",
    "solid-ui": "dev",
    "solidos-toolkit": "dev",
    "typescript": "^5.9.3",
    "vite": "^8.0.16",
    "vitest": "^4.0.18",
    "ws": "^8.18.0"
  }
}
