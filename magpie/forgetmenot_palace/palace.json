    { "id": "west_division_lobby_p", "name": "West Division Lobby (Peers)","kind": "lobby",    "shape": "rect",    "bbox": { "x": 36, "z": 22, "w": 3, "d": 6 }, "description": "Peers cross here when the question is divided. Tall narrow space, voting clerks at the door." },
