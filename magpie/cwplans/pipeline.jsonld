    },
    {
     "@id": "https://github.com/danbri/glitchcan-minigam/blob/master/magpie/cwplans/registry/sources/pla/ukho_thames_hms_belfast_berth.geojson"
    },
    {
     "cwp:pathPattern": "data/raw/registry/pla/ukho_<file name with spaces as _>.csv"
    }
   ],
   "cwp:tool": {
    "@id": "https://github.com/danbri/glitchcan-minigam/blob/master/magpie/cwplans/registry/sources/pla/fetch_wet.py"
   },
   "cwp:command": "python3 magpie/cwplans/registry/sources/pla/fetch_wet.py soundings",
   "cwp:kind": "fetch",
   "cwp:rule": [
    "Box WGS84 -0.0950, 51.4740 to 0.0150, 51.5220.",
    "z_cd is the file value as a height above Admiralty Chart Datum; negative is below chart datum.",
    "Lines that do not parse as lat, lon, z (headers) are skipped."
   ],
   "cwp:network": true,
   "cwp:deterministic": false,
   "cwp:after": []
