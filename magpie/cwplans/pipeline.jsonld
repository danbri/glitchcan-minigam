    }
   ],
   "cwp:tool": {
    "@id": "https://github.com/danbri/glitchcan-minigam/blob/master/magpie/cwplans/tools/build-skyline.mjs"
   },
   "cwp:command": "node magpie/cwplans/tools/build-skyline.mjs",
   "cwp:kind": "derive",
   "cwp:rule": [
    "height = 90th percentile of the DSM inside today's OSM outline (1 m sampling, at most 4000 points) minus the model ground",
    "not standing: under 3 m or under a quarter of today's height (a cleared site with hoardings)",
    "null: under 30% of the outline's points have data in that survey",
    "a survey that flew under 20% of the buildings is left out (2015)",
    "Heights in metres; the ground is the model ground (area.js terrain), not each survey's DTM."
   ],
   "cwp:network": false,
   "cwp:deterministic": false,
   "cwp:after": [
    {
     "@id": "https://danbri.github.io/glitchcan-minigam/magpie/cwplans/data-register.json#activity/build-docklands"
    },
    {
     "@id": "https://danbri.github.io/glitchcan-minigam/magpie/cwplans/data-register.json#activity/fetch-dsm"
    }
