    },
    {
     "cwp:pathPattern": "<--svg plan.svg>"
    }
   ],
   "cwp:tool": {
    "@id": "https://github.com/danbri/glitchcan-minigam/blob/master/magpie/cwplans/tools/drone-flight.mjs"
   },
   "cwp:command": "node magpie/cwplans/tools/drone-flight.mjs [--out path.json] [--svg plan.svg] [--coverage 480]",
   "cwp:kind": "derive",
   "cwp:rule": [
    "Centripetal Catmull-Rom splines through eye and target waypoints.",
    "Limits: 30 m from every building prism, 15 m above the terrain, altitude 40-350 m, pitch 10-70 degrees, yaw rate 15 degrees/s, along-track acceleration 0.6 m/s2, lateral 1.5 m/s2, turn rate 10 degrees/s; waypoints are raised until the clearances hold."
   ],
   "cwp:network": false,
   "cwp:deterministic": true,
   "cwp:after": [
    {
     "@id": "https://danbri.github.io/glitchcan-minigam/magpie/cwplans/data-register.json#activity/build-docklands"
    },
