  {
   "@id": "https://danbri.github.io/glitchcan-minigam/magpie/cwplans/data-register.json#activity/join-web-facts",
   "@type": "prov:Activity",
   "rdfs:label": "join-web-facts",
   "dct:description": "Adds the facts read from the entities' own web pages (schema.org opening hours, telephone, events, menu, price range, cuisine) to the building occupants as occupants[].web, with the page, the fetch date, the scope and the confidence of the match.",
   "prov:used": [
    {
     "@id": "https://github.com/danbri/glitchcan-minigam/blob/master/magpie/cwplans/registry/buildings.json"
    },
    {
     "@id": "https://github.com/danbri/glitchcan-minigam/blob/master/magpie/cwplans/registry/sources/web/structured-facts.json"
    }
   ],
   "prov:generated": [
    {
     "@id": "https://github.com/danbri/glitchcan-minigam/blob/master/magpie/cwplans/registry/buildings.json"
    }
   ],
   "cwp:tool": {
    "@id": "https://github.com/danbri/glitchcan-minigam/blob/master/magpie/cwplans/tools/join-web-facts.mjs"
   },
   "cwp:command": "node magpie/cwplans/tools/join-web-facts.mjs",
   "cwp:kind": "derive",
   "cwp:rule": [
    "Keys: \"cwb-NNNN|name\" (occupant name in that building, case and accents folded), \"branch:<brand QID>@<element>\" (the occupant's OSM element, the building's OSM way, fhrs/<FSA id> or a bare FSA id, cwg/<slug>), \"charity:<number>\", \"cwg:<directory slug>\".",
    "One record per occupant: branch scope beats organisation beats chain; then high, medium, low confidence.",
    "A fact record with no hours, phone, events, menu, price range or cuisine is not joined; records that match no occupant are counted (summary.joins.web_facts).",
    "Run after build-registry (which rewrites buildings.json without web facts) and before build-categories and build-atlas."
   ],
   "cwp:network": false,
   "cwp:deterministic": true,
   "cwp:after": [
