    },
    {
     "@id": "https://github.com/danbri/glitchcan-minigam/blob/master/magpie/cwplans/registry/sources/registers/charities.json"
    },
    {
     "@id": "https://github.com/danbri/glitchcan-minigam/blob/master/magpie/cwplans/tools/jsonld-clean.mjs"
    },
    {
     "@id": "https://danbri.github.io/glitchcan-minigam/magpie/cwplans/data-register.json#source/factoidal",
     "dcat:accessURL": "npm @factoidal/core 0.7.1 (local)",
     "dct:description": "jsonldToRdf, parse (N-Triples, N-Quads), query (SPARQL 1.1 SELECT over named graphs)"
    }
   ],
   "prov:generated": [
    {
     "@id": "https://github.com/danbri/glitchcan-minigam/blob/master/magpie/cwplans/../../third_party/cwplans-structured-data/all.nq.gz"
    },
    {
     "@id": "https://github.com/danbri/glitchcan-minigam/blob/master/magpie/cwplans/registry/sources/web/structured-facts.json"
    }
   ],
   "cwp:tool": {
    "@id": "https://github.com/danbri/glitchcan-minigam/blob/master/magpie/cwplans/tools/extract-structured-data.mjs"
   },
   "cwp:command": "node magpie/cwplans/tools/extract-structured-data.mjs",
   "cwp:kind": "derive",
   "cwp:rule": [
    "Scope branch, confidence high: the node's postcode equals the entity's, or its geo is within 300 m of the building.",
    "Scope branch, confidence medium: the node has no address and the page is the branch's own page (a store_url field, a store-finder result, or a URL path that names the place).",
    "Scope branch, confidence low: the node's postcode is another E14/E20 postcode (a sibling branch is possible).",
    "Scope chain: a chain branch's general page with no address on the node (chain-wide facts, not branch facts). Scope organisation: the same for a non-chain entity's own site.",
    "Nodes with an address or position elsewhere are not attributed and are counted.",
    "Opening hours to OSM opening_hours: days grouped, 23:59 closes become 24:00, opens = closes = 00:00 is 'off', dated specifications become date-range rules; unparsed text is kept raw with the problem listed."
   ],
   "cwp:network": false,
   "cwp:deterministic": true,
