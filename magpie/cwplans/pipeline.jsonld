  {
   "@id": "https://danbri.github.io/glitchcan-minigam/magpie/cwplans/data-register.json#activity/build-indoor",
   "@type": "prov:Activity",
   "rdfs:label": "build-indoor",
   "dct:description": "Builds the Canary Wharf walking network in 3D from OSM (footways, corridors, stairs, escalators, lifts, platforms, streets) with each point on its level, adds TfL's step-free station topology, attaches named places, and records faults for the audit.",
   "prov:used": [
    {
     "@id": "urn:cwplans:local:data/raw/docklands/greater_london-latest.osm.pbf"
    },
    {
     "@id": "urn:cwplans:local:data/raw/uk_os_OSTN15_NTv2_OSGBtoETRS.tif"
    },
    {
     "@id": "https://github.com/danbri/glitchcan-minigam/blob/master/magpie/cwplans/docklands/data/area.js"
    },
    {
     "@id": "https://github.com/danbri/glitchcan-minigam/blob/master/magpie/cwplans/data/raw/docklands/tfl-stationdata-gtfs.zip"
    },
    {
     "@id": "https://danbri.github.io/glitchcan-minigam/magpie/cwplans/data-register.json#source/tfl-open-data",
     "dcat:accessURL": "https://api.tfl.gov.uk/stationdata/tfl-stationdata-gtfs.zip",
     "dct:description": "TfL station topology (GTFS stops and pathways), fetched only when the local copy is absent"
    }
   ],
   "prov:generated": [
    {
     "@id": "https://github.com/danbri/glitchcan-minigam/blob/master/magpie/cwplans/docklands/data/indoor.js"
    },
    {
     "@id": "https://github.com/danbri/glitchcan-minigam/blob/master/magpie/cwplans/data/raw/docklands/tfl-stationdata-gtfs.zip"
    }
   ],
   "cwp:tool": {
    "@id": "https://github.com/danbri/glitchcan-minigam/blob/master/magpie/cwplans/tools/build-indoor.mjs"
   },
   "cwp:command": "node magpie/cwplans/tools/build-indoor.mjs",
   "cwp:kind": "derive",
   "cwp:rule": [
    "Box -0.0330, 51.4960 to -0.0020, 51.5120; walkable highway values, not access=private or foot=no, plus platforms, conveying ways and indoor areas, corridors and rooms.",
    "Level: level, else level:ref (tools/osm-values.mjs osmLevels), else layer when the way is a tunnel, indoor or underground with layer < 0, else 0.",
    "One vertex per (OSM node, level); stairs and escalators are oriented by the levels their ends touch, else by incline, else counted as unresolved.",
    "A lift node joins its copies at the levels it lists, in order.",
    "Walkable areas get a hub joined to every vertex on their level inside them or within 3 m of their edge.",
    "A node that ordinary ways reach at two levels with no connector is joined as 'ramp' and counted as a level jump.",
    "TfL points join the nearest OSM vertex within 35 m only at street level (TfL level 0 = OSM level 0); TfL lifts (pathway_mode 5) and paths join TfL points; nearest-vertex level pairs are recorded per station.",
    "Places attach to the nearest vertex on their own level within 40 m, else the nearest vertex on any level within 40 m (marked)."
   ],
   "cwp:network": true,
   "cwp:deterministic": false,
   "cwp:after": [
    {
     "@id": "https://danbri.github.io/glitchcan-minigam/magpie/cwplans/data-register.json#activity/fetch-docklands-osm"
    },
    {
     "@id": "https://danbri.github.io/glitchcan-minigam/magpie/cwplans/data-register.json#activity/build-docklands"
    },
    {
     "@id": "https://danbri.github.io/glitchcan-minigam/magpie/cwplans/data-register.json#activity/fetch-raw-grid"
    }
   ]
  },
  {
   "@id": "https://danbri.github.io/glitchcan-minigam/magpie/cwplans/data-register.json#activity/build-imagery",
   "@type": "prov:Activity",
   "rdfs:label": "build-imagery",
   "dct:description": "Colours each terrain vertex of the Docklands model from the least cloudy recent Sentinel-2 true-colour image.",
   "prov:used": [
    {
     "@id": "https://github.com/danbri/glitchcan-minigam/blob/master/magpie/cwplans/docklands/data/area.js"
    },
    {
     "@id": "https://danbri.github.io/glitchcan-minigam/magpie/cwplans/data-register.json#source/copernicus-sentinel",
     "dcat:accessURL": "https://earth-search.aws.element84.com/v1/search",
     "dct:description": "STAC search: collection sentinel-2-l2a intersecting POINT(-0.0195 51.5049) from the from-date (default 120 days before the run) to now, eo:cloud_cover < 10, sorted by cloud cover, limit 1"
    },
    {
     "@id": "https://danbri.github.io/glitchcan-minigam/magpie/cwplans/data-register.json#source/copernicus-sentinel",
     "dcat:accessURL": "the scene's 'visual' (TCI) Cloud-Optimised GeoTIFF on S3",
     "dct:description": "HTTP range requests for the pixel window over the model box only"
    }
   ],
   "prov:generated": [
    {
     "@id": "https://github.com/danbri/glitchcan-minigam/blob/master/magpie/cwplans/docklands/data/imagery.js"
    }
   ],
   "cwp:tool": {
    "@id": "https://github.com/danbri/glitchcan-minigam/blob/master/magpie/cwplans/tools/build-imagery.mjs"
   },
   "cwp:command": "NODE_USE_ENV_PROXY=1 node magpie/cwplans/tools/build-imagery.mjs [from-date]",
   "cwp:kind": "derive",
