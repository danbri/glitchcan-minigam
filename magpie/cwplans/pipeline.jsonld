     "@id": "https://github.com/danbri/glitchcan-minigam/blob/master/magpie/cwplans/docklands/data/area.js"
    },
    {
     "@id": "https://github.com/danbri/glitchcan-minigam/blob/master/magpie/cwplans/docklands/data/tex/textures.json"
    },
    {
     "@id": "urn:cwplans:local:data/raw/imagery/rgb2008.ppm"
    },
    {
     "@id": "https://github.com/danbri/glitchcan-minigam/blob/master/magpie/cwplans/docklands/data/splats/index.json"
    }
   ],
   "prov:generated": [
    {
     "@id": "https://github.com/danbri/glitchcan-minigam/blob/master/magpie/cwplans/docklands/data/splats/cw-synth.splat.gz"
    },
    {
     "@id": "https://github.com/danbri/glitchcan-minigam/blob/master/magpie/cwplans/docklands/data/splats/cw-synth.json"
    },
    {
     "@id": "https://github.com/danbri/glitchcan-minigam/blob/master/magpie/cwplans/docklands/data/splats/index.json"
    },
    {
     "@id": "urn:cwplans:local:data/raw/splats/cw-synth.ply"
    },
    {
     "@id": "https://github.com/danbri/glitchcan-minigam/blob/master/magpie/cwplans/docklands/data/splats/cw-synth.groups.bin.gz"
    }
   ],
   "cwp:tool": {
    "@id": "https://github.com/danbri/glitchcan-minigam/blob/master/magpie/cwplans/tools/build-splats.mjs"
   },
   "cwp:command": "node magpie/cwplans/tools/build-splats.mjs [--ground 4] [--cell 7.2] [--box x0,x1,z0,z1]",
   "cwp:kind": "derive",
   "cwp:rule": [
    "Box: the model's focus box plus 300 m unless --box is given.",
    "Ground discs every 4 m (--ground) where no building covers the cell, coloured bilinearly from rgb2008.ppm.",
    "Roof discs every 4 m inside the outline: aerial colour on buildings under 40 m, else the building colour.",
    "Walls: one disc per 3.6 m storey and 7.2 m (--cell) of wall, and one glass-band disc 3 cm in front per cell (buildings 4 m or taller).",
    "The set entry 'cw-synth' replaces any earlier one in index.json; other entries are kept.",
    "every splat records its building (uint16 index into cw-synth.json groups; 65535 = ground) for animation"
   ],
   "cwp:network": false,
   "cwp:deterministic": false,
   "cwp:after": [
    {
     "@id": "https://danbri.github.io/glitchcan-minigam/magpie/cwplans/data-register.json#activity/build-docklands"
    },
    {
     "@id": "https://danbri.github.io/glitchcan-minigam/magpie/cwplans/data-register.json#activity/build-aerial-rgb2008"
    }
   ]
  },
  {
   "@id": "https://danbri.github.io/glitchcan-minigam/magpie/cwplans/data-register.json#activity/drone-flight",
   "@type": "prov:Activity",
   "rdfs:label": "drone-flight",
