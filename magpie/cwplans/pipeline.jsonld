    },
    {
     "@id": "https://github.com/danbri/glitchcan-minigam/blob/master/magpie/cwplans/data/raw/osm-water-full.json.gz"
    },
    {
     "@id": "https://github.com/danbri/glitchcan-minigam/blob/master/magpie/cwplans/data/raw/wikidata-around.json"
    },
    {
     "@id": "https://github.com/danbri/glitchcan-minigam/blob/master/magpie/cwplans/data/raw/wikidata-facts.json"
    },
