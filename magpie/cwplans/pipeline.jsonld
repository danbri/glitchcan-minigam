    {
     "@id": "https://danbri.github.io/glitchcan-minigam/magpie/cwplans/data-register.json#source/pla-arcgis",
     "dcat:accessURL": "https://services8.arcgis.com/QgdzYlEcjteGD0VH/arcgis/rest/services/<layer>/FeatureServer/<n>/query",
     "dct:description": "ArcGIS envelope query over the box, outSR 4326, GeoJSON, paged by 1000: 11 Port of London Authority layers (navigational limit, navigation channels, MHWM, hydrographic product areas, foreshore digging and standard permits, restrictions, port masterplan sites, sediment samples, vessel licensing areas, 1968 limits removed by the HRO)"
    },
    {
     "@id": "https://danbri.github.io/glitchcan-minigam/magpie/cwplans/data-register.json#source/crt-arcgis",
     "dcat:accessURL": "https://services.arcgis.com/DknzyjEEie5tEW0u/arcgis/rest/services/<layer>/FeatureServer/<n>/query",
     "dct:description": "same query for 10 Canal & River Trust layers (docks, waterway basins, locks, bridges, canals, culverts, mooring sites, towpath, outfalls, stop plank grooves)"
    }
   ],
   "prov:generated": [
    {
     "@id": "urn:cwplans:local:registry/sources/pla/pla_*.geojson"
    },
    {
     "@id": "urn:cwplans:local:registry/sources/pla/crt_*.geojson"
    },
    {
     "@id": "urn:cwplans:local:data/raw/registry/pla/pla_*.geojson"
    },
    {
     "@id": "urn:cwplans:local:data/raw/registry/pla/crt_*.geojson"
    }
   ],
   "cwp:tool": {
    "@id": "https://github.com/danbri/glitchcan-minigam/blob/master/magpie/cwplans/registry/sources/pla/fetch_wet.py"
   },
   "cwp:command": "python3 magpie/cwplans/registry/sources/pla/fetch_wet.py layers",
   "cwp:kind": "fetch",
   "cwp:rule": [
    "Only the listed outFields are kept per layer ('*' for some).",
    "Every layer except pla_hydrographic_product_areas is clipped to the box (ogr2ogr -clipsrc).",
    "Arguments 'pla' or 'crt' run one provider only."
   ],
   "cwp:network": true,
   "cwp:deterministic": false,
   "cwp:after": []
  },
  {
   "@id": "https://danbri.github.io/glitchcan-minigam/magpie/cwplans/data-register.json#activity/fetch_records",
   "@type": "prov:Activity",
   "rdfs:label": "fetch_records",
   "dct:description": "Collects geocoded museum objects, heritage records and archaeological catalogue records inside the Docklands box into one record list, and the APA polygons clipped to the box.",
   "prov:used": [
    {
     "@id": "https://danbri.github.io/glitchcan-minigam/magpie/cwplans/data-register.json#source/wikidata",
     "dcat:accessURL": "https://qlever.dev/api/wikidata",
     "dct:description": "SPARQL, three queries over the Docklands box: objects in a collection (P195) whose location (P276) is in the box; objects with their own P625 in the box; objects whose place of discovery (P189) or creation (P1071) is in the box; with label, P31, P571, P217, P195"
    },
    {
     "@id": "https://danbri.github.io/glitchcan-minigam/magpie/cwplans/data-register.json#source/historic-england",
     "dcat:accessURL": "https://services-eu1.arcgis.com/ZOdPfBS3aqqDYPUQ/arcgis/rest/services/",
     "dct:description": "ArcGIS envelope queries: NHLE scheduled monuments (layer 6), scheduled wrecks (layer 24), research reports (layer 475), heritage harbours inventory (layer 0), Greater London Archaeological Priority Areas (layer 1, GeoJSON)"
    },
    {
     "@id": "https://danbri.github.io/glitchcan-minigam/magpie/cwplans/data-register.json#source/ads-ariadne",
     "dcat:accessURL": "https://archaeologydataservice.ac.uk/data-catalogue-api/api/search",
     "dct:description": "catalogue search in the box, 50 a page, six samples: publisher British Museum (PAS), contributor MOLA, subject Fieldwork report, subject Maritime, publisher and contributor Historic England"
    }
   ],
   "prov:generated": [
    {
     "@id": "urn:cwplans:local:registry/sources/museums/records.json"
    },
    {
     "@id": "https://github.com/danbri/glitchcan-minigam/blob/master/magpie/cwplans/registry/sources/museums/apa_greater_london.geojson"
    },
    {
     "cwp:pathPattern": "data/raw/registry/museums/wikidata_<query>.json"
    },
    {
     "cwp:pathPattern": "data/raw/registry/museums/he_<layer>.json"
    },
    {
     "@id": "urn:cwplans:local:data/raw/registry/museums/he_apas.geojson"
    },
    {
     "cwp:pathPattern": "data/raw/registry/museums/ads_<sample>.json"
    }
   ],
   "cwp:tool": {
    "@id": "https://github.com/danbri/glitchcan-minigam/blob/master/magpie/cwplans/registry/sources/museums/fetch_records.py"
   },
   "cwp:command": "python3 magpie/cwplans/registry/sources/museums/fetch_records.py",
   "cwp:kind": "fetch",
   "cwp:rule": [
