  {
   "@id": "https://danbri.github.io/glitchcan-minigam/magpie/cwplans/data-register.json#activity/fetch_wet-layers",
   "@type": "prov:Activity",
   "rdfs:label": "fetch_wet-layers",
   "dct:description": "Fetches the PLA and Canal & River Trust layers that intersect the Docklands box and clips them to the box with ogr2ogr.",
