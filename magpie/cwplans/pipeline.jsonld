     "@id": "https://danbri.github.io/glitchcan-minigam/magpie/cwplans/data-register.json#source/web-structured-data",
     "dcat:accessURL": "occupants[].website, .contact:website, .cwg_website, .store_url (buildings.json); branches[].website, .cwg_website, .store_url; storelocator checked[].store_url; cwg-directory directory[].website; charities records[].website (registered charities); brand sites from Wikidata P856 for store finders",
     "dct:description": "robots.txt once per host (Node fetch, else Chromium), then one headless Chromium page load per URL; robots.txt checked for every main-frame navigation; at most 3 pages at once, one per host, at least 2 s apart; images, media and fonts blocked; store finders: home page, up to three finder pages, one postcode search per brand and postcode, the branch page"
    }
   ],
   "prov:generated": [
    {
     "@id": "https://github.com/danbri/glitchcan-minigam/blob/master/magpie/cwplans/../../third_party/cwplans-structured-data/pages"
    },
    {
     "@id": "https://github.com/danbri/glitchcan-minigam/blob/master/magpie/cwplans/../../third_party/cwplans-structured-data/index.json"
    },
    {
     "cwp:pathPattern": "data/raw/rendered/<host>/<sha1(url)[0:16]>.html.gz (rendered DOM), .json (result), robots.json; data/raw/rendered/_storefinder/"
    }
   ],
