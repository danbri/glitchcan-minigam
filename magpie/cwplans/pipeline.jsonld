   },
   "cwp:command": "node magpie/cwplans/registry/sources/brands/tools/readme-tables.mjs > /tmp/tables.md",
   "cwp:kind": "export",
   "cwp:rule": [
    "One row per branch: brand, category, name, where (mall, level, postcode or address), sources, confidence, links.",
