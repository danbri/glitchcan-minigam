     "dct:description": "DSM tiles TQ3575 and TQ3580 for 1999, 2003, 2007, 2012, 2015, 2018, 2020, 2022 (fetched by data/raw/dsm/fetch.sh, not by this tool)"
    },
    {
     "cwp:pathPattern": "data/raw/dsm/<product>-<year>-<res>-<tile>.zip"
    },
    {
     "@id": "https://github.com/danbri/glitchcan-minigam/blob/master/magpie/cwplans/docklands/data/area.js"
    }
   ],
