  {
   "@id": "https://danbri.github.io/glitchcan-minigam/magpie/cwplans/data-register.json#activity/fetch_wet-soundings",
   "@type": "prov:Activity",
   "rdfs:label": "fetch_wet-soundings",
   "dct:description": "Downloads the UKHO bathymetry CSVs and keeps the soundings inside the Docklands box as GeoJSON points with the height above chart datum.",
   "prov:used": [
    {
     "@id": "https://danbri.github.io/glitchcan-minigam/magpie/cwplans/data-register.json#source/ukho",
     "dcat:accessURL": "https://datahub.admiralty.co.uk/Bathy_Data/Prodbathy/bathymetry/<file>.csv",
     "dct:description": "three survey CSVs by curl: 'River Thames Teddington Lock to Greenwich Reach 25m', 'River Thames Greenwich Reach to Coalhouse Point 50m' (survey RSDRA2018000117951), 'River Thames HMS Belfast' (RSDRA2015000255836)"
    }
   ],
   "prov:generated": [
    {
     "@id": "https://github.com/danbri/glitchcan-minigam/blob/master/magpie/cwplans/registry/sources/pla/ukho_thames_teddington_greenwich_25m.geojson"
    },
