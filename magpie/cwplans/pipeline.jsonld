   "@type": "prov:Activity",
   "rdfs:label": "build-skyline",
   "dct:description": "Measures the height of each model building on the Canary Wharf estate and 300 m round it in every EA LiDAR surface model from 1999 to 2022, for the year slider.",
   "prov:used": [
    {
     "cwp:pathPattern": "data/raw/dsm/<product>-<year>-<res>-<tile>.zip"
    },
    {
     "@id": "https://danbri.github.io/glitchcan-minigam/magpie/cwplans/data-register.json#source/ea-dsm-history",
     "dcat:accessURL": "https://environment.data.gov.uk/tiles/collections/survey/<product>/<year>/<res>/<tile>",
     "dct:description": "DSM tiles TQ3575 and TQ3580 for 1999, 2003, 2007, 2012, 2015, 2018, 2020, 2022 (fetched by tools/fetch-dsm.sh, not by this tool)"
    },
    {
     "@id": "https://github.com/danbri/glitchcan-minigam/blob/master/magpie/cwplans/docklands/data/area.js"
    }
   ],
   "prov:generated": [
    {
