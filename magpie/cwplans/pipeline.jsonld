  {
   "@id": "https://danbri.github.io/glitchcan-minigam/magpie/cwplans/data-register.json#activity/fetch-docklands-lidar",
   "@type": "prov:Activity",
   "rdfs:label": "fetch-docklands-lidar",
   "dct:description": "Downloads the DTM and DSM of the Docklands box as 1 km tiles (48 tiles each).",
   "prov:used": [
    {
     "@id": "https://danbri.github.io/glitchcan-minigam/magpie/cwplans/data-register.json#source/ea-lidar",
