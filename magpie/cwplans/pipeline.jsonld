    },
    {
     "@id": "https://danbri.github.io/glitchcan-minigam/magpie/cwplans/data-register.json#activity/fetch-cwg"
    },
    {
     "@id": "https://danbri.github.io/glitchcan-minigam/magpie/cwplans/data-register.json#activity/wikidata-brands"
    },
    {
     "@id": "https://danbri.github.io/glitchcan-minigam/magpie/cwplans/data-register.json#activity/build-uk-brands"
    },
    {
     "@id": "https://danbri.github.io/glitchcan-minigam/magpie/cwplans/data-register.json#activity/postcodes-build"
    },
    {
     "@id": "https://danbri.github.io/glitchcan-minigam/magpie/cwplans/data-register.json#activity/storelocator"
    }
   ],
   "cwp:area": "brands",
   "cwp:fault": [
    "F2",
    "F3",
    "F7",
    "F9"
   ],
   "cwp:judgement": "CWG matches that the rules leave undecided are decided by hand in registry/sources/brands/tools/cwg-decisions.json (manual activity brand-decisions)."
  },
  {
   "@id": "https://danbri.github.io/glitchcan-minigam/magpie/cwplans/data-register.json#activity/storelocator",
   "@type": "prov:Activity",
   "rdfs:label": "storelocator",
   "dct:description": "Checks the brand's own page for each Canary Wharf branch of the 30 largest brand families present in the box.",
   "prov:used": [
    {
     "@id": "https://github.com/danbri/glitchcan-minigam/blob/master/magpie/cwplans/registry/sources/brands/branches.json"
    },
    {
     "@id": "urn:cwplans:local:data/raw/registry/london-brand-counts.json"
    },
    {
     "@id": "https://github.com/danbri/glitchcan-minigam/blob/master/magpie/cwplans/registry/sources/brands/wikidata-brands.json"
    },
    {
     "@id": "https://github.com/danbri/glitchcan-minigam/blob/master/magpie/cwplans/registry/sources/brands/tools/storelocator-manual.json"
    },
    {
     "@id": "urn:cwplans:local:data/raw/registry/storelocator-cache.json"
    },
    {
     "@id": "https://danbri.github.io/glitchcan-minigam/magpie/cwplans/data-register.json#source/brand-sites",
     "dcat:accessURL": "the branch's store page URL (OSM website=* below the brand's domain, or a URL found by hand)",
     "dct:description": "one GET per URL, identifying User-Agent, redirects followed, at most 1 request a second per host"
    }
   ],
   "prov:generated": [
    {
     "@id": "https://github.com/danbri/glitchcan-minigam/blob/master/magpie/cwplans/registry/sources/brands/storelocator.json"
    },
    {
     "@id": "urn:cwplans:local:data/raw/registry/storelocator-cache.json"
    }
   ],
   "cwp:tool": {
    "@id": "https://github.com/danbri/glitchcan-minigam/blob/master/magpie/cwplans/registry/sources/brands/tools/storelocator.mjs"
   },
   "cwp:command": "NODE_USE_ENV_PROXY=1 node magpie/cwplans/registry/sources/brands/tools/storelocator.mjs",
   "cwp:kind": "fetch",
   "cwp:rule": [
    "Brand family: a brand and its Wikidata parent count as one; size = the largest Greater London OSM branch count of the family.",
    "Candidate URL: the manual entry for the branch, else OSM website=* when it is not canarywharf.com and not a bare home page.",
    "verified: HTTP 2xx, no bot-challenge page, and the page text or the URL path names Canary Wharf, the postcode or the mall; 401, 403, 429 or a challenge page = blocked.",
    "A URL with a stored status is not fetched again.",
    "Cache: data/raw/registry/storelocator-cache.json holds each URL's result and is written after every fetch.",
    "Network: 1.1 s minimum gap per host, 60 s timeout, User-Agent glitchcan-cwplans/0.1; blocked pages are recorded, not retried."
   ],
   "cwp:network": true,
   "cwp:deterministic": false,
   "cwp:after": [
    {
     "@id": "https://danbri.github.io/glitchcan-minigam/magpie/cwplans/data-register.json#activity/build-branches"
    },
    {
     "@id": "https://danbri.github.io/glitchcan-minigam/magpie/cwplans/data-register.json#activity/london-brand-counts"
    },
    {
     "@id": "https://danbri.github.io/glitchcan-minigam/magpie/cwplans/data-register.json#activity/wikidata-brands"
    }
   ],
   "cwp:area": "brands",
   "cwp:fault": [],
   "cwp:judgement": "Store-page URLs that OSM does not give were found by hand on the brand locators: registry/sources/brands/tools/storelocator-manual.json (manual activity storelocator-manual)."
  },
  {
   "@id": "https://danbri.github.io/glitchcan-minigam/magpie/cwplans/data-register.json#activity/readme-tables",
   "@type": "prov:Activity",
   "rdfs:label": "readme-tables",
