   "rdfs:label": "build-branches",
   "dct:description": "Merges the OSM, FSA, Wikidata, CWG directory and store-page evidence into one list of chain-store branches in the Canary Wharf box, with sources, position, mall, level and a confidence.",
   "prov:used": [
    {
     "@id": "urn:cwplans:local:data/raw/registry/osm-branches.json"
    },
    {
     "@id": "urn:cwplans:local:data/raw/registry/fsa-branches.json"
    },
    {
     "@id": "https://github.com/danbri/glitchcan-minigam/blob/master/magpie/cwplans/registry/sources/brands/cwg-directory.json"
    },
    {
     "@id": "https://github.com/danbri/glitchcan-minigam/blob/master/magpie/cwplans/registry/sources/brands/wikidata-near.json"
    },
    {
     "@id": "https://github.com/danbri/glitchcan-minigam/blob/master/magpie/cwplans/registry/sources/brands/wikidata-brands.json"
    },
    {
     "@id": "https://github.com/danbri/glitchcan-minigam/blob/master/magpie/cwplans/registry/sources/brands/storelocator.json"
    },
    {
     "@id": "https://github.com/danbri/glitchcan-minigam/blob/master/magpie/cwplans/registry/sources/brands/tools/cwg-decisions.json"
    },
    {
     "@id": "https://github.com/danbri/glitchcan-minigam/blob/master/magpie/cwplans/postcodes/postcodes.json"
    },
    {
     "@id": "https://github.com/danbri/glitchcan-minigam/blob/master/magpie/cwplans/registry/sources/brands/brands-uk.json"
    },
    {
     "@id": "urn:cwplans:local:data/raw/registry/nsi/node_modules/name-suggestion-index/dist/json/nsi.json"
    },
    {
     "@id": "urn:cwplans:local:data/raw/registry/nsi/node_modules/name-suggestion-index/dist/json/featureCollection.json"
    }
   ],
   "prov:generated": [
    {
     "@id": "https://github.com/danbri/glitchcan-minigam/blob/master/magpie/cwplans/registry/sources/brands/branches.json"
    }
   ],
   "cwp:tool": {
    "@id": "https://github.com/danbri/glitchcan-minigam/blob/master/magpie/cwplans/registry/sources/brands/tools/build-branches.mjs"
   },
   "cwp:command": "node magpie/cwplans/registry/sources/brands/tools/build-branches.mjs",
   "cwp:kind": "join",
   "cwp:rule": [
    "Records join only when they are the same brand family (same Wikidata QID or a P749 parent, else same NSI id) and the same place: within 120 m (160 m when a position is approximate), or the same postcode, or the same mall.",
    "Two named malls decide a join by themselves; Canada Place and One Canada Square count as one level.",
    "An OSM feature whose fhrs:id equals the FSA premises id is the same branch.",
    "Wikidata items join a branch within 300 m.",
    "A CWG entry needs an NSI match (or a decision in cwg-decisions.json); a 'prefix' or 'alternate' match or a type that does not fit the CWG section is left undecided; otherwise a CWG title that names a branch already found (5 or more letters, whole words) joins it.",
    "Postcode to mall: kept when 4 or more CWG entries share the postcode and 85% or more name the same mall.",
    "Position: OSM feature, else FSA geocode, else mall centre or ONSPD postcode centroid (flagged).",
    "Confidence: high with two or more sources; low for a single prefix or alternate FSA match or a note that says low confidence; else medium.",
    "Category from the key=value (bank, pharmacy, supermarket, cafe, takeaway, restaurant, bar, gym, hotel, leisure, health, childcare, office, motoring, service, shop, other)."
   ],
   "cwp:network": false,
   "cwp:deterministic": false,
   "cwp:after": [
    {
     "@id": "https://danbri.github.io/glitchcan-minigam/magpie/cwplans/data-register.json#activity/match-osm"
