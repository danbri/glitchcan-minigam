  {
   "@id": "https://danbri.github.io/glitchcan-minigam/magpie/cwplans/data-register.json#activity/fetch-raw-grid",
   "@type": "prov:Activity",
   "rdfs:label": "fetch-raw-grid",
   "dct:description": "Downloads the OSTN15 grid that every WGS84 to British National Grid conversion in the project uses (tools/lib.mjs bngProjector).",
   "prov:used": [
    {
     "@id": "https://danbri.github.io/glitchcan-minigam/magpie/cwplans/data-register.json#source/os-ostn15",
     "dcat:accessURL": "https://cdn.proj.org/uk_os_OSTN15_NTv2_OSGBtoETRS.tif",
     "dct:description": "the OS OSTN15 NTv2 transformation grid (GeoTIFF) as distributed by the PROJ CDN"
    }
   ],
   "prov:generated": [
    {
     "@id": "urn:cwplans:local:data/raw/uk_os_OSTN15_NTv2_OSGBtoETRS.tif"
    }
   ],
   "cwp:tool": {
    "@id": "https://github.com/danbri/glitchcan-minigam/blob/master/magpie/cwplans/tools/fetch-raw.mjs"
   },
   "cwp:command": "node magpie/cwplans/tools/fetch-raw.mjs grid",
   "cwp:kind": "fetch",
   "cwp:rule": [
    "The file is written as fetched; no change."
   ],
   "cwp:network": true,
   "cwp:deterministic": false,
   "cwp:after": []
  },
  {
   "@id": "https://danbri.github.io/glitchcan-minigam/magpie/cwplans/data-register.json#activity/fetch-raw-osm",
   "@type": "prov:Activity",
   "rdfs:label": "fetch-raw-osm",
   "dct:description": "Fetches the OSM map call for the small corridor box, then the full geometry of water multipolygons whose member ways the map call leaves out (the Pool of London).",
   "prov:used": [
    {
     "@id": "https://danbri.github.io/glitchcan-minigam/magpie/cwplans/data-register.json#source/osm",
     "dcat:accessURL": "https://api.openstreetmap.org/api/0.6/map.json?bbox=-0.062,51.488,-0.038,51.507",
     "dct:description": "OSM API map call for the corridor box (Canada Water)"
    },
    {
     "@id": "https://danbri.github.io/glitchcan-minigam/magpie/cwplans/data-register.json#source/osm",
     "dcat:accessURL": "https://api.openstreetmap.org/api/0.6/relation/{id}/full.json",
     "dct:description": "full member lists of natural=water multipolygons that have member ways outside the box"
    }
   ],
   "prov:generated": [
    {
     "@id": "https://github.com/danbri/glitchcan-minigam/blob/master/magpie/cwplans/data/raw/osm-map.json.gz"
    },
    {
     "@id": "https://github.com/danbri/glitchcan-minigam/blob/master/magpie/cwplans/data/raw/osm-water-full.json.gz"
    }
   ],
   "cwp:tool": {
    "@id": "https://github.com/danbri/glitchcan-minigam/blob/master/magpie/cwplans/tools/fetch-raw.mjs"
   },
   "cwp:command": "node magpie/cwplans/tools/fetch-raw.mjs osm",
   "cwp:kind": "fetch",
   "cwp:rule": [
    "Box WGS84 west -0.0620, south 51.4880, east -0.0380, north 51.5070.",
    "A relation is fetched in full when it is type=multipolygon, natural=water and has a member way that is not in the map call."
   ],
   "cwp:network": true,
   "cwp:deterministic": false,
   "cwp:after": []
  },
