   "@type": "prov:Activity",
   "rdfs:label": "build-categories",
   "dct:description": "Gives each registry building its occupant categories (finance, shop, catering, leisure, entertainment) from the classes the sources state, for the glow outlines and the atlas.",
   "prov:used": [
    {
     "@id": "https://github.com/danbri/glitchcan-minigam/blob/master/magpie/cwplans/registry/buildings.json"
    },
    {
     "@id": "https://github.com/danbri/glitchcan-minigam/blob/master/magpie/cwplans/data/raw/registry/osm-cw.json.gz"
    },
    {
     "@id": "urn:cwplans:local:data/raw/registry/wikidata-occupant-classes.json"
    },
    {
     "@id": "https://danbri.github.io/glitchcan-minigam/magpie/cwplans/data-register.json#source/wikidata",
     "dcat:accessURL": "https://qlever.dev/api/wikidata",
     "dct:description": "SPARQL: P31 and P452 classes (English labels) of every Wikidata occupant item in registry/buildings.json; P466 and P159 statements of every registry building item with P580 and P582 qualifiers and the organisation's P576"
    }
   ],
   "prov:generated": [
    {
     "@id": "https://github.com/danbri/glitchcan-minigam/blob/master/magpie/cwplans/registry/categories.json"
    },
    {
     "@id": "urn:cwplans:local:data/raw/registry/wikidata-occupant-classes.json"
    }
   ],
   "cwp:tool": {
    "@id": "https://github.com/danbri/glitchcan-minigam/blob/master/magpie/cwplans/tools/build-categories.mjs"
   },
   "cwp:command": "NODE_USE_ENV_PROXY=1 node magpie/cwplans/tools/build-categories.mjs",
   "cwp:kind": "derive",
   "cwp:rule": [
    "finance: OSM amenity bank, bureau_de_change or money_transfer, or office financial, insurance, financial_advisor or tax_advisor; or a Wikidata P31 or P452 label matching bank, finance, insurance, investment and similar; or the role 'service: bank' or 'branch: bank'.",
    "shop: an OSM shop tag, the role 'shop' or 'branch: shop', or an FSA type starting 'Retailers'.",
    "catering: OSM amenity restaurant, cafe, bar, pub, fast_food, food_court, ice_cream or biergarten; the role 'food and drink' or a food branch; or an FSA catering type.",
    "leisure: OSM leisure fitness_centre, sports_centre, swimming_pool, sauna, dance or sports_hall; a hotel role or FSA hotel type.",
    "entertainment: OSM cinema, theatre, nightclub, arts centre, casino, events or music venue, planetarium, amusement and bowling leisure, museum or gallery; or a Wikidata class matching those.",
    "Names are never used to guess a class; Companies House registered offices are not used.",
    "Wikidata occupant links: an end date (P582) or a dissolved organisation (P576) makes the entry 'former' and it is not counted; a start date and no end makes it 'current'; no qualifier makes it 'undated'."
   ],
   "cwp:network": true,
   "cwp:deterministic": false,
   "cwp:after": [
