    },
    {
     "@id": "https://github.com/danbri/glitchcan-minigam/blob/master/magpie/cwplans/registry/sources/brands/brands-uk.json"
    },
    {
     "@id": "https://github.com/danbri/glitchcan-minigam/blob/master/magpie/cwplans/registry/sources/brands/tools/fsa-decisions.json"
    },
    {
     "@id": "urn:cwplans:local:data/raw/registry/nsi/node_modules/name-suggestion-index/dist/json/nsi.json"
    },
    {
     "@id": "urn:cwplans:local:data/raw/registry/nsi/node_modules/name-suggestion-index/dist/json/featureCollection.json"
    },
    {
     "@id": "https://danbri.github.io/glitchcan-minigam/magpie/cwplans/data-register.json#source/fsa-api",
     "dcat:accessURL": "https://api.ratings.food.gov.uk/Establishments/{fhrs_id}",
     "dct:description": "address and geocode of each kept premises not yet cached"
    }
   ],
   "prov:generated": [
    {
     "@id": "urn:cwplans:local:data/raw/registry/fsa-branches.json"
    },
    {
     "cwp:pathPattern": "data/raw/registry/fsa-detail/<fhrs_id>.json"
    }
   ],
   "cwp:tool": {
    "@id": "https://github.com/danbri/glitchcan-minigam/blob/master/magpie/cwplans/registry/sources/brands/tools/match-fsa.mjs"
   },
   "cwp:command": "NODE_USE_ENV_PROXY=1 node magpie/cwplans/registry/sources/brands/tools/match-fsa.mjs --fetch",
   "cwp:kind": "join",
   "cwp:rule": [
    "Premises: results[pc].fsa.items of postcodes/queries.json for postcodes in tiers cw-core, cw-ward, cw-box-other-ward.",
    "Name variants (full, cut, strip, prefix) are tried in order; a hit must be 'primary' or 'alternate'.",
    "Hits are ranked: primary before alternate, then key=value fitting the FSA business type, then scope uk.",
    "A 'prefix' variant, an alternate hit or a type that does not fit needs a decision in fsa-decisions.json; undecided and rejected matches are listed apart.",
    "Cache: each premises detail is stored in data/raw/registry/fsa-detail/<fhrs_id>.json and not fetched again.",
    "Network: FSA API with x-api-version 2 and User-Agent glitchcan-cwplans/0.1, 0.6 s pause after each new detail; no retry."
   ],
   "cwp:network": true,
   "cwp:deterministic": false,
   "cwp:after": [
    {
     "@id": "https://danbri.github.io/glitchcan-minigam/magpie/cwplans/data-register.json#activity/postcodes-build"
    },
    {
     "@id": "https://danbri.github.io/glitchcan-minigam/magpie/cwplans/data-register.json#activity/postcodes-query"
    },
    {
     "@id": "https://danbri.github.io/glitchcan-minigam/magpie/cwplans/data-register.json#activity/build-uk-brands"
    }
   ],
   "cwp:area": "brands",
   "cwp:fault": [],
   "cwp:judgement": "A prefix-variant, alternate or type-mismatch match is decided by hand in registry/sources/brands/tools/fsa-decisions.json (manual activity brand-decisions)."
  },
