# =============================================================================
# Paris Conference 1951 - Page Image Index
# "Les Machines a Calculer et la Pensee Humaine"
# Computing Machines and Human Thought
# Institut Blaise Pascal, CNRS, Paris, 8-13 January 1951
# =============================================================================

# -----------------------------------------------------------------------------
# Custom Vocabulary (Warren/McCarthy style)
# -----------------------------------------------------------------------------

pc51:PageImage a rdfs:Class ;
    rdfs:label "Conference Page Image"@en ;
    rdfs:comment "A scanned page image from the 1951 Paris conference proceedings"@en .

pc51:pageNumber a rdf:Property ;
    rdfs:label "page number"@en ;
    rdfs:domain pc51:PageImage ;
    rdfs:range xsd:integer .

pc51:contentType a rdf:Property ;
    rdfs:label "content type"@en ;
    rdfs:comment "Type of content on the page: programme, participant-list, abstract, paper, administrative, etc."@en .

pc51:sessionSection a rdf:Property ;
    rdfs:label "session section"@en ;
    rdfs:comment "Conference section: section-1 (machines), section-2 (applications), section-3 (logic/nervous system)"@en .

pc51:author a rdf:Property ;
    rdfs:label "author"@en ;
    rdfs:comment "Author of the paper or communication on this page"@en .

pc51:paperTitle a rdf:Property ;
    rdfs:label "paper title"@en ;
    rdfs:comment "Title of the paper or communication"@en .

pc51:hasTranscription a rdf:Property ;
    rdfs:label "has transcription"@en ;
    rdfs:comment "Link to markdown transcription file"@en .

pc51:isTranslationOf a rdf:Property ;
    rdfs:label "is translation of"@en ;
    rdfs:comment "This page is a translation of another page"@en .

# -----------------------------------------------------------------------------
# The Conference Event
# -----------------------------------------------------------------------------

pc51:Conference1951 a schema:Event ;
    dc:title "Les Machines a Calculer et la Pensee Humaine"@fr ;
    dc:title "Computing Machines and Human Thought"@en ;
    dc:description "International Colloquium on Computing Machines and Human Thought, organized by Institut Blaise Pascal, CNRS"@en ;
    dc:date "1951-01-08/1951-01-13" ;
    schema:startDate "1951-01-08"^^xsd:date ;
    schema:endDate "1951-01-13"^^xsd:date ;
    schema:location "Paris, France" ;
    dc:publisher "Institut Blaise Pascal, CNRS" ;
    foaf:topic "computing machines", "cybernetics", "nervous system", "human thought" .

# -----------------------------------------------------------------------------
# The Source PDF Document
# -----------------------------------------------------------------------------

pc51:SourcePDF a foaf:Document ;
    dc:title "Conference Proceedings - Les Machines a Calculer et la Pensee Humaine"@fr ;
    dc:format "application/pdf" ;
    dc:source "Computer History Museum archive" ;
    dc:identifier "102805935-05-01-acc.pdf" ;
    dcterms:extent "128 pages" ;
    dc:relation pc51:Conference1951 .

