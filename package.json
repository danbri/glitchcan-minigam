{
  "name": "glitchcan-minigam",
  "version": "1.0.0",
  "description": "A halfbaked [collection](https://danbri.github.io/glitchcan-minigam/) of very experimental browser-based minigames, sloppy by design. Investigating possibilities around player-generated sloppy AI minigames within a larger framework.",
  "main": "index.js",
  "scripts": {
    "pretest": "bash setup-chrome.sh || true",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:fink": "playwright test tests/fink-player.spec.js",
    "test:gridluck": "playwright test tests/gridluck.spec.js",
    "test:smoke": "playwright test tests/minigames-smoke.spec.js",
    "test:lucid": "playwright test tests/lucid-sdf.spec.js tests/dsl-parser.test.js tests/glsl-codegen.test.js",
    "test:lucid:unit": "playwright test tests/dsl-parser.test.js tests/glsl-codegen.test.js",
    "test:lucid:smoke": "playwright test tests/lucid-sdf.spec.js",
    "test:edot": "node magpie/edot/run-tests.mjs",
    "test:debug": "playwright test --debug",
    "test:report": "playwright show-report",
    "server": "python -m http.server 8080",
    "setup-chrome": "bash setup-chrome.sh",
    "test:core": "npx vitest run tests/lucid-core.test.js tests/lucid-codegen-parity.test.js --reporter=dot",
    "test:core:watch": "npx vitest tests/lucid-core.test.js",
    "test:tier1": "npm run test:core",
    "test:tier2": "npm run test:lucid:unit",
    "test:tier3": "npm run test:lucid",
    "test:precommit": "npm run test:core 2>&1 | tail -5",
    "test:parity": "npx vitest run tests/lucid-codegen-parity.test.js --reporter=dot",
    "fink:vars": "node inklet/tools/fink-vars.mjs",
    "fink:vars:strict": "node inklet/tools/fink-vars.mjs --strict",
    "fink:check": "node inklet/tools/fink-check.mjs",
    "skills:check": "node tools/check-skills.mjs",
    "test:backticks": "node packages/backticks/test/run.js",
    "test:finkcore": "node packages/finkcore/test/run.js",
    "test:fink:kernels": "npm run test:backticks && npm run test:finkcore",
    "fink:map": "node inklet/tools/fink-minigame-map.mjs",
    "fink:universe": "node inklet/tools/fink-universe.mjs",
    "test:play": "node inklet/finkapp/test/play-skydock.mjs",
    "test:ride": "node magpie/dbdb/tools/test-ride-home.mjs",
    "test:npc": "node magpie/dbdb/tools/test-npc-routes.mjs",
    "test:quality": "node magpie/dbdb/tools/test-quality-ladder.mjs",
    "test:catalog": "node magpie/dbdb/tools/test-catalog.mjs",
    "pack:lod": "node magpie/dbdb/tools/pack-lod.mjs",
    "splat:objects": "node magpie/dbdb/tools/object-scout.mjs",
    "splat:sources": "node magpie/dbdb/tools/splat-scout.mjs",
    "splat:wanted": "node magpie/dbdb/tools/splat-scout.mjs --wants",
    "splat:ingest": "node magpie/dbdb/tools/splat-ingest.mjs",
    "splat:index": "node magpie/dbdb/tools/asset-index.mjs",
    "splat:view": "npx -y @playcanvas/splat-transform -w -q -g cpu",
    "splat:sheet": "node magpie/dbdb/tools/element-sheet.mjs",
    "splat:thumbs": "node magpie/dbdb/tools/element-sheet.mjs --angles 1 --cell 400 --format webp --out magpie/dbdb/splats/pack/thumbs",
    "splat:style": "node magpie/dbdb/tools/style-probe.mjs",
    "test:fink:e2e": "node inklet/finkapp/test/e2e.mjs && node inklet/finkapp/test/e2e-wm.mjs && node inklet/finkapp/test/e2e-robbin.mjs && node inklet/finkapp/test/e2e-waterworld.mjs && node inklet/finkapp/test/e2e-bus.mjs && node inklet/finkapp/test/e2e-storyrunner.mjs && node inklet/finkapp/test/e2e-foafos.mjs && node inklet/finkapp/test/e2e-dream.mjs && node inklet/finkapp/test/e2e-vars.mjs && node inklet/finkapp/test/e2e-boidwars.mjs && node inklet/finkapp/test/e2e-input.mjs && node inklet/finkapp/test/e2e-audio-leak.mjs && node inklet/finkapp/test/e2e-caps.mjs && node inklet/finkapp/test/e2e-root.mjs && node inklet/finkapp/test/e2e-snapshot.mjs && node inklet/finkapp/test/e2e-chrome.mjs && node inklet/finkapp/test/e2e-desktop.mjs && node inklet/finkapp/test/e2e-conformance.mjs && node inklet/finkapp/test/e2e-instances.mjs && node inklet/finkapp/test/skins-a11y.mjs && node inklet/finkapp/test/aria-audit.mjs && node inklet/finkapp/test/play-skydock.mjs",
    "test:fink:qa": "node inklet/finkapp/test/qa-journey.mjs && node inklet/finkapp/test/qa-games.mjs"
  },
  "repository": {
    "type": "git",
    "url": "http://local_proxy@127.0.0.1:20502/git/danbri/glitchcan-minigam"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "inkjs": "^2.3.2",
    "playwright": "^1.57.0",
    "puppeteer-core": "^24.35.0"
  },
  "dependencies": {
    "osm-pbf-parser": "^2.3.0",
    "three": "^0.169.0",
    "through2": "^5.0.1"
  }
}
