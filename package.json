{
  "name": "glitchcan-minigam",
  "version": "1.0.0",
  "description": "A halfbaked [collection](https://danbri.github.io/glitchcan-minigam/) of very experimental browser-based minigames, sloppy by design. Investigating possibilities around player-generated sloppy AI minigames within a larger framework.",
  "main": "index.js",
  "scripts": {
    "pretest": "bash setup-chrome.sh || true",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:fink": "playwright test tests/fink-player.spec.js",
    "test:gridluck": "playwright test tests/gridluck.spec.js",
    "test:smoke": "playwright test tests/minigames-smoke.spec.js",
    "test:lucid": "playwright test tests/lucid-sdf.spec.js tests/dsl-parser.test.js tests/glsl-codegen.test.js",
    "test:lucid:unit": "playwright test tests/dsl-parser.test.js tests/glsl-codegen.test.js",
    "test:lucid:smoke": "playwright test tests/lucid-sdf.spec.js",
    "test:debug": "playwright test --debug",
    "test:report": "playwright show-report",
    "server": "python -m http.server 8080",
    "setup-chrome": "bash setup-chrome.sh",
    "test:core": "npx vitest run tests/lucid-core.test.js --reporter=dot",
    "test:core:watch": "npx vitest tests/lucid-core.test.js",
    "test:tier1": "npm run test:core",
    "test:tier2": "npm run test:lucid:unit",
    "test:tier3": "npm run test:lucid",
    "test:precommit": "npm run test:core 2>&1 | tail -5"
  },
  "repository": {
    "type": "git",
    "url": "http://local_proxy@127.0.0.1:20502/git/danbri/glitchcan-minigam"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "inkjs": "^2.3.2",
    "playwright": "^1.57.0",
    "puppeteer-core": "^24.35.0"
  }
}
