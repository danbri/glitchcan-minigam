{
  "name": "danjabeep",
  "version": "1.0.0",
  "description": "JavaScript port of WebBeep - Audio string encoder using pentatonic FSK",
  "type": "module",
  "main": "encoder.js",
  "exports": {
    ".": "./encoder.js",
    "./encoder": "./encoder.js",
    "./decoder": "./decoder.js",
    "./constants": "./constants.js",
    "./maps": "./maps.js",
    "./wavemaker": "./wavemaker.js",
    "./goertzel": "./goertzel.js"
  },
  "scripts": {
    "test": "node test.mjs",
    "test:browser": "npx playwright test test-browser.spec.mjs",
    "serve": "npx http-server -p 8080 .."
  },
  "keywords": [
    "audio",
    "encoding",
    "fsk",
    "webbeep",
    "pentatonic",
    "goertzel"
  ],
  "author": "Danny Ayers (original Java), ported to JS",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/danja/WebBeep"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0"
  }
}
