{
  "title": "Ellipsoid Demo",
  "subtitle": "Stretched spheres with different radii",
  "version": "1.1",

  "params": {
    "stretchFactor": {
      "value": 0.8,
      "type": "scalar",
      "min": 0.3,
      "max": 1.5,
      "description": "Maximum stretch amount"
    },
    "color1": {
      "value": [1, 0.5, 0.2],
      "type": "color3",
      "description": "Left ellipsoid color"
    },
    "color2": {
      "value": [0.2, 0.8, 0.5],
      "type": "color3",
      "description": "Middle ellipsoid color"
    },
    "color3": {
      "value": [0.5, 0.3, 1],
      "type": "color3",
      "description": "Right ellipsoid color"
    }
  },

  "root": {
    "type": "union",
    "children": [
      { "type": "ellipsoid", "params": { "radii": [{"var": "stretchFactor"}, 0.3, 0.3], "color": {"var": "color1"} }, "transform": { "translate": [-1.5, 0, 0] } },
      { "type": "ellipsoid", "params": { "radii": [0.4, {"var": "stretchFactor"}, 0.4], "color": {"var": "color2"} }, "transform": { "translate": [0, 0, 0] } },
      { "type": "ellipsoid", "params": { "radii": [0.3, 0.3, {"var": "stretchFactor"}], "color": {"var": "color3"} }, "transform": { "translate": [1.5, 0, 0] } }
    ]
  }
}
