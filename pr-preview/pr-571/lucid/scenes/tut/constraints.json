{
  "title": "Physical Constraints Tutorial",
  "subtitle": "Robotic arm with angle limits and coupling",
  "version": "1.0",
  "notes": "Demonstrates constraint enforcement: sliders respect physical limits and coupled parameters adjust automatically. Try pushing shoulderAngle past 120° - elbowAngle will auto-reduce to prevent collision.",
  "camera": { "distance": 8, "phi": 0.3, "theta": 0.4, "target": [0, 0.5, 0] },

  "params": {
    "shoulderAngle": {
      "value": 45,
      "type": "scalar",
      "min": 0,
      "max": 180,
      "description": "Upper arm rotation (degrees)",
      "units": "degrees"
    },
    "elbowAngle": {
      "value": 90,
      "type": "scalar",
      "min": 0,
      "max": 135,
      "description": "Elbow bend (0=straight, 135=max)",
      "units": "degrees"
    },
    "wristAngle": {
      "value": 0,
      "type": "scalar",
      "min": -45,
      "max": 45,
      "description": "Wrist rotation",
      "units": "degrees"
    },
    "gripperOpen": {
      "value": 0.4,
      "type": "scalar",
      "min": 0.0,
      "max": 1.0,
      "description": "Gripper openness (0=closed, 1=open)"
    },
    "armLength": {
      "value": 1.5,
      "type": "scalar",
      "min": 1.0,
      "max": 2.5,
      "description": "Upper/lower arm segment length"
    },
    "armThickness": {
      "value": 0.12,
      "type": "scalar",
      "min": 0.06,
      "max": 0.25,
      "description": "Arm segment radius"
    },
    "armColor": {
      "value": [0.7, 0.7, 0.75],
      "type": "color3",
      "description": "Metal arm color"
    },
    "jointColor": {
      "value": [0.3, 0.3, 0.35],
      "type": "color3",
      "description": "Joint color (darker)"
    }
  },

  "rig": {
    "constraints": {
      "elbowAngle": {
        "min": 0,
        "max": 135,
        "reason": "Human elbow cannot hyperextend past 135°",
        "severity": "HIGH"
      },
      "shoulderElbowCoupling": {
        "type": "coupled",
        "driver": "shoulderAngle",
        "follower": "elbowAngle",
        "rule": "when shoulderAngle > 120, elbowAngle.max = 135 - (shoulderAngle - 120) * 1.5",
        "reason": "Prevent forearm collision with upper arm",
        "severity": "HIGH"
      }
    },
    "derived": {
      "forearmTip": {
        "description": "Distance from shoulder to fingertips (for reach calculation)",
        "expr": { "expr": "mul", "args": [{ "var": "armLength" }, 2.1] }
      },
      "effectiveReach": {
        "description": "Horizontal reach based on current pose",
        "expr": {
          "expr": "mul",
          "args": [
            { "var": "armLength" },
            { "expr": "add", "args": [
              { "expr": "cos", "args": [{ "expr": "mul", "args": [{ "var": "shoulderAngle" }, 0.0175] }] },
              { "expr": "cos", "args": [{ "expr": "mul", "args": [{ "var": "elbowAngle" }, 0.0175] }] }
            ]}
          ]
        }
      }
    }
  },

  "defs": {
    "joint": {
      "type": "sphere",
      "params": {
        "r": { "expr": "mul", "args": [{ "var": "armThickness" }, 1.3] },
        "color": { "var": "jointColor" }
      }
    },
    "armSegment": {
      "type": "capsule",
      "params": {
        "h": { "var": "armLength" },
        "r": { "var": "armThickness" },
        "color": { "var": "armColor" }
      }
    }
  },

  "root": {
    "type": "union",
    "children": [
      {
        "comment": "=== BASE MOUNT ===",
        "type": "union",
        "children": [
          {
            "type": "cylinder",
            "params": { "h": 0.3, "r": 0.5, "color": [0.2, 0.2, 0.25] }
          },
          {
            "type": "cylinder",
            "params": { "h": 0.1, "r": 0.35, "color": [0.25, 0.25, 0.3] },
            "transform": { "translate": [0, 0.2, 0] }
          }
        ]
      },
      {
        "comment": "=== SHOULDER JOINT ===",
        "type": "ref",
        "id": "joint",
        "transform": { "translate": [0, 0.35, 0] }
      },
      {
        "comment": "=== UPPER ARM (rotates with shoulder) ===",
        "type": "transform",
        "transform": {
          "translate": [0, 0.35, 0],
          "rotate": [0, 0, { "var": "shoulderAngle" }]
        },
        "child": {
          "type": "union",
          "children": [
            {
              "type": "ref",
              "id": "armSegment",
              "transform": {
                "translate": [{ "expr": "div", "args": [{ "var": "armLength" }, 2] }, 0, 0],
                "rotate": [0, 0, 90]
              }
            },
            {
              "comment": "=== ELBOW JOINT ===",
              "type": "ref",
              "id": "joint",
              "transform": { "translate": [{ "var": "armLength" }, 0, 0] }
            },
            {
              "comment": "=== FOREARM (rotates with elbow) ===",
              "type": "transform",
              "transform": {
                "translate": [{ "var": "armLength" }, 0, 0],
                "rotate": [0, 0, { "expr": "neg", "args": [{ "var": "elbowAngle" }] }]
              },
              "child": {
                "type": "union",
                "children": [
                  {
                    "type": "ref",
                    "id": "armSegment",
                    "transform": {
                      "translate": [{ "expr": "div", "args": [{ "var": "armLength" }, 2] }, 0, 0],
                      "rotate": [0, 0, 90]
                    }
                  },
                  {
                    "comment": "=== WRIST JOINT ===",
                    "type": "ref",
                    "id": "joint",
                    "transform": { "translate": [{ "var": "armLength" }, 0, 0] }
                  },
                  {
                    "comment": "=== GRIPPER (rotates with wrist) ===",
                    "type": "transform",
                    "transform": {
                      "translate": [{ "var": "armLength" }, 0, 0],
                      "rotate": [0, { "var": "wristAngle" }, 0]
                    },
                    "child": {
                      "type": "union",
                      "children": [
                        {
                          "comment": "Gripper base",
                          "type": "box",
                          "params": {
                            "size": [0.15, 0.08, 0.12],
                            "color": { "var": "jointColor" }
                          },
                          "transform": { "translate": [0.08, 0, 0] }
                        },
                        {
                          "comment": "Gripper finger 1",
                          "type": "capsule",
                          "params": { "h": 0.25, "r": 0.03, "color": { "var": "armColor" } },
                          "transform": {
                            "translate": [
                              0.22,
                              0,
                              { "expr": "mul", "args": [{ "var": "gripperOpen" }, 0.08] }
                            ],
                            "rotate": [0, 0, 90]
                          }
                        },
                        {
                          "comment": "Gripper finger 2",
                          "type": "capsule",
                          "params": { "h": 0.25, "r": 0.03, "color": { "var": "armColor" } },
                          "transform": {
                            "translate": [
                              0.22,
                              0,
                              { "expr": "neg", "args": [{ "expr": "mul", "args": [{ "var": "gripperOpen" }, 0.08] }] }
                            ],
                            "rotate": [0, 0, 90]
                          }
                        }
                      ]
                    }
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "comment": "=== GROUND PLANE ===",
        "type": "plane",
        "params": { "normal": [0, 1, 0], "h": 0, "color": [0.4, 0.4, 0.45] }
      }
    ]
  }
}
