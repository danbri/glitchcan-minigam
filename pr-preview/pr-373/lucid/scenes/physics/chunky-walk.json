{
  "title": "Chunky Walk",
  "subtitle": "WebGPU XPBD physics with rig-driven foot targets",
  "version": "1.0",
  "description": "Feet step up/down via rig phase, body responds via physics constraints",
  "camera": { "distance": 5, "phi": 0.3, "theta": 0.3, "target": [0, 0, 0] },

  "params": {
    "walkSpeed": { "value": 2.0, "min": 0, "max": 6, "description": "Gait cycle speed" },
    "stepHeight": { "value": 0.3, "min": 0, "max": 0.6, "description": "How high feet lift" },
    "bodyColor": { "value": [0.6, 0.55, 0.5], "type": "color3" },
    "legColor": { "value": [0.5, 0.45, 0.4], "type": "color3" }
  },

  "rig": {
    "phase": {
      "gait": {
        "comment": "Quadruped diagonal gait - drives foot lift height",
        "driver": { "expr": "mul", "args": ["time", "walkSpeed"] },
        "followers": {
          "footFL_lift": { "phase": 0, "amplitude": "stepHeight", "waveform": "step" },
          "footRR_lift": { "phase": 0, "amplitude": "stepHeight", "waveform": "step" },
          "footFR_lift": { "phase": 0.5, "amplitude": "stepHeight", "waveform": "step" },
          "footRL_lift": { "phase": 0.5, "amplitude": "stepHeight", "waveform": "step" }
        }
      }
    }
  },

  "physics": {
    "enabled": true,
    "gravity": [0, -15, 0],
    "groundY": -1.5,
    "damping": 0.95,
    "iterations": 10,
    "dt": 0.016,

    "bodies": [
      { "name": "body", "pos": [0, 0.5, 0], "mass": 3.0, "radius": 0.35 },
      { "name": "footFL", "pos": [0.4, -0.8, 0.5], "mass": 0.5, "radius": 0.1 },
      { "name": "footFR", "pos": [-0.4, -0.8, 0.5], "mass": 0.5, "radius": 0.1 },
      { "name": "footRL", "pos": [0.4, -0.8, -0.5], "mass": 0.5, "radius": 0.1 },
      { "name": "footRR", "pos": [-0.4, -0.8, -0.5], "mass": 0.5, "radius": 0.1 }
    ],

    "distanceConstraints": [
      { "bodyA": "body", "bodyB": "footFL", "compliance": 0.001 },
      { "bodyA": "body", "bodyB": "footFR", "compliance": 0.001 },
      { "bodyA": "body", "bodyB": "footRL", "compliance": 0.001 },
      { "bodyA": "body", "bodyB": "footRR", "compliance": 0.001 }
    ],

    "positionConstraints": [
      { "body": "footFL", "compliance": 0.01, "rigTarget": "gait_footFL_lift", "baseY": -0.8 },
      { "body": "footFR", "compliance": 0.01, "rigTarget": "gait_footFR_lift", "baseY": -0.8 },
      { "body": "footRL", "compliance": 0.01, "rigTarget": "gait_footRL_lift", "baseY": -0.8 },
      { "body": "footRR", "compliance": 0.01, "rigTarget": "gait_footRR_lift", "baseY": -0.8 }
    ]
  },

  "defs": {
    "foot": {
      "type": "material",
      "params": { "color": { "var": "legColor" } },
      "child": {
        "type": "sphere",
        "params": { "r": 0.12 }
      }
    }
  },

  "root": {
    "type": "smoothUnion", "k": 0.15,
    "children": [
      {
        "comment": "Body - position from physics",
        "type": "transform",
        "transform": { "translate": { "var": "phys_body" } },
        "child": {
          "type": "material",
          "params": { "color": { "var": "bodyColor" } },
          "child": {
            "type": "smoothUnion", "k": 0.2,
            "children": [
              { "type": "ellipsoid", "params": { "radii": [0.5, 0.4, 0.7] } },
              {
                "type": "ellipsoid",
                "params": { "radii": [0.25, 0.22, 0.25] },
                "transform": { "translate": [0, 0.1, 0.8] }
              }
            ]
          }
        }
      },
      {
        "type": "transform",
        "transform": { "translate": { "var": "phys_footFL" } },
        "child": { "type": "ref", "id": "foot" }
      },
      {
        "type": "transform",
        "transform": { "translate": { "var": "phys_footFR" } },
        "child": { "type": "ref", "id": "foot" }
      },
      {
        "type": "transform",
        "transform": { "translate": { "var": "phys_footRL" } },
        "child": { "type": "ref", "id": "foot" }
      },
      {
        "type": "transform",
        "transform": { "translate": { "var": "phys_footRR" } },
        "child": { "type": "ref", "id": "foot" }
      }
    ]
  }
}
