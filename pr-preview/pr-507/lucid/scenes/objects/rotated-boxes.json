{
  "version": "1.1",
  "title": "Rotated Boxes",
  "description": "Boxes at various rotation angles",

  "params": {
    "boxLength": {
      "value": 0.6,
      "type": "scalar",
      "min": 0.3,
      "max": 1.0,
      "description": "Box length"
    },
    "boxHeight": {
      "value": 0.1,
      "type": "scalar",
      "min": 0.05,
      "max": 0.2,
      "description": "Box height"
    },
    "baseColor": {
      "value": [1.0, 0.5, 0.2],
      "type": "color3",
      "description": "Rainbow start color"
    }
  },

  "defs": {
    "elongBox": {
      "type": "box",
      "params": {
        "size": [{"var": "boxLength"}, {"var": "boxHeight"}, 0.15]
      }
    }
  },
  "root": {
    "type": "union",
    "children": [
      {
        "type": "ref",
        "id": "elongBox",
        "transform": {
          "translate": [0, 0.5, 0],
          "rotate": [0, 0, 0]
        },
        "params": { "color": [1.0, 0.2, 0.2] }
      },
      {
        "type": "ref",
        "id": "elongBox",
        "transform": {
          "translate": [0, 0.25, 0],
          "rotate": [0, 30, 0]
        },
        "params": { "color": [1.0, 0.5, 0.2] }
      },
      {
        "type": "ref",
        "id": "elongBox",
        "transform": {
          "translate": [0, 0, 0],
          "rotate": [0, 60, 0]
        },
        "params": { "color": [1.0, 1.0, 0.2] }
      },
      {
        "type": "ref",
        "id": "elongBox",
        "transform": {
          "translate": [0, -0.25, 0],
          "rotate": [0, 90, 0]
        },
        "params": { "color": [0.2, 1.0, 0.2] }
      },
      {
        "type": "ref",
        "id": "elongBox",
        "transform": {
          "translate": [0, -0.5, 0],
          "rotate": [0, 120, 0]
        },
        "params": { "color": [0.2, 0.5, 1.0] }
      },
      {
        "type": "ref",
        "id": "elongBox",
        "transform": {
          "translate": [0, -0.75, 0],
          "rotate": [0, 150, 0]
        },
        "params": { "color": [0.8, 0.2, 1.0] }
      }
    ]
  }
}
