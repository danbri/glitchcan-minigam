{
  "name": "Simple Sphere",
  "description": "Basic sphere primitive for performance baseline testing",
  "camera": {
    "distance": 4,
    "theta": 0.3,
    "phi": 0.4,
    "target": [0, 0, 0]
  },
  "params": {
    "radius": {
      "type": "scalar",
      "value": 1.0,
      "min": 0.1,
      "max": 3.0
    }
  },
  "root": {
    "type": "sphere",
    "params": {
      "r": { "var": "radius" },
      "color": [0.3, 0.6, 0.9]
    }
  }
}
