{
  "title": "Elite Wireframe",
  "subtitle": "ZX Spectrum style spaceship with mirror symmetry",
  "version": "1.1",
  "notes": "Cobra-style ship. Capsules are Y-aligned by default, so [90,theta,0] lays them flat in XZ plane at angle theta",

  "params": {
    "rotationSpeed": {
      "value": 20,
      "type": "scalar",
      "min": 0,
      "max": 60,
      "description": "Ship rotation speed"
    },
    "wireColor": {
      "value": [0.2, 1.0, 0.3],
      "type": "color3",
      "description": "Wireframe color"
    },
    "wireThickness": {
      "value": 0.02,
      "type": "scalar",
      "min": 0.01,
      "max": 0.05,
      "description": "Wire thickness"
    }
  },

  "root": {
    "type": "transform",
    "transform": {
      "rotate": [0, { "expr": "mul", "args": [{"var": "rotationSpeed"}, { "var": "time" }] }, 0]
    },
    "child": {
      "type": "mirror",
      "axis": "x",
      "child": {
        "type": "union",
        "children": [
          {
            "notes": "Nose to wing tip - diagonal in XZ plane",
            "type": "capsule",
            "params": { "h": 0.9, "r": {"var": "wireThickness"}, "color": {"var": "wireColor"} },
            "transform": { "translate": [0.45, 0, 0.3], "rotate": [90, -60, 0] }
          },
          {
            "notes": "Wing tip to rear corner - along Z",
            "type": "capsule",
            "params": { "h": 0.5, "r": {"var": "wireThickness"}, "color": {"var": "wireColor"} },
            "transform": { "translate": [0.9, 0, -0.3], "rotate": [90, 0, 0] }
          },
          {
            "notes": "Rear corner to center rear - along X",
            "type": "capsule",
            "params": { "h": 0.45, "r": {"var": "wireThickness"}, "color": {"var": "wireColor"} },
            "transform": { "translate": [0.45, 0, -0.8], "rotate": [0, 0, 90] }
          },
          {
            "notes": "Center rear spine - along Z",
            "type": "capsule",
            "params": { "h": 0.6, "r": {"var": "wireThickness"}, "color": {"var": "wireColor"} },
            "transform": { "translate": [0, 0, 0.5], "rotate": [90, 0, 0] }
          },
          {
            "notes": "Cockpit front strut - angled up from nose",
            "type": "capsule",
            "params": { "h": 0.25, "r": {"var": "wireThickness"}, "color": {"var": "wireColor"} },
            "transform": { "translate": [0, 0.12, 0.85], "rotate": [30, 0, 0] }
          },
          {
            "notes": "Cockpit top - along Z",
            "type": "capsule",
            "params": { "h": 0.35, "r": {"var": "wireThickness"}, "color": {"var": "wireColor"} },
            "transform": { "translate": [0, 0.2, 0.35], "rotate": [90, 0, 0] }
          },
          {
            "notes": "Cockpit rear strut - angled down",
            "type": "capsule",
            "params": { "h": 0.25, "r": {"var": "wireThickness"}, "color": {"var": "wireColor"} },
            "transform": { "translate": [0, 0.1, -0.1], "rotate": [-30, 0, 0] }
          },
          {
            "notes": "Cockpit side - along X from center",
            "type": "capsule",
            "params": { "h": 0.15, "r": {"var": "wireThickness"}, "color": {"var": "wireColor"} },
            "transform": { "translate": [0.08, 0.2, 0.5], "rotate": [0, 0, 90] }
          },
          {
            "notes": "Engine strut - vertical",
            "type": "capsule",
            "params": { "h": 0.12, "r": {"var": "wireThickness"}, "color": {"var": "wireColor"} },
            "transform": { "translate": [0.5, 0, -0.7] }
          },
          {
            "notes": "Engine glow ring",
            "type": "torus",
            "params": { "major": 0.1, "minor": 0.02, "color": [1.0, 0.5, 0.1] },
            "transform": { "translate": [0.5, 0, -0.85], "rotate": [90, 0, 0] }
          }
        ]
      }
    }
  }
}
