{
  "title": "Puppy",
  "subtitle": "Parametric quadruped - dog preset",
  "version": "1.0",
  "camera": { "distance": 8, "phi": 0.3, "theta": 0.25, "target": [0, 0, 0] },
  "notes": "Generic quadruped body plan from yeti web components, configured as a cute puppy.",

  "params": {
    "smooth": { "value": 0.15, "type": "scalar", "min": 0.05, "max": 0.4, "description": "Smooth union blending" },
    "bodyColor": { "value": [0.65, 0.55, 0.4], "type": "color3", "description": "Body fur color" },
    "tailWag": { "value": 0.0, "type": "scalar", "min": -0.5, "max": 0.5, "description": "Tail wag angle" }
  },

  "root": {
    "type": "smoothUnion",
    "k": { "var": "smooth" },
    "children": [
      {
        "comment": "Body core",
        "type": "ellipsoid",
        "params": { "radii": [0.5, 0.45, 0.9], "color": { "var": "bodyColor" } }
      },
      {
        "comment": "Rump",
        "type": "ellipsoid",
        "params": { "radii": [0.45, 0.4, 0.5], "color": { "var": "bodyColor" } },
        "transform": { "translate": [0, 0.05, -0.9] }
      },
      {
        "comment": "Head",
        "type": "ellipsoid",
        "params": { "radii": [0.28, 0.26, 0.32], "color": { "var": "bodyColor" } },
        "transform": { "translate": [0, 0.35, 1.1] }
      },
      {
        "comment": "Snout",
        "type": "ellipsoid",
        "params": { "radii": [0.12, 0.1, 0.28], "color": { "var": "bodyColor" } },
        "transform": { "translate": [0, 0.22, 1.45] }
      },
      {
        "comment": "Nose",
        "type": "sphere",
        "params": { "r": 0.06, "color": [0.1, 0.08, 0.08] },
        "transform": { "translate": [0, 0.22, 1.72] }
      },
      {
        "comment": "Ear L - floppy dog ears",
        "type": "ellipsoid",
        "params": { "radii": [0.08, 0.18, 0.06], "color": { "var": "bodyColor" } },
        "transform": { "translate": [0.18, 0.58, 0.95], "rotate": [0.3, 0, 0.2] }
      },
      {
        "comment": "Ear R",
        "type": "ellipsoid",
        "params": { "radii": [0.08, 0.18, 0.06], "color": { "var": "bodyColor" } },
        "transform": { "translate": [-0.18, 0.58, 0.95], "rotate": [0.3, 0, -0.2] }
      },
      {
        "comment": "Front leg L",
        "type": "roundCone",
        "params": { "r1": 0.12, "r2": 0.06, "h": 0.55, "color": { "var": "bodyColor" } },
        "transform": { "translate": [0.22, -0.55, 0.4] }
      },
      {
        "comment": "Front leg R",
        "type": "roundCone",
        "params": { "r1": 0.12, "r2": 0.06, "h": 0.55, "color": { "var": "bodyColor" } },
        "transform": { "translate": [-0.22, -0.55, 0.4] }
      },
      {
        "comment": "Back leg L",
        "type": "roundCone",
        "params": { "r1": 0.12, "r2": 0.06, "h": 0.6, "color": { "var": "bodyColor" } },
        "transform": { "translate": [0.22, -0.55, -0.8], "rotate": [0.15, 0, 0] }
      },
      {
        "comment": "Back leg R",
        "type": "roundCone",
        "params": { "r1": 0.12, "r2": 0.06, "h": 0.6, "color": { "var": "bodyColor" } },
        "transform": { "translate": [-0.22, -0.55, -0.8], "rotate": [0.15, 0, 0] }
      },
      {
        "comment": "Tail - wagging tail",
        "type": "capsule",
        "params": { "h": 0.4, "r": 0.05, "color": { "var": "bodyColor" } },
        "transform": { "translate": [0, 0.3, -1.25], "rotate": [-0.6, { "var": "tailWag" }, 0] }
      }
    ]
  }
}
