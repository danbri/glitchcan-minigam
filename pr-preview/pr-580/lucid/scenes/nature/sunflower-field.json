{
  "title": "Sunflower Field",
  "subtitle": "Infinite flowers via repeat + radial (static)",
  "version": "1.2",
  "notes": "Animation disabled - was causing distortion with repeat+radial combination",

  "params": {
    "petalColor": {
      "value": [1.0, 0.8, 0.1],
      "type": "color3",
      "description": "Petal color"
    },
    "centerColor": {
      "value": [0.45, 0.3, 0.1],
      "type": "color3",
      "description": "Center color"
    },
    "petalCount": {
      "value": 12,
      "type": "scalar",
      "min": 6,
      "max": 20,
      "description": "Number of petals"
    }
  },

  "defs": {
    "sunflower": {
      "type": "union",
      "children": [
        {
          "type": "sphere",
          "params": { "r": 0.25, "color": {"var": "centerColor"} }
        },
        {
          "type": "radial",
          "count": {"var": "petalCount"},
          "axis": "z",
          "child": {
            "type": "sphere",
            "params": { "r": 0.12, "color": {"var": "petalColor"} },
            "transform": { "translate": [0.35, 0, 0] }
          }
        }
      ]
    }
  },
  "root": {
    "type": "repeat",
    "period": [2.5, 0, 2.5],
    "child": { "type": "ref", "id": "sunflower" },
    "transform": { "translate": [0, 0.35, 0] }
  }
}
