{
  "title": "Fearsome Wolf",
  "subtitle": "v2.0 - Walk cycle + body sway",
  "version": "2.0",
  "camera": { "distance": 12, "phi": 0.3, "theta": 0.25, "target": [0, 0.5, 0] },
  "notes": "Parametric wolf with walk cycle animation, body sway, fang controls and color customization. Legs use diagonal pair phasing for realistic quadruped gait.",

  "params": {
    "_comment_walk": "=== WALK CYCLE PARAMETERS ===",
    "walkSpeed": {
      "value": 2.0,
      "type": "scalar",
      "min": 0,
      "max": 6,
      "description": "Walk animation speed"
    },
    "walkAmplitude": {
      "value": 15,
      "type": "scalar",
      "min": 0,
      "max": 35,
      "description": "Leg swing angle (degrees)"
    },
    "bodySway": {
      "value": 3,
      "type": "scalar",
      "min": 0,
      "max": 12,
      "description": "Body left/right sway (degrees)"
    },

    "_comment_fangs": "=== FANG PARAMETERS ===",
    "fangLength": {
      "value": 0.18,
      "type": "scalar",
      "min": 0.08,
      "max": 0.35,
      "description": "Length of upper canine fangs (Y axis)",
      "units": "meters (relative)"
    },
    "fangWidth": {
      "value": 0.05,
      "type": "scalar",
      "min": 0.02,
      "max": 0.12,
      "description": "Width of fangs (X axis)",
      "units": "meters (relative)"
    },
    "fangDepth": {
      "value": 0.04,
      "type": "scalar",
      "min": 0.02,
      "max": 0.10,
      "description": "Depth/thickness of fangs (Z axis)",
      "units": "meters (relative)"
    },
    "fangSpread": {
      "value": 0.14,
      "type": "scalar",
      "min": 0.08,
      "max": 0.25,
      "description": "Horizontal distance from centerline",
      "units": "meters (relative)"
    },
    "fangDrop": {
      "value": 0.55,
      "type": "scalar",
      "min": 0.30,
      "max": 0.80,
      "description": "Vertical position (lower = more visible below jaw)",
      "units": "meters (relative)"
    },
    "fangForward": {
      "value": 2.95,
      "type": "scalar",
      "min": 2.70,
      "max": 3.20,
      "description": "Forward position along muzzle",
      "units": "meters (relative)"
    },
    "fangTilt": {
      "value": 15,
      "type": "scalar",
      "min": 0,
      "max": 35,
      "description": "Forward tilt angle of fangs",
      "units": "degrees"
    },

    "_comment_eyes": "=== EYE PARAMETERS ===",
    "eyeGlow": {
      "value": 0.7,
      "type": "scalar",
      "min": 0.0,
      "max": 1.5,
      "description": "Eye emission intensity for predator gaze",
      "units": "emission",
      "affects": ["eye material"]
    },

    "_comment_color": "=== COLOR PARAMETERS ===",
    "bodyColor": {
      "value": [0.22, 0.20, 0.18],
      "type": "color3",
      "description": "Main body fur color (dark gray-brown)"
    },
    "headColor": {
      "value": [0.25, 0.23, 0.21],
      "type": "color3",
      "description": "Head fur color (slightly lighter)"
    },
    "hacklesColor": {
      "value": [0.32, 0.30, 0.28],
      "type": "color3",
      "description": "Raised hackles color (lighter tips)"
    },
    "eyeColor": {
      "value": [0.95, 0.5, 0.05],
      "type": "color3",
      "description": "Eye color (amber/orange for wolf)"
    },
    "fangColor": {
      "value": [0.98, 0.96, 0.92],
      "type": "color3",
      "description": "Fang/tooth color (ivory white)"
    },
    "tongueColor": {
      "value": [0.75, 0.20, 0.22],
      "type": "color3",
      "description": "Tongue color (red-pink)"
    },
    "clawColor": {
      "value": [0.06, 0.06, 0.06],
      "type": "color3",
      "description": "Claw color (near black)"
    }
  },

  "rig": {
    "_comment": "Constraints for wolf model",
    "constraints": {
      "fangLength": {
        "min": 0.20,
        "max": 0.35,
        "reason": "Fangs MUST be visible below jaw for fearsome appearance",
        "severity": "CRITICAL"
      }
    }
  },

  "root": {
    "comment": "FEARSOME WOLF - Visible weapons, aggressive stance",
    "type": "smoothUnion", "k": 0.25,
    "children": [
      {
        "comment": "MAIN BODY - v1.6: LEANER torso, less bulbous",
        "type": "material",
        "params": { "color": { "var": "bodyColor" } },
        "child": {
          "type": "displace",
          "amount": 0.08,
          "scale": 5.0,
          "octaves": 2,
          "noiseType": "fbm",
          "child": {
            "type": "smoothUnion", "k": 0.25,
            "children": [
              { "comment": "Chest - lean, athletic + sway", "type": "ellipsoid", "params": { "radii": [0.55, 0.50, 0.9] }, "transform": { "translate": [0, 0.75, 1.0], "rotate": [15, {"expr": "mul", "args": [{"var": "bodySway"}, {"expr": "sin", "args": [{"expr": "mul", "args": [{"var": "time"}, {"var": "walkSpeed"}]}]}]}, 0] } },
              { "comment": "Core torso - elongated", "type": "ellipsoid", "params": { "radii": [0.48, 0.45, 1.2] }, "transform": { "translate": [0, 0.72, -0.3], "rotate": [5, 0, 0] } },
              { "comment": "Hindquarters - athletic + opposite sway", "type": "ellipsoid", "params": { "radii": [0.52, 0.50, 0.85] }, "transform": { "translate": [0, 0.78, -1.4], "rotate": [0, {"expr": "mul", "args": [{"var": "bodySway"}, {"expr": "mul", "args": [-1, {"expr": "sin", "args": [{"expr": "mul", "args": [{"var": "time"}, {"var": "walkSpeed"}]}]}]}]}, 0] } }
            ]
          }
        }
      },
      {
        "comment": "HEAD - lowered attack position with OPEN JAW",
        "type": "material",
        "params": { "color": { "var": "headColor" } },
        "child": {
          "type": "smoothUnion", "k": 0.2,
          "children": [
            { "comment": "Skull - larger", "type": "ellipsoid", "params": { "radii": [0.55, 0.5, 0.6] }, "transform": { "translate": [0, 0.95, 2.0] } },
            { "comment": "Upper muzzle", "type": "ellipsoid", "params": { "radii": [0.26, 0.22, 0.65] }, "transform": { "translate": [0, 0.85, 2.7] } },
            { "comment": "Lower jaw - DROPPED OPEN 35deg", "type": "ellipsoid", "params": { "radii": [0.24, 0.18, 0.55] }, "transform": { "translate": [0, 0.45, 2.55], "rotate": [-35, 0, 0] } },
            { "comment": "Jaw muscle L - MASSIVE", "type": "ellipsoid", "params": { "radii": [0.28, 0.24, 0.28] }, "transform": { "translate": [0.38, 0.95, 1.8] } },
            { "comment": "Jaw muscle R", "type": "ellipsoid", "params": { "radii": [0.28, 0.24, 0.28] }, "transform": { "translate": [-0.38, 0.95, 1.8] } },
            { "comment": "Nose", "type": "sphere", "params": { "r": 0.12, "color": [0.05, 0.05, 0.05] }, "transform": { "translate": [0, 0.82, 3.3] } }
          ]
        }
      },
      {
        "comment": "MOUTH INTERIOR - v1.5: ENLARGED dark cavity",
        "type": "material",
        "params": { "color": [0.05, 0.01, 0.01] },
        "child": {
          "type": "ellipsoid",
          "params": { "radii": [0.28, 0.25, 0.6] },
          "transform": { "translate": [0, 0.52, 2.65] }
        }
      },
      {
        "comment": "TONGUE - red, visible in open mouth",
        "type": "material",
        "params": { "color": { "var": "tongueColor" } },
        "child": {
          "type": "ellipsoid",
          "params": { "radii": [0.12, 0.04, 0.28] },
          "transform": { "translate": [0, 0.56, 2.65] }
        }
      },
      {
        "comment": "FANGS - v1.8: Parametric, properly sized canines",
        "type": "material",
        "params": { "color": { "var": "fangColor" }, "emit": 0.15 },
        "child": {
          "type": "union",
          "children": [
            {
              "comment": "Upper left canine",
              "type": "ellipsoid",
              "params": {
                "radii": [
                  { "var": "fangWidth" },
                  { "var": "fangLength" },
                  { "var": "fangDepth" }
                ]
              },
              "transform": {
                "translate": [
                  { "var": "fangSpread" },
                  { "var": "fangDrop" },
                  { "var": "fangForward" }
                ],
                "rotate": [{ "var": "fangTilt" }, 0, 8]
              }
            },
            {
              "comment": "Upper right canine",
              "type": "ellipsoid",
              "params": {
                "radii": [
                  { "var": "fangWidth" },
                  { "var": "fangLength" },
                  { "var": "fangDepth" }
                ]
              },
              "transform": {
                "translate": [
                  { "expr": "mul", "args": [{ "var": "fangSpread" }, -1] },
                  { "var": "fangDrop" },
                  { "var": "fangForward" }
                ],
                "rotate": [{ "var": "fangTilt" }, 0, -8]
              }
            },
            {
              "comment": "Lower left canine (smaller)",
              "type": "ellipsoid",
              "params": {
                "radii": [
                  { "expr": "mul", "args": [{ "var": "fangWidth" }, 0.75] },
                  { "expr": "mul", "args": [{ "var": "fangLength" }, 0.7] },
                  { "expr": "mul", "args": [{ "var": "fangDepth" }, 0.75] }
                ]
              },
              "transform": {
                "translate": [
                  { "expr": "mul", "args": [{ "var": "fangSpread" }, 0.9] },
                  { "expr": "sub", "args": [{ "var": "fangDrop" }, 0.25] },
                  { "expr": "sub", "args": [{ "var": "fangForward" }, 0.1] }
                ],
                "rotate": [{ "expr": "mul", "args": [{ "var": "fangTilt" }, -1] }, 0, 6]
              }
            },
            {
              "comment": "Lower right canine (smaller)",
              "type": "ellipsoid",
              "params": {
                "radii": [
                  { "expr": "mul", "args": [{ "var": "fangWidth" }, 0.75] },
                  { "expr": "mul", "args": [{ "var": "fangLength" }, 0.7] },
                  { "expr": "mul", "args": [{ "var": "fangDepth" }, 0.75] }
                ]
              },
              "transform": {
                "translate": [
                  { "expr": "mul", "args": [{ "var": "fangSpread" }, -0.9] },
                  { "expr": "sub", "args": [{ "var": "fangDrop" }, 0.25] },
                  { "expr": "sub", "args": [{ "var": "fangForward" }, 0.1] }
                ],
                "rotate": [{ "expr": "mul", "args": [{ "var": "fangTilt" }, -1] }, 0, -6]
              }
            }
          ]
        }
      },
