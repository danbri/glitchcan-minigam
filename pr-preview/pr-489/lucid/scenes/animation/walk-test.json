{
  "title": "Walk Cycle Test",
  "subtitle": "Simple quadruped animation rig",
  "version": "1.0",
  "author": "LCD-002",
  "description": "Minimal quadruped for testing walk cycle animation transforms",
  "camera": { "distance": 6, "phi": 0.3, "theta": 0.3, "target": [0, 0, 0] },

  "params": {
    "walkSpeed": { "value": 2.0, "min": 0, "max": 8, "description": "Walk cycle speed" },
    "legSwing": { "value": 25, "min": 0, "max": 45, "description": "Leg swing angle (degrees)" },
    "bodyColor": { "value": [0.5, 0.45, 0.4], "type": "color3", "description": "Body color" }
  },

  "root": {
    "type": "union",
    "children": [
      {
        "comment": "BODY - simple barrel",
        "type": "material",
        "params": { "color": { "var": "bodyColor" } },
        "child": {
          "type": "smoothUnion", "k": 0.15,
          "children": [
            { "type": "ellipsoid", "params": { "radii": [0.5, 0.4, 0.8] } },
            { "type": "ellipsoid", "params": { "radii": [0.3, 0.25, 0.3] }, "transform": { "translate": [0, 0.1, 0.9] } }
          ]
        }
      },
      {
        "comment": "FRONT LEFT LEG - animated",
        "type": "transform",
        "transform": {
          "translate": [0.35, -0.3, 0.4],
          "rotate": [{ "expr": "mul", "args": [{ "var": "legSwing" }, { "expr": "sin", "args": [{ "expr": "mul", "args": [{ "var": "time" }, { "var": "walkSpeed" }] }] }] }, 0, 0]
        },
        "child": {
          "type": "material",
          "params": { "color": [0.4, 0.35, 0.3] },
          "child": {
            "type": "capsule",
            "params": { "h": 0.5, "r": 0.08 }
          }
        }
      },
      {
        "comment": "FRONT RIGHT LEG - opposite phase",
        "type": "transform",
        "transform": {
          "translate": [-0.35, -0.3, 0.4],
          "rotate": [{ "expr": "mul", "args": [{ "var": "legSwing" }, { "expr": "mul", "args": [-1, { "expr": "sin", "args": [{ "expr": "mul", "args": [{ "var": "time" }, { "var": "walkSpeed" }] }] }] }] }, 0, 0]
        },
        "child": {
          "type": "material",
          "params": { "color": [0.4, 0.35, 0.3] },
          "child": {
            "type": "capsule",
            "params": { "h": 0.5, "r": 0.08 }
          }
        }
      },
      {
        "comment": "REAR LEFT LEG - same phase as front right (diagonal)",
        "type": "transform",
        "transform": {
          "translate": [0.35, -0.3, -0.4],
          "rotate": [{ "expr": "mul", "args": [{ "var": "legSwing" }, { "expr": "mul", "args": [-1, { "expr": "sin", "args": [{ "expr": "mul", "args": [{ "var": "time" }, { "var": "walkSpeed" }] }] }] }] }, 0, 0]
        },
        "child": {
          "type": "material",
          "params": { "color": [0.4, 0.35, 0.3] },
          "child": {
            "type": "capsule",
            "params": { "h": 0.5, "r": 0.08 }
          }
        }
      },
      {
        "comment": "REAR RIGHT LEG - same phase as front left (diagonal)",
        "type": "transform",
        "transform": {
          "translate": [-0.35, -0.3, -0.4],
          "rotate": [{ "expr": "mul", "args": [{ "var": "legSwing" }, { "expr": "sin", "args": [{ "expr": "mul", "args": [{ "var": "time" }, { "var": "walkSpeed" }] }] }] }, 0, 0]
        },
        "child": {
          "type": "material",
          "params": { "color": [0.4, 0.35, 0.3] },
          "child": {
            "type": "capsule",
            "params": { "h": 0.5, "r": 0.08 }
          }
        }
      }
    ]
  }
}
