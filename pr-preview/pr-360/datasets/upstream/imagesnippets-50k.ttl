        <http://www.w3.org/1999/xhtml/vocab#stylesheet>
                <https://imagesnippets.com/imgtag/adeel/style.css>;
        <https://ogp.me/ns#description>
                "Work progresses on the Chicago Department of Transportation project to reconstruct the Wells St. Bridge. An entire section of the south leaf of the bridge is being severed and replaced over a nine day period. Trains are rerouted throughout the work.    Image provided by Yahoo!/Flickr and shared under a Creative Commons license for research purposes only."@en;
        <https://ogp.me/ns#image>      "http://farm9.staticflickr.com/8388/8528285853_dc2d45f4fe.jpg"@en;
