{
  "title": "Smooth Intersect Demo",
  "subtitle": "Demonstration of smoothIntersect CSG operation",
  "version": "1.0",
  "notes": "smoothIntersect creates a soft blend at intersection boundaries, unlike hard intersect which has sharp edges. Adjust blendK to control the smoothness.",

  "params": {
    "blendK": {
      "value": 0.3,
      "type": "scalar",
      "min": 0.0,
      "max": 0.8,
      "description": "Blend smoothness (0 = hard edge)"
    },
    "sphereRadius": {
      "value": 0.8,
      "type": "scalar",
      "min": 0.5,
      "max": 1.2,
      "description": "Sphere size"
    },
    "boxSize": {
      "value": 0.6,
      "type": "scalar",
      "min": 0.4,
      "max": 1.0,
      "description": "Box size"
    }
  },

  "camera": {
    "distance": 5,
    "phi": 0.4,
    "theta": 0.3
  },

  "root": {
    "type": "union",
    "children": [
      {
        "notes": "Left: Hard intersect for comparison",
        "type": "intersect",
        "transform": { "translate": [-1.5, 0, 0] },
        "children": [
          {
            "type": "sphere",
            "params": { "r": {"var": "sphereRadius"}, "color": [0.9, 0.3, 0.3] }
          },
          {
            "type": "box",
            "params": { "size": [{"var": "boxSize"}, {"var": "boxSize"}, {"var": "boxSize"}], "color": [0.3, 0.3, 0.9] }
          }
        ]
      },
      {
        "notes": "Right: Smooth intersect with adjustable k",
        "type": "smoothIntersect",
        "k": {"var": "blendK"},
        "transform": { "translate": [1.5, 0, 0] },
        "children": [
          {
            "type": "sphere",
            "params": { "r": {"var": "sphereRadius"}, "color": [0.3, 0.9, 0.3] }
          },
          {
            "type": "box",
            "params": { "size": [{"var": "boxSize"}, {"var": "boxSize"}, {"var": "boxSize"}], "color": [0.9, 0.9, 0.3] }
          }
        ]
      }
    ]
  }
}
