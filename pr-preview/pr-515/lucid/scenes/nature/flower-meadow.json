{
  "title": "Flower Meadow",
  "subtitle": "Poppies and sunflowers with per-instance variation",
  "version": "1.2",
  "quality": "high",
  "notes": "Demonstrates exposeId + select node for proper SDF type selection without raymarching artifacts",

  "params": {
    "flowerSpacing": {
      "value": 0.5,
      "type": "scalar",
      "min": 0.3,
      "max": 1.0,
      "description": "Distance between flowers"
    },
    "poppyColor": {
      "value": [0.9, 0.1, 0.1],
      "type": "color3",
      "description": "Poppy petal color"
    },
    "sunflowerColor": {
      "value": [1.0, 0.85, 0.1],
      "type": "color3",
      "description": "Sunflower petal color"
    }
  },

  "defs": {
    "poppy": {
      "type": "union",
      "notes": "Red poppy - thin stem, cup-shaped petals, dark center",
      "children": [
        {
          "type": "capsule",
          "notes": "Stem - thicker for robust raymarching",
          "params": { "h": 0.25, "r": 0.012, "color": [0.2, 0.5, 0.15] }
        },
        {
          "type": "sphere",
          "notes": "Flower head - flattened sphere for cup shape",
          "params": { "r": 0.07, "color": {"var": "poppyColor"} },
          "transform": { "translate": [0, 0.28, 0], "scale": [1, 0.4, 1] }
        },
        {
          "type": "sphere",
          "notes": "Dark center",
          "params": { "r": 0.025, "color": [0.1, 0.1, 0.1] },
          "transform": { "translate": [0, 0.30, 0] }
        }
      ]
    },
    "sunflower": {
      "type": "union",
      "notes": "Sunflower - thicker stem, large yellow head, brown center",
      "children": [
        {
          "type": "capsule",
          "notes": "Thick stem - robust for raymarching",
          "params": { "h": 0.35, "r": 0.018, "color": [0.25, 0.45, 0.1] }
        },
        {
          "type": "sphere",
          "notes": "Yellow petals - flattened",
          "params": { "r": 0.12, "color": {"var": "sunflowerColor"} },
          "transform": { "translate": [0, 0.40, 0], "scale": [1, 0.3, 1] }
        },
        {
          "type": "sphere",
          "notes": "Brown seed center",
          "params": { "r": 0.06, "color": [0.4, 0.25, 0.1] },
          "transform": { "translate": [0, 0.42, 0] }
        }
      ]
    }
  },
  "root": {
    "type": "union",
    "children": [
      {
        "type": "repeat",
        "notes": "Flower field with mixed types using proper select node",
        "period": [{"var": "flowerSpacing"}, 0, {"var": "flowerSpacing"}],
        "exposeId": "flowerId",
        "child": {
          "type": "select",
          "notes": "Select poppy (hash<0.6) or sunflower (hash>=0.6) - no translation hacks!",
          "cond": { "expr": "step", "args": [0.6, { "expr": "hash", "args": [{ "var": "flowerId" }] }] },
          "a": {
            "type": "ref",
            "id": "poppy",
            "notes": "Poppies when hash < 0.6 (60% of field) - large jitter breaks grid pattern",
            "transform": {
              "translate": [
                { "expr": "mul", "args": [
                  { "expr": "sub", "args": [
                    { "expr": "hash", "args": [{ "expr": "add", "args": [{ "var": "flowerId" }, 50] }] },
                    0.5
                  ]},
                  0.22
                ]},
                0,
                { "expr": "mul", "args": [
                  { "expr": "sub", "args": [
                    { "expr": "hash", "args": [{ "expr": "add", "args": [{ "var": "flowerId" }, 150] }] },
                    0.5
                  ]},
                  0.22
                ]}
              ],
              "rotate": [
                { "expr": "mul", "args": [
                  { "expr": "sub", "args": [
                    { "expr": "hash", "args": [{ "expr": "add", "args": [{ "var": "flowerId" }, 200] }] },
                    0.5
                  ]},
                  25
                ]},
                { "expr": "mul", "args": [
                  { "expr": "hash", "args": [{ "expr": "add", "args": [{ "var": "flowerId" }, 300] }] },
                  360
                ]},
                { "expr": "mul", "args": [
                  { "expr": "sub", "args": [
                    { "expr": "hash", "args": [{ "expr": "add", "args": [{ "var": "flowerId" }, 250] }] },
                    0.5
                  ]},
                  25
                ]}
              ],
              "scale": [
                { "expr": "add", "args": [0.7, { "expr": "mul", "args": [
                  { "expr": "hash", "args": [{ "expr": "add", "args": [{ "var": "flowerId" }, 600] }] },
                  0.5
                ]}]}
              ]
            }
          },
          "b": {
            "type": "ref",
            "id": "sunflower",
            "notes": "Sunflowers when hash >= 0.6 (40% of field) - large jitter breaks grid pattern",
            "transform": {
              "translate": [
                { "expr": "mul", "args": [
                  { "expr": "sub", "args": [
                    { "expr": "hash", "args": [{ "expr": "add", "args": [{ "var": "flowerId" }, 70] }] },
                    0.5
                  ]},
                  0.20
                ]},
                0,
                { "expr": "mul", "args": [
                  { "expr": "sub", "args": [
                    { "expr": "hash", "args": [{ "expr": "add", "args": [{ "var": "flowerId" }, 170] }] },
                    0.5
                  ]},
                  0.20
                ]}
              ],
              "rotate": [
                { "expr": "mul", "args": [
                  { "expr": "sub", "args": [
                    { "expr": "hash", "args": [{ "expr": "add", "args": [{ "var": "flowerId" }, 400] }] },
                    0.5
                  ]},
                  18
                ]},
                { "expr": "mul", "args": [
                  { "expr": "hash", "args": [{ "expr": "add", "args": [{ "var": "flowerId" }, 500] }] },
                  360
                ]},
                { "expr": "mul", "args": [
                  { "expr": "sub", "args": [
                    { "expr": "hash", "args": [{ "expr": "add", "args": [{ "var": "flowerId" }, 450] }] },
                    0.5
                  ]},
                  18
                ]}
              ],
              "scale": [
                { "expr": "add", "args": [0.75, { "expr": "mul", "args": [
                  { "expr": "hash", "args": [{ "expr": "add", "args": [{ "var": "flowerId" }, 700] }] },
                  0.4
                ]}]}
              ]
            }
          }
        },
        "transform": { "translate": [0, -0.5, 0] }
      }
    ]
  }
}
