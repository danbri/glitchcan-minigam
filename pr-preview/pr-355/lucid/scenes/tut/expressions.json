{
  "title": "Expressions & Animation",
  "subtitle": "Dynamic values with math expressions",
  "version": "1.1",
  "notes": "EXPRESSIONS make values dynamic. Use {expr:'op', args:[...]} syntax. Ops: add, sub, mul, div, sin, cos, abs, min, max, mix, clamp, mod, pow, sqrt. Use {var:'time'} for animation, {var:'x/y/z'} for position. Expressions work in any numeric param.",

  "params": {
    "pulseAmount": {
      "value": 0.1,
      "type": "scalar",
      "min": 0.0,
      "max": 0.3,
      "description": "Sphere pulse amount"
    },
    "rotationSpeed": {
      "value": 45,
      "type": "scalar",
      "min": 10,
      "max": 120,
      "description": "Box rotation speed (deg/s)"
    },
    "sphereColor": {
      "value": [1, 0.5, 0.2],
      "type": "color3",
      "description": "Pulsing sphere color"
    }
  },

  "root": {
    "type": "union",
    "children": [
      {
        "type": "sphere",
        "params": {
          "r": { "expr": "add", "args": [0.3, { "expr": "mul", "args": [{"var": "pulseAmount"}, { "expr": "sin", "args": [{ "var": "time" }] }] }] },
          "color": {"var": "sphereColor"}
        },
        "transform": { "translate": [-1, 0.5, 0] }
      },
      {
        "type": "box",
        "params": { "size": [0.3, 0.3, 0.3], "color": [0.2, 0.8, 1] },
        "transform": {
          "translate": [0, 0.5, 0],
          "rotate": [0, { "expr": "mul", "args": [{ "var": "time" }, {"var": "rotationSpeed"}] }, 0]
        }
      },
      {
        "type": "torus",
        "params": {
          "major": 0.4,
          "minor": { "expr": "add", "args": [0.08, { "expr": "mul", "args": [0.04, { "expr": "sin", "args": [{ "expr": "mul", "args": [{ "var": "time" }, 3] }] }] }] },
          "color": [0.8, 0.2, 0.8]
        },
        "transform": { "translate": [1, 0.5, 0] }
      }
    ]
  }
}
