{
  "title": "Smooth Union",
  "subtitle": "Two spheres with parametric smooth blending",
  "version": "2.0",
  "notes": "CSG ops combine shapes: union (add), subtract (cut), intersect (common). Smooth variants use 'k' param to control blend radius. Higher k = more blending.",

  "params": {
    "blendFactor": {
      "value": 0.5,
      "type": "scalar",
      "min": 0.0,
      "max": 1.5,
      "description": "Smooth union blend radius (k)"
    },
    "sphereRadius": {
      "value": 0.8,
      "type": "scalar",
      "min": 0.3,
      "max": 1.5,
      "description": "Size of both spheres"
    },
    "motionSpeed": {
      "value": 1.0,
      "type": "scalar",
      "min": 0.2,
      "max": 3.0,
      "description": "Animation speed"
    },
    "motionRange": {
      "value": 1.7,
      "type": "scalar",
      "min": 0.5,
      "max": 3.0,
      "description": "Horizontal motion range"
    },
    "sphere1Color": {
      "value": [1.0, 0.7, 0.2],
      "type": "color3",
      "description": "Top sphere color (amber)"
    },
    "sphere2Color": {
      "value": [0.5, 0.2, 1.0],
      "type": "color3",
      "description": "Bottom sphere color (violet)"
    }
  },

  "root": {
    "type": "smoothUnion",
    "k": { "var": "blendFactor" },
    "children": [
      {
        "type": "sphere",
        "params": {
          "r": { "var": "sphereRadius" },
          "color": { "var": "sphere1Color" }
        },
        "transform": {
          "translate": [
            { "expr": "mul", "args": [
              { "expr": "sin", "args": [{ "expr": "mul", "args": [{ "var": "time" }, { "var": "motionSpeed" }] }] },
              { "var": "motionRange" }
            ]},
            0.7,
            0.5
          ]
        }
      },
      {
        "type": "sphere",
        "params": {
          "r": { "var": "sphereRadius" },
          "color": { "var": "sphere2Color" }
        },
        "transform": {
          "translate": [
            { "expr": "mul", "args": [
              { "expr": "sin", "args": [{ "expr": "mul", "args": [{ "var": "time" }, { "var": "motionSpeed" }] }] },
              -0.5
            ]},
            -0.3,
            0
          ]
        }
      }
    ]
  }
}
