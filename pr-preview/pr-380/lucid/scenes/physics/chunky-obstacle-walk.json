{
  "title": "Obstacle Walk",
  "subtitle": "Physics walker navigating rolling obstacles",
  "version": "1.0",
  "description": "Quadruped walks forward through field of rolling balls",
  "camera": { "distance": 8, "phi": 0.4, "theta": 0.2, "target": [0, 0, 0] },

  "params": {
    "walkSpeed": { "value": 2.0, "min": 0, "max": 4, "label": "Walk Speed" },
    "stepHeight": { "value": 0.25, "min": 0, "max": 0.5, "label": "Step Height" },
    "forwardSpeed": { "value": 1.2, "min": 0, "max": 3, "label": "Forward Speed" },
    "bodyColor": { "value": [0.6, 0.5, 0.4], "type": "color3" },
    "legColor": { "value": [0.5, 0.4, 0.35], "type": "color3" },
    "ballColor": { "value": [0.3, 0.5, 0.7], "type": "color3" }
  },

  "rig": {
    "phase": {
      "gait": {
        "comment": "Diagonal gait - FL+RR then FR+RL",
        "driver": { "expr": "mul", "args": ["time", "walkSpeed"] },
        "followers": {
          "footFL_lift": { "phase": 0, "amplitude": "stepHeight", "waveform": "step" },
          "footRR_lift": { "phase": 0, "amplitude": "stepHeight", "waveform": "step" },
          "footFR_lift": { "phase": 0.5, "amplitude": "stepHeight", "waveform": "step" },
          "footRL_lift": { "phase": 0.5, "amplitude": "stepHeight", "waveform": "step" }
        }
      },
      "locomotion": {
        "comment": "Forward body movement - Z direction",
        "driver": { "expr": "mul", "args": ["time", "forwardSpeed"] },
        "followers": {
          "bodyForward": { "phase": 0, "amplitude": 1.0, "waveform": "linear" }
        }
      }
    }
  },

  "physics": {
    "enabled": true,
    "gravity": [0, -12, 0],
    "groundY": -1.2,
    "damping": 0.92,
    "iterations": 8,
    "dt": 0.016,
    "bounds": { "minX": -6, "maxX": 6, "minZ": -6, "maxZ": 6 },

    "bodies": [
      { "name": "body", "pos": [0, 0.4, -2], "mass": 4.0, "radius": 0.4 },
      { "name": "footFL", "pos": [0.35, -0.9, -1.5], "mass": 0.3, "radius": 0.1 },
      { "name": "footFR", "pos": [-0.35, -0.9, -1.5], "mass": 0.3, "radius": 0.1 },
      { "name": "footRL", "pos": [0.35, -0.9, -2.5], "mass": 0.3, "radius": 0.1 },
      { "name": "footRR", "pos": [-0.35, -0.9, -2.5], "mass": 0.3, "radius": 0.1 },

      { "name": "ball1", "pos": [-0.3, 0, 0.5], "mass": 1.5, "radius": 0.3, "restitution": 0.7 },
      { "name": "ball2", "pos": [0.4, 0, 1.5], "mass": 1.8, "radius": 0.32, "restitution": 0.75 },
      { "name": "ball3", "pos": [-0.5, 0, 2.5], "mass": 2.0, "radius": 0.35, "restitution": 0.65 },
      { "name": "ball4", "pos": [0.2, 0, 3.5], "mass": 1.6, "radius": 0.28, "restitution": 0.8 },
      { "name": "ball5", "pos": [-0.2, 0, 4.5], "mass": 2.2, "radius": 0.38, "restitution": 0.6 }
    ],

    "distanceConstraints": [
      { "bodyA": "body", "bodyB": "footFL", "compliance": 0.0005 },
      { "bodyA": "body", "bodyB": "footFR", "compliance": 0.0005 },
      { "bodyA": "body", "bodyB": "footRL", "compliance": 0.0005 },
      { "bodyA": "body", "bodyB": "footRR", "compliance": 0.0005 }
    ],

    "positionConstraints": [
      { "body": "footFL", "compliance": 0.008, "rigTarget": "gait_footFL_lift", "baseY": -0.9 },
      { "body": "footFR", "compliance": 0.008, "rigTarget": "gait_footFR_lift", "baseY": -0.9 },
      { "body": "footRL", "compliance": 0.008, "rigTarget": "gait_footRL_lift", "baseY": -0.9 },
      { "body": "footRR", "compliance": 0.008, "rigTarget": "gait_footRR_lift", "baseY": -0.9 },
      { "body": "body", "compliance": 0.02, "rigTarget": "locomotion_bodyForward", "axis": "z" }
    ]
  },

  "defs": {
    "foot": {
      "type": "material",
      "params": { "color": { "var": "legColor" } },
      "child": { "type": "sphere", "params": { "r": 0.1 } }
    },
    "obstacle": {
      "type": "material",
      "params": { "color": { "var": "ballColor" } },
      "child": { "type": "sphere", "params": { "r": { "var": "obstacleR" } } }
    }
  },

  "root": {
    "type": "union",
    "comment": "No smoothUnion at root - keeps walker and balls separate",
    "children": [
      {
        "comment": "Walker (body + feet blended together)",
        "type": "smoothUnion", "k": 0.12,
        "children": [
          {
            "comment": "Walker body",
            "type": "transform",
            "transform": { "translate": { "var": "phys_body" } },
            "child": {
              "type": "material",
              "params": { "color": { "var": "bodyColor" } },
              "child": {
                "type": "smoothUnion", "k": 0.15,
                "children": [
                  { "type": "ellipsoid", "params": { "radii": [0.45, 0.35, 0.6] } },
                  {
                    "type": "ellipsoid",
                    "params": { "radii": [0.22, 0.2, 0.22] },
                    "transform": { "translate": [0, 0.1, 0.7] }
                  }
                ]
              }
            }
          },
          {
            "comment": "Feet",
            "type": "union",
            "children": [
              { "type": "transform", "transform": { "translate": { "var": "phys_footFL" } }, "child": { "type": "ref", "id": "foot" } },
              { "type": "transform", "transform": { "translate": { "var": "phys_footFR" } }, "child": { "type": "ref", "id": "foot" } },
              { "type": "transform", "transform": { "translate": { "var": "phys_footRL" } }, "child": { "type": "ref", "id": "foot" } },
              { "type": "transform", "transform": { "translate": { "var": "phys_footRR" } }, "child": { "type": "ref", "id": "foot" } }
            ]
          }
        ]
      },
      {
        "comment": "Obstacle balls (separate from walker)",
        "type": "union",
        "children": [
          { "type": "transform", "transform": { "translate": { "var": "phys_ball1" } }, "child": { "type": "ref", "id": "obstacle", "params": { "obstacleR": 0.35 } } },
          { "type": "transform", "transform": { "translate": { "var": "phys_ball2" } }, "child": { "type": "ref", "id": "obstacle", "params": { "obstacleR": 0.3 } } },
          { "type": "transform", "transform": { "translate": { "var": "phys_ball3" } }, "child": { "type": "ref", "id": "obstacle", "params": { "obstacleR": 0.4 } } },
          { "type": "transform", "transform": { "translate": { "var": "phys_ball4" } }, "child": { "type": "ref", "id": "obstacle", "params": { "obstacleR": 0.32 } } },
          { "type": "transform", "transform": { "translate": { "var": "phys_ball5" } }, "child": { "type": "ref", "id": "obstacle", "params": { "obstacleR": 0.38 } } }
        ]
      }
    ]
  }
}
