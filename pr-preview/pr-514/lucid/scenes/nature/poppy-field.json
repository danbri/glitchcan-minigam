{
  "title": "Poppy Field",
  "subtitle": "Rotated disk faces with centralized head angle (static)",
  "version": "1.2",
  "notes": "Animation disabled - was causing issues with repeat+radial combination",

  "params": {
    "poppyColor": {
      "value": [0.9, 0.15, 0.1],
      "type": "color3",
      "description": "Poppy petal color"
    },
    "stemColor": {
      "value": [0.2, 0.5, 0.15],
      "type": "color3",
      "description": "Stem color"
    },
    "petalSize": {
      "value": 0.12,
      "type": "scalar",
      "min": 0.06,
      "max": 0.2,
      "description": "Petal sphere size"
    }
  },

  "defs": {
    "poppy_head": {
      "type": "union",
      "comment": "Head angle is defined ONCE here - rotate X by 75 to tilt disk face",
      "children": [
        {
          "type": "cylinder",
          "params": { "h": 0.02, "r": 0.15, "color": [0.35, 0.2, 0.1] },
          "transform": { "rotate": [75, 0, 0] }
        },
        {
          "type": "radial",
          "count": 8,
          "axis": "z",
          "child": {
            "type": "sphere",
            "params": { "r": {"var": "petalSize"}, "color": {"var": "poppyColor"} },
            "transform": { "translate": [0.18, 0, 0], "rotate": [75, 0, 0] }
          }
        }
      ],
      "transform": { "translate": [0, 0.8, 0] }
    },
    "stem": {
      "type": "cylinder",
      "params": { "h": 0.8, "r": 0.03, "color": {"var": "stemColor"} }
    },
    "poppy": {
      "type": "union",
      "children": [
        { "type": "ref", "id": "stem" },
        { "type": "ref", "id": "poppy_head" }
      ]
    }
  },
  "root": {
    "type": "repeat",
    "period": [1.8, 0, 1.8],
    "child": { "type": "ref", "id": "poppy" },
    "transform": { "translate": [0, 0.4, 0] }
  }
}
