{
  "title": "Chunky Parametric",
  "subtitle": "Single quadruped template, 3 variants via param overrides",
  "version": "1.0",
  "author": "LCD-002",
  "description": "Demonstrates parameterized instancing - one def, three animals",
  "camera": { "distance": 10, "phi": 0.3, "theta": 0.2, "target": [0, 0, 0] },

  "params": {
    "smoothness": { "value": 0.2, "min": 0.05, "max": 0.4 },
    "spacing": { "value": 3.5, "min": 2, "max": 6 }
  },

  "defs": {
    "quadruped": {
      "comment": "Generic chunky quadruped - all proportions parameterized",
      "type": "material",
      "params": { "color": { "var": "color" } },
      "child": {
        "type": "smoothUnion", "k": { "var": "smoothness" },
        "children": [
          {
            "comment": "Body",
            "type": "ellipsoid",
            "params": { "radii": { "var": "bodyRadii" } }
          },
          {
            "comment": "Head",
            "type": "ellipsoid",
            "params": { "radii": { "var": "headRadii" } },
            "transform": { "translate": { "var": "headPos" } }
          },
          {
            "comment": "Snout/nose",
            "type": "ellipsoid",
            "params": { "radii": { "var": "snoutRadii" } },
            "transform": { "translate": { "var": "snoutPos" } }
          },
          {
            "comment": "Ears (mirrored)",
            "type": "mirror", "axis": "x",
            "child": {
              "type": "ellipsoid",
              "params": { "radii": { "var": "earRadii" } },
              "transform": { "translate": { "var": "earPos" } }
            }
          },
          {
            "comment": "Front legs (mirrored)",
            "type": "mirror", "axis": "x",
            "child": {
              "type": "capsule",
              "params": { "h": { "var": "legHeight" }, "r": { "var": "legRadius" } },
              "transform": { "translate": { "var": "frontLegPos" } }
            }
          },
          {
            "comment": "Back legs (mirrored)",
            "type": "mirror", "axis": "x",
            "child": {
              "type": "capsule",
              "params": { "h": { "var": "legHeight" }, "r": { "var": "legRadius" } },
              "transform": { "translate": { "var": "backLegPos" } }
            }
          }
        ]
      }
    }
  },

  "root": {
    "type": "union",
    "children": [
      {
        "comment": "Hippo - gray-purple, barrel body, wide snout",
        "type": "ref", "id": "quadruped",
        "params": {
          "color": [0.45, 0.38, 0.42],
          "bodyRadii": [1.1, 0.7, 1.0],
          "headRadii": [0.45, 0.4, 0.5],
          "headPos": [0, 0.1, 1.3],
          "snoutRadii": [0.38, 0.28, 0.35],
          "snoutPos": [0, -0.1, 1.75],
          "earRadii": [0.08, 0.12, 0.08],
          "earPos": [0.25, 0.45, 1.2],
          "legHeight": 0.4,
          "legRadius": 0.2,
          "frontLegPos": [0.55, -0.65, 0.5],
          "backLegPos": [0.55, -0.65, -0.5]
        }
      },
      {
        "comment": "Bear - brown, stockier, round ears",
        "type": "transform",
        "transform": { "translate": [{ "var": "spacing" }, 0, 0] },
        "child": {
          "type": "ref", "id": "quadruped",
          "params": {
            "color": [0.35, 0.22, 0.12],
            "bodyRadii": [1.0, 0.8, 0.9],
            "headRadii": [0.4, 0.38, 0.4],
            "headPos": [0, 0.25, 1.2],
            "snoutRadii": [0.2, 0.18, 0.25],
            "snoutPos": [0, 0.1, 1.55],
            "earRadii": [0.12, 0.12, 0.12],
            "earPos": [0.28, 0.55, 1.0],
            "legHeight": 0.5,
            "legRadius": 0.22,
            "frontLegPos": [0.5, -0.65, 0.5],
            "backLegPos": [0.5, -0.65, -0.5]
          }
        }
      },
      {
        "comment": "Pig - pink, longer snout, floppy ears",
        "type": "transform",
        "transform": { "translate": [{ "expr": "mul", "args": [{ "var": "spacing" }, -1] }, 0, 0] },
        "child": {
          "type": "ref", "id": "quadruped",
          "params": {
            "color": [0.9, 0.65, 0.6],
            "bodyRadii": [0.8, 0.6, 1.0],
            "headRadii": [0.35, 0.32, 0.35],
            "headPos": [0, 0.05, 1.25],
            "snoutRadii": [0.18, 0.14, 0.25],
            "snoutPos": [0, -0.05, 1.6],
            "earRadii": [0.15, 0.2, 0.08],
            "earPos": [0.2, 0.35, 1.1],
            "legHeight": 0.35,
            "legRadius": 0.12,
            "frontLegPos": [0.4, -0.55, 0.5],
            "backLegPos": [0.45, -0.55, -0.5]
          }
        }
      }
    ]
  }
}
