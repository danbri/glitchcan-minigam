{
  "title": "Capsule Demo",
  "subtitle": "Rounded cylinder primitive",
  "version": "1.1",

  "params": {
    "capsuleRadius": {
      "value": 0.2,
      "type": "scalar",
      "min": 0.1,
      "max": 0.5,
      "description": "Capsule thickness"
    },
    "color1": {
      "value": [0.9, 0.3, 0.5],
      "type": "color3",
      "description": "Left capsule color"
    },
    "color2": {
      "value": [0.3, 0.8, 0.5],
      "type": "color3",
      "description": "Middle capsule color"
    },
    "color3": {
      "value": [0.3, 0.5, 0.9],
      "type": "color3",
      "description": "Right capsule color"
    }
  },

  "root": {
    "type": "union",
    "children": [
      { "type": "capsule", "params": { "h": 0.8, "r": {"var": "capsuleRadius"}, "color": {"var": "color1"} }, "transform": { "translate": [-1.2, 0, 0] } },
      { "type": "capsule", "params": { "h": 0.5, "r": {"var": "capsuleRadius"}, "color": {"var": "color2"} }, "transform": { "translate": [0, 0, 0], "rotate": [0, 0, 45] } },
      { "type": "capsule", "params": { "h": 1.0, "r": {"var": "capsuleRadius"}, "color": {"var": "color3"} }, "transform": { "translate": [1.2, 0, 0], "rotate": [90, 0, 0] } }
    ]
  }
}
