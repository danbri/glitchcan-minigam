{
  "title": "Orbital System",
  "subtitle": "Time-based animation with math expressions",
  "version": "2.0",
  "notes": "Three orbiters circling a pulsing central sphere. Adjust orbit speed, radius, and colors.",

  "params": {
    "orbitSpeed": {
      "value": 1.0,
      "type": "scalar",
      "min": 0.2,
      "max": 4.0,
      "description": "Orbital rotation speed"
    },
    "orbitRadius": {
      "value": 1.2,
      "type": "scalar",
      "min": 0.6,
      "max": 2.5,
      "description": "Orbit distance from center"
    },
    "bobAmount": {
      "value": 0.3,
      "type": "scalar",
      "min": 0.0,
      "max": 0.8,
      "description": "Vertical bobbing amplitude"
    },
    "centralRadius": {
      "value": 0.5,
      "type": "scalar",
      "min": 0.2,
      "max": 1.0,
      "description": "Central sphere base radius"
    },
    "orbiterRadius": {
      "value": 0.15,
      "type": "scalar",
      "min": 0.05,
      "max": 0.35,
      "description": "Orbiter sphere radius"
    },
    "centralColor": {
      "value": [0.3, 0.5, 0.9],
      "type": "color3",
      "description": "Central sphere color"
    },
    "orbiterColor": {
      "value": [1.0, 0.8, 0.2],
      "type": "color3",
      "description": "Orbiter color"
    },
    "trackColor": {
      "value": [0.4, 0.4, 0.5],
      "type": "color3",
      "description": "Orbit track color"
    }
  },

  "defs": {
    "orbiter": {
      "type": "sphere",
      "params": {
        "r": { "var": "orbiterRadius" },
        "color": { "var": "orbiterColor" }
      }
    }
  },

  "root": {
    "type": "union",
    "children": [
      {
        "comment": "Central pulsing sphere",
        "type": "sphere",
        "params": {
          "r": {
            "expr": "add",
            "args": [
              { "var": "centralRadius" },
              { "expr": "mul", "args": [
                0.15,
                { "expr": "sin", "args": [{ "expr": "mul", "args": [{ "var": "time" }, { "var": "orbitSpeed" }] }] }
              ]}
            ]
          },
          "color": { "var": "centralColor" }
        }
      },
      {
        "comment": "Orbiter 1 - phase 0",
        "type": "ref",
        "id": "orbiter",
        "transform": {
          "translate": [
            { "expr": "mul", "args": [{ "var": "orbitRadius" }, { "expr": "cos", "args": [{ "expr": "mul", "args": [{ "var": "time" }, { "var": "orbitSpeed" }] }] }] },
            { "expr": "mul", "args": [{ "var": "bobAmount" }, { "expr": "sin", "args": [{ "expr": "mul", "args": [{ "var": "time" }, { "var": "orbitSpeed" }, 3] }] }] },
            { "expr": "mul", "args": [{ "var": "orbitRadius" }, { "expr": "sin", "args": [{ "expr": "mul", "args": [{ "var": "time" }, { "var": "orbitSpeed" }] }] }] }
          ]
        }
      },
      {
        "comment": "Orbiter 2 - phase 120°",
        "type": "ref",
        "id": "orbiter",
        "transform": {
          "translate": [
            { "expr": "mul", "args": [{ "var": "orbitRadius" }, { "expr": "cos", "args": [{ "expr": "add", "args": [{ "expr": "mul", "args": [{ "var": "time" }, { "var": "orbitSpeed" }] }, 2.094] }] }] },
            { "expr": "mul", "args": [{ "var": "bobAmount" }, { "expr": "sin", "args": [{ "expr": "mul", "args": [{ "expr": "add", "args": [{ "var": "time" }, 0.7] }, { "var": "orbitSpeed" }, 3] }] }] },
            { "expr": "mul", "args": [{ "var": "orbitRadius" }, { "expr": "sin", "args": [{ "expr": "add", "args": [{ "expr": "mul", "args": [{ "var": "time" }, { "var": "orbitSpeed" }] }, 2.094] }] }] }
          ]
        }
      },
      {
        "comment": "Orbiter 3 - phase 240°",
        "type": "ref",
        "id": "orbiter",
        "transform": {
          "translate": [
            { "expr": "mul", "args": [{ "var": "orbitRadius" }, { "expr": "cos", "args": [{ "expr": "add", "args": [{ "expr": "mul", "args": [{ "var": "time" }, { "var": "orbitSpeed" }] }, 4.189] }] }] },
            { "expr": "mul", "args": [{ "var": "bobAmount" }, { "expr": "sin", "args": [{ "expr": "mul", "args": [{ "expr": "add", "args": [{ "var": "time" }, 1.4] }, { "var": "orbitSpeed" }, 3] }] }] },
            { "expr": "mul", "args": [{ "var": "orbitRadius" }, { "expr": "sin", "args": [{ "expr": "add", "args": [{ "expr": "mul", "args": [{ "var": "time" }, { "var": "orbitSpeed" }] }, 4.189] }] }] }
          ]
        }
      },
      {
        "comment": "Orbit track ring",
        "type": "torus",
        "params": {
          "major": { "var": "orbitRadius" },
          "minor": 0.03,
          "color": { "var": "trackColor" }
        }
      }
    ]
  }
}
