{
  "title": "CSG Operations",
  "subtitle": "Union, subtract, intersect, smooth union",
  "version": "1.1",

  "params": {
    "sphereSize": {
      "value": 0.4,
      "type": "scalar",
      "min": 0.2,
      "max": 0.6,
      "description": "Base sphere size"
    },
    "blendK": {
      "value": 0.25,
      "type": "scalar",
      "min": 0.0,
      "max": 0.6,
      "description": "Smooth union blend"
    },
    "repeatSize": {
      "value": 0.12,
      "type": "scalar",
      "min": 0.05,
      "max": 0.25,
      "description": "Repeat sphere size"
    }
  },

  "root": {
    "type": "union",
    "children": [
      {
        "type": "union",
        "children": [
          { "type": "sphere", "params": { "r": {"var": "sphereSize"}, "color": [0.9, 0.3, 0.3] } },
          { "type": "box", "params": { "size": [0.25, 0.25, 0.25], "color": [0.3, 0.9, 0.3] }, "transform": { "translate": [0.3, 0.3, 0] } }
        ],
        "transform": { "translate": [-2.5, 0.8, 0] }
      },
      {
        "type": "subtract",
        "children": [
          { "type": "sphere", "params": { "r": 0.45, "color": [0.3, 0.6, 0.9] } },
          { "type": "box", "params": { "size": [0.3, 0.3, 0.6], "color": [0.9, 0.9, 0.3] } }
        ],
        "transform": { "translate": [-0.8, 0.8, 0] }
      },
      {
        "type": "intersect",
        "children": [
          { "type": "sphere", "params": { "r": 0.5, "color": [0.9, 0.5, 0.2] } },
          { "type": "box", "params": { "size": [0.35, 0.35, 0.35], "color": [0.9, 0.5, 0.2] } }
        ],
        "transform": { "translate": [0.9, 0.8, 0] }
      },
      {
        "type": "smoothUnion",
        "k": {"var": "blendK"},
        "children": [
          { "type": "sphere", "params": { "r": 0.35, "color": [0.7, 0.3, 0.9] } },
          { "type": "sphere", "params": { "r": 0.35, "color": [0.3, 0.9, 0.7] }, "transform": { "translate": [0.4, 0, 0] } }
        ],
        "transform": { "translate": [2.5, 0.8, 0] }
      },
      {
        "type": "mirror",
        "axis": "x",
        "child": {
          "type": "capsule",
          "params": { "h": 0.3, "r": 0.15, "color": [0.9, 0.6, 0.2] },
          "transform": { "translate": [0.5, 0, 0], "rotate": [0, 0, 30] }
        },
        "transform": { "translate": [-2.0, -0.8, 0] }
      },
      {
        "type": "radial",
        "count": 5,
        "axis": "z",
        "child": {
          "type": "box",
          "params": { "size": [0.15, 0.08, 0.08], "color": [0.2, 0.8, 0.9] },
          "transform": { "translate": [0.35, 0, 0] }
        },
        "transform": { "translate": [0, -0.8, 0] }
      },
      {
        "type": "repeat",
        "period": [0.8, 0, 0.8],
        "child": {
          "type": "sphere",
          "params": { "r": {"var": "repeatSize"}, "color": [0.9, 0.4, 0.6] }
        },
        "transform": { "translate": [2.2, -0.8, 0] }
      }
    ]
  }
}
