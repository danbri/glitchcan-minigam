{
  "title": "Bouncy Quadruped",
  "subtitle": "XPBD physics - drop a creature, watch it bounce",
  "version": "2.0",
  "description": "Body falls under gravity, feet anchored to ground, leg constraints maintain shape",
  "camera": { "distance": 5, "phi": 0.35, "theta": 0.2, "target": [0, 0, 0] },

  "params": {
    "smoothness": { "value": 0.15, "min": 0.05, "max": 0.3, "type": "scalar" },
    "bodyColor": { "value": [0.6, 0.55, 0.5], "type": "color3" },
    "legColor": { "value": [0.5, 0.45, 0.4], "type": "color3" }
  },

  "physics": {
    "enabled": true,
    "gravity": [0, -9.8, 0],
    "groundY": -1.2,
    "damping": 0.98,
    "iterations": 8,
    "dt": 0.016,

    "bodies": [
      { "name": "body", "pos": [0, 1.5, 0], "mass": 5.0, "radius": 0.4 },
      { "name": "footFL", "pos": [0.4, -0.8, 0.5], "mass": 0, "radius": 0.1 },
      { "name": "footFR", "pos": [-0.4, -0.8, 0.5], "mass": 0, "radius": 0.1 },
      { "name": "footRL", "pos": [0.4, -0.8, -0.5], "mass": 0, "radius": 0.1 },
      { "name": "footRR", "pos": [-0.4, -0.8, -0.5], "mass": 0, "radius": 0.1 }
    ],

    "distanceConstraints": [
      { "bodyA": "body", "bodyB": "footFL", "compliance": 0.0001 },
      { "bodyA": "body", "bodyB": "footFR", "compliance": 0.0001 },
      { "bodyA": "body", "bodyB": "footRL", "compliance": 0.0001 },
      { "bodyA": "body", "bodyB": "footRR", "compliance": 0.0001 }
    ]
  },

  "defs": {
    "foot": {
      "type": "material",
      "params": { "color": { "var": "legColor" } },
      "child": {
        "type": "sphere",
        "params": { "r": 0.12 }
      }
    }
  },

  "root": {
    "type": "smoothUnion", "k": { "var": "smoothness" },
    "children": [
      {
        "comment": "Body - position from physics",
        "type": "transform",
        "transform": { "translate": { "var": "phys_body" } },
        "child": {
          "type": "material",
          "params": { "color": { "var": "bodyColor" } },
          "child": {
            "type": "smoothUnion", "k": 0.2,
            "children": [
              { "type": "ellipsoid", "params": { "radii": [0.5, 0.4, 0.7] } },
              {
                "type": "ellipsoid",
                "params": { "radii": [0.25, 0.22, 0.25] },
                "transform": { "translate": [0, 0.1, 0.8] }
              }
            ]
          }
        }
      },
      {
        "type": "transform",
        "transform": { "translate": { "var": "phys_footFL" } },
        "child": { "type": "ref", "id": "foot" }
      },
      {
        "type": "transform",
        "transform": { "translate": { "var": "phys_footFR" } },
        "child": { "type": "ref", "id": "foot" }
      },
      {
        "type": "transform",
        "transform": { "translate": { "var": "phys_footRL" } },
        "child": { "type": "ref", "id": "foot" }
      },
      {
        "type": "transform",
        "transform": { "translate": { "var": "phys_footRR" } },
        "child": { "type": "ref", "id": "foot" }
      }
    ]
  }
}
