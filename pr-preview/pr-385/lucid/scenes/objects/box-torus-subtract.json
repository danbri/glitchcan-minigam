{
  "version": "1.1",
  "title": "Box minus Torus",
  "description": "CSG subtraction - torus carved from box",

  "params": {
    "boxSize": {
      "value": 0.8,
      "type": "scalar",
      "min": 0.4,
      "max": 1.2,
      "description": "Cube size"
    },
    "torusMajor": {
      "value": 0.6,
      "type": "scalar",
      "min": 0.3,
      "max": 1.0,
      "description": "Torus ring radius"
    },
    "torusMinor": {
      "value": 0.25,
      "type": "scalar",
      "min": 0.1,
      "max": 0.4,
      "description": "Torus tube radius"
    },
    "boxColor": {
      "value": [0.7, 0.5, 0.3],
      "type": "color3",
      "description": "Box color"
    }
  },

  "root": {
    "type": "subtract",
    "children": [
      {
        "type": "box",
        "params": {
          "size": [{"var": "boxSize"}, {"var": "boxSize"}, {"var": "boxSize"}],
          "color": {"var": "boxColor"}
        }
      },
      {
        "type": "torus",
        "params": {
          "major": {"var": "torusMajor"},
          "minor": {"var": "torusMinor"},
          "color": [0.3, 0.6, 0.9]
        }
      }
    ]
  }
}
