{
  "comment": "Shared quadruped body plan - instantiate with params",
  "version": "1.0",

  "quadruped": {
    "type": "smoothUnion",
    "k": { "var": "smooth" },
    "children": [
      {
        "comment": "Body core",
        "type": "ellipsoid",
        "params": {
          "radii": { "var": "bodyRadii" },
          "color": { "var": "color" }
        }
      },
      {
        "comment": "Rump",
        "type": "transform",
        "translate": { "var": "rumpPos" },
        "child": {
          "type": "ellipsoid",
          "params": {
            "radii": { "var": "rumpRadii" },
            "color": { "var": "color" }
          }
        }
      },
      {
        "comment": "Head",
        "type": "transform",
        "translate": { "var": "headPos" },
        "child": {
          "type": "ellipsoid",
          "params": {
            "radii": { "var": "headRadii" },
            "color": { "var": "color" }
          }
        }
      },
      {
        "comment": "Snout",
        "type": "transform",
        "translate": { "var": "snoutPos" },
        "child": {
          "type": "ellipsoid",
          "params": {
            "radii": { "var": "snoutRadii" },
            "color": { "var": "color" }
          }
        }
      },
      {
        "comment": "Nose",
        "type": "transform",
        "translate": { "var": "nosePos" },
        "child": {
          "type": "sphere",
          "params": {
            "r": { "var": "noseSize" },
            "color": [0.1, 0.08, 0.08]
          }
        }
      },
      {
        "comment": "Ears (mirrored)",
        "type": "mirror",
        "axis": "x",
        "child": {
          "type": "transform",
          "translate": { "var": "earPos" },
          "rotate": { "var": "earRotate" },
          "child": {
            "type": "ellipsoid",
            "params": {
              "radii": { "var": "earRadii" },
              "color": { "var": "color" }
            }
          }
        }
      },
      {
        "comment": "Front legs (mirrored)",
        "type": "smoothUnion",
        "k": { "expr": "mul", "args": [{ "var": "smooth" }, 0.7] },
        "children": [{
          "type": "mirror",
          "axis": "x",
          "child": {
            "type": "transform",
            "translate": { "var": "frontLegPos" },
            "rotate": { "var": "frontLegRot" },
            "child": {
              "type": "roundCone",
              "params": {
                "r1": { "var": "legThighR" },
                "r2": { "var": "legAnkleR" },
                "h": { "var": "frontLegH" },
                "color": { "var": "color" }
              }
            }
          }
        }]
      },
      {
        "comment": "Back legs (mirrored)",
        "type": "smoothUnion",
        "k": { "expr": "mul", "args": [{ "var": "smooth" }, 0.7] },
        "children": [{
          "type": "mirror",
          "axis": "x",
          "child": {
            "type": "transform",
            "translate": { "var": "backLegPos" },
            "rotate": { "var": "backLegRot" },
            "child": {
              "type": "roundCone",
              "params": {
                "r1": { "var": "legThighR" },
                "r2": { "var": "legAnkleR" },
                "h": { "var": "backLegH" },
                "color": { "var": "color" }
              }
            }
          }
        }]
      },
      {
        "comment": "Tail",
        "type": "smoothUnion",
        "k": { "expr": "mul", "args": [{ "var": "smooth" }, 0.5] },
        "children": [{
          "type": "transform",
          "translate": { "var": "tailPos" },
          "rotate": { "var": "tailRot" },
          "child": {
            "type": "capsule",
            "params": {
              "h": { "var": "tailLen" },
              "r": { "var": "tailR" },
              "color": { "var": "color" }
            }
          }
        }]
      }
    ]
  }
}
