{
  "name": "mudslider",
  "title": "Mudslider Mines",
  "description": "Boulder Dash-style puzzle game. Collect gems, find keys, avoid snakes!",
  "version": "1.0.0",
  "author": "GlitchCanary",
  "entry": "index.html",

  "sandbox": {
    "permissions": ["allow-scripts"],
    "timeout": 600000
  },

  "variables": {
    "read": ["player_level", "difficulty", "has_visited_cave"],
    "write": ["gems_collected", "has_red_key", "has_blue_key", "has_yellow_key", "has_green_key", "snakes_defeated", "rooms_explored", "minigame_won"]
  },

  "modes": {
    "full": {
      "description": "Full mine exploration - find all keys and reach the vault",
      "startRoom": "0,0"
    },
    "cave": {
      "description": "Start in the dark cave area",
      "startRoom": "0,1"
    },
    "river": {
      "description": "River crossing challenge",
      "startRoom": "1,3"
    }
  },

  "ui": {
    "width": "100%",
    "height": "100%",
    "minHeight": "400px",
    "background": "#112211"
  }
}
