{
  "@context": {
    "@vocab": "https://danbri.github.io/glitchcan-minigam/inklet/finkapp/apps/vocab#"
  },
  "@id": "playlist",
  "@type": "App",
  "position": 30,
  "id": "playlist",
  "family": "media",
  "icon": "🎶",
  "name": "Playlist",
  "surface": "window",
  "url": "../apps/playlist/index.html",
  "desc": "One playlist for every story and app",
  "capabilities": [
    "storage",
    "audio"
  ],
  "instances": "single",
  "actions": [
    "queue",
    "play",
    "pause",
    "next",
    "open"
  ],
  "bus": {
    "publish": [
      "app.playlist.*"
    ],
    "subscribe": [
      "ui.skin",
      "audio.volume"
    ]
  },
  "notes": [
    "The shared single-instance player of the foafos apps demo: stories and other apps add tracks to its one queue by the `queue` action instead of opening players of their own (docs/foafos-apps-20261022.md, section 5)."
  ]
}
