# SHACL shapes for the foafos app manifests (inklet/finkapp/apps/*.jsonld).
# Checked by `npm run apps:check` (inklet/tools/app-manifests.mjs) with @factoidal/core.
# The manifests are JSON-LD with an inline "@context": {"@vocab": ...} and nothing else,
# so every member is <vocab#member> (owner rule, 2026-10-22: no context documents).
# Design: docs/foafos-apps-20261022.md, section 4.

@prefix sh:  <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix app: <https://danbri.github.io/glitchcan-minigam/inklet/finkapp/apps/vocab#> .

app:AppShape a sh:NodeShape ;
  sh:targetClass app:App ;
  sh:property [ sh:path app:id ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
                sh:pattern "^[a-z][a-z0-9-]*$" ] ;
  sh:property [ sh:path app:name ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path app:desc ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path app:position ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ] ;
  sh:property [ sh:path app:family ; sh:minCount 1 ; sh:maxCount 1 ;
                sh:in ( "office" "play" "media" "make" "chrome" ) ] ;
  sh:property [ sh:path app:surface ; sh:minCount 1 ; sh:maxCount 1 ;
                sh:in ( "stage" "window" "story" "panel" "chrome" "none" ) ] ;
  sh:property [ sh:path app:controls ; sh:maxCount 1 ;
                sh:in ( "dpad" "lite" "none" "sticks" ) ] ;
  sh:property [ sh:path app:capabilities ;
                sh:in ( "storage" "secrets" "vars:read" "vars:write" "audio" "input" "geolocation"
                        "same-origin" "shell" "git:write" "story:launch" "story:link" "story:navigate"
                        "story:observe" "story:steer" ) ] ;
  sh:property [ sh:path app:silent ; sh:maxCount 1 ; sh:datatype xsd:boolean ] ;
  sh:property [ sh:path app:instances ; sh:maxCount 1 ; sh:in ( "many" "single" ) ] ;
  sh:property [ sh:path app:storage ; sh:maxCount 1 ; sh:in ( "app" "instance" "document" ) ] ;
  sh:property [ sh:path app:shows ; sh:in ( "full" "inline" "icon" ) ] .
