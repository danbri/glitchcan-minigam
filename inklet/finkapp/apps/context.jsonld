{
  "@context": {
    "@version": 1.1,
    "foafos": "https://danbri.github.io/glitchcan-minigam/inklet/finkapp/apps/vocab#",
    "schema": "https://schema.org/",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",

    "App": "foafos:App",
    "id": "foafos:appId",
    "position": { "@id": "schema:position", "@type": "xsd:integer" },
    "name": "schema:name",
    "desc": "schema:description",
    "notes": { "@id": "rdfs:comment", "@container": "@list" },
    "icon": "foafos:icon",
    "family": "foafos:family",
    "surface": "foafos:surface",
    "url": "foafos:url",
    "story": "foafos:story",
    "opens": "foafos:opens",
    "panel": "foafos:panel",
    "mount": "foafos:mount",
    "game": "foafos:game",
    "aliases": { "@id": "foafos:alias", "@container": "@set" },
    "controls": "foafos:controls",
    "inline": { "@id": "foafos:inline", "@type": "xsd:boolean" },
    "silent": { "@id": "foafos:silent", "@type": "xsd:boolean" },
    "featured": { "@id": "foafos:featured", "@type": "xsd:boolean" },
    "external": { "@id": "foafos:external", "@type": "xsd:boolean" },
    "persists": { "@id": "foafos:persists", "@type": "xsd:boolean" },
    "capabilities": { "@id": "foafos:capability", "@container": "@set" },
    "args": { "@id": "foafos:arg", "@container": "@set" },
    "features": { "@id": "foafos:feature", "@container": "@set" },
    "variables": "foafos:variables",
    "read": { "@id": "foafos:read", "@container": "@set" },
    "write": { "@id": "foafos:write", "@container": "@set" },
    "bus": "foafos:bus",
    "publish": { "@id": "foafos:publish", "@container": "@set" },
    "subscribe": { "@id": "foafos:subscribe", "@container": "@set" },

    "instances": "foafos:instances",
    "handles": "foafos:handles",
    "accept": { "@id": "foafos:accept", "@container": "@set" },
    "action": "foafos:action",
    "actions": { "@id": "foafos:actions", "@container": "@set" },
    "delegates": { "@id": "foafos:delegates", "@container": "@set" },
    "storage": "foafos:storage",
    "headless": "foafos:headless"
  }
}
